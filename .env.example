# =============================================
# DATABASE CONFIGURATION
# =============================================
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=hotbando
DB_PORT=3306
DB_POOL_SIZE=50
DB_SSL=false

# =============================================
# SERVER CONFIGURATION
# =============================================
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate-a-strong-random-secret-here
APP_URL=http://localhost:3000
REQUEST_TIMEOUT=30000
TRUST_PROXY=false
COOKIE_SECURE=false

# =============================================
# ENCRYPTION (REQUIRED - SET BEFORE FIRST START)
# =============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this after encrypting data will break existing encrypted values.
ENCRYPTION_KEY=your-64-char-hex-key

# =============================================
# MIKROTIK DEFAULT CONFIGURATION
# =============================================
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=change-this-to-strong-password
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_TIMEOUT=5

# =============================================
# SECURITY CONFIGURATION
# =============================================
BCRYPT_ROUNDS=12
JWT_SECRET=generate-a-strong-random-secret-here
CSRF_SECRET=generate-a-strong-random-secret-here
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ALLOWED_ORIGINS=http://localhost:3000

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=HotBando WiFi
APP_VERSION=1.0.0
SUPPORT_EMAIL=support@hotbando.co.tz
SUPPORT_PHONE=+255123456789
SEED_PASSWORD=password123

# =============================================
# VOUCHER SETTINGS
# =============================================
VOUCHER_LENGTH=10
VOUCHER_PREFIX=HB
DEFAULT_VOUCHER_EXPIRY_DAYS=30

# =============================================
# PACKAGE DURATIONS (in hours)
# =============================================
PACKAGE_500_HOURS=6
PACKAGE_1000_HOURS=24
PACKAGE_6000_HOURS=168
PACKAGE_20000_HOURS=720

# =============================================
# ADVERTISEMENT SETTINGS
# =============================================
AD_DEFAULT_DURATION=30
AD_DATA_REWARD=10
MAX_ADS_PER_DAY=8
AD_VIEW_EXPIRY_HOURS=24

# =============================================
# SESSION SETTINGS
# =============================================
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=true
SESSION_SECURE=false

# =============================================
# UPLOAD CONFIGURATION
# =============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================
# LOGGING CONFIGURATION
# =============================================
LOG_LEVEL=info

# =============================================
# REDIS CONFIGURATION
# =============================================
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# DOCKER SERVICES
# =============================================
DB_ROOT_PASSWORD=your_db_root_password
REDIS_PASSWORD=your_redis_password
BACKUP_RETENTION_DAYS=7

# =============================================
# PESAPAL PAYMENT GATEWAY
# =============================================
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_URL=http://localhost:3000/api/payments/callback
PESAPAL_IPN_URL=http://localhost:3000/api/payments/ipn
PESAPAL_IPN_SECRET=your-pesapal-ipn-secret

# =============================================
# RADIUS SETTINGS
# =============================================
RADIUS_ENABLED=false
RADIUS_HOST=127.0.0.1
RADIUS_SECRET=generate-a-strong-32-char-hex-secret
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
NAS_IDENTIFIER=hotbando-server
NAS_IP_ADDRESS=127.0.0.1

# =============================================
# EXTERNAL SERVICES (Optional)
# =============================================
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=HotBando
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password

# =============================================
# HOTSPOT NETWORK CONFIGURATION
# =============================================
HOTSPOT_IP=10.5.50.1
HOTSPOT_SUBNET=10.5.50.0
HOTSPOT_ADMIN_PASSWORD=CHANGE-ME
