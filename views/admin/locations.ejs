        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        display: none;
      }
      .fullscreen-close-btn:hover {
        background: #dc2626;
      }
      .map-fullscreen .fullscreen-close-btn {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .map-fullscreen .fullscreen-btn {
        display: none;
      }
      /* Fullscreen info panel */
      .fullscreen-info-panel {
