        margin-top: 12px;
      }
      .fullscreen-stat {
        background: #f3f4f6;
        padding: 8px 12px;
        border-radius: 8px;
        text-align: center;
      }
      .fullscreen-stat .value {
        font-size: 20px;
        font-weight: 700;
        color: #1f2937;
      }
      .fullscreen-stat .label {
        font-size: 11px;
        color: #6b7280;
      }
      /* Fix modal z-index when in fullscreen */
      .map-fullscreen ~ #routerUsersModal,
      .map-fullscreen ~ #locationDetailsModal,
      .map-fullscreen ~ #addLocationModal,
      body.fullscreen-active #routerUsersModal,
      body.fullscreen-active #locationDetailsModal,
      body.fullscreen-active #addLocationModal {
        z-index: 10002 !important;
      }
    </style>

    <div class="container mx-auto px-4 py-8">
      <!-- Page Header -->
      <div class="flex justify-between items-center mb-6">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Maeneo</h1>
