      <i class="fas fa-exclamation-circle text-red-500 text-3xl"></i>
    </div>
    <h3 class="text-xl font-bold text-gray-800 mb-2" id="alert-title">Hitilafu</h3>
    <p class="text-gray-600 mb-6" id="alert-message">Tafadhali chagua angalau kifurushi kimoja</p>
    <button onclick="closeModal('alert-modal')" class="btn-primary w-full">
      Sawa
    </button>
  </div>
</div>

<!-- Batch History Modal -->
<div id="batch-modal" class="modal-overlay" onclick="closeModal('batch-modal')">
  <div class="modal-content modal-large" onclick="event.stopPropagation()">
    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center">
          <i class="fas fa-history text-white"></i>
        </div>
        <div>
          <h3 class="font-bold text-gray-800">Historia ya Batches</h3>
          <p class="text-sm text-gray-500">Orodha ya batches zote</p>
        </div>
      </div>
      <button onclick="closeModal('batch-modal')" class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
        <i class="fas fa-times text-gray-500"></i>
      </button>
    </div>
    <div class="p-4 max-h-[60vh] overflow-y-auto" id="batch-history-content">
      <div class="text-center py-8 text-gray-400">
        <i class="fas fa-spinner fa-spin text-2xl mb-2"></i>
        <p>Inapakia...</p>
      </div>
    </div>
    <div class="p-4 border-t border-gray-200 flex justify-between items-center bg-gray-50">
      <span class="text-sm text-gray-500" id="batch-count">Jumla: 0 batches</span>
      <button onclick="closeModal('batch-modal')" class="btn-secondary">
        Funga
      </button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let pendingGeneration = null;
  let salesTrendChart = null;
  let voucherDistChart = null;
  let usageChart = null;

  document.addEventListener('DOMContentLoaded', function() {
    loadPackages();
    loadSalesSummary();
    loadRecentBatches();
    loadVoucherStats();
    initCharts();

    document.getElementById('voucher-form').addEventListener('submit', function(e) {
      e.preventDefault();
      prepareVoucherGeneration();
    });
  });

  // Tab switching
  function switchVoucherTab(tabName) {
    document.querySelectorAll('.voucher-tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

    event.target.closest('.voucher-tab').classList.add('active');
    document.getElementById('tab-' + tabName).classList.add('active');

    if (tabName === 'analytics') {
      setTimeout(() => {
        if (salesTrendChart) salesTrendChart.update();
        if (voucherDistChart) voucherDistChart.update();
        if (usageChart) usageChart.update();
      }, 100);
    }
  }

  // Initialize charts
  function initCharts() {
    // Sales Trend
    const salesCtx = document.getElementById('sales-trend-chart')?.getContext('2d');
    if (salesCtx) {
      salesTrendChart = new Chart(salesCtx, {
        type: 'line',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Mauzo',
            data: [450000, 520000, 380000, 620000, 580000, 750000, 680000],
            borderColor: '#22c55e',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    // Voucher Distribution
    const distCtx = document.getElementById('voucher-distribution-chart')?.getContext('2d');
    if (distCtx) {
      voucherDistChart = new Chart(distCtx, {
        type: 'doughnut',
        data: {
          labels: ['MASAA 6', 'MASAA 24', 'WIKI 1', 'MWEZI 1'],
          datasets: [{
            data: [45, 30, 15, 10],
            backgroundColor: ['#22c55e', '#3b82f6', '#8b5cf6', '#FF7A30'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '65%',
          plugins: { legend: { position: 'right' } }
        }
      });
    }

    // Usage Chart
    const usageCtx = document.getElementById('usage-chart')?.getContext('2d');
    if (usageCtx) {
      usageChart = new Chart(usageCtx, {
        type: 'bar',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Vouchers Used',
            data: [120, 145, 98, 167, 156, 189, 175],
            backgroundColor: 'rgba(59, 130, 246, 0.6)',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
            x: { grid: { display: false } }
          }
        }
      });
    }
  }

  // Load packages
  function loadPackages() {
    fetch('/api/admin/packages')
      .then(response => response.json())
      .then(data => {
        if (!data.success) return;

        const container = document.getElementById('packages-container');
        container.innerHTML = '';

        data.data.forEach(pkg => {
          const div = document.createElement('div');
          div.className = 'package-item';
          div.innerHTML = \`
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-gray-800">\${pkg.name}</span>
                <span class="package-badge bg-orange-100 text-orange-700">TZS \${parseFloat(pkg.price).toLocaleString()}</span>
              </div>
              <p class="text-sm text-gray-500">\${pkg.description || getPackageDuration(pkg.name)}</p>
            </div>
            <div class="qty-control">
              <button type="button" class="qty-btn" onclick="decrementPackage('\${pkg.name}')">
                <i class="fas fa-minus"></i>
              </button>
              <input type="number" id="\${pkg.name}-count" class="qty-input" value="0" min="0" max="50000"
                     onchange="updateVoucherSummary()">
              <button type="button" class="qty-btn" onclick="incrementPackage('\${pkg.name}')">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          \`;
          container.appendChild(div);
        });
      })
      .catch(error => console.error('Error:', error));
  }

  function incrementPackage(packageName) {
    const input = document.getElementById(\`\${packageName}-count\`);
    input.value = (parseInt(input.value) || 0) + 1;
    updateVoucherSummary();
  }

  function decrementPackage(packageName) {
    const input = document.getElementById(\`\${packageName}-count\`);
    const current = parseInt(input.value) || 0;
    if (current > 0) input.value = current - 1;
    updateVoucherSummary();
  }

  function updateVoucherSummary() {
    let totalVouchers = 0;
    let totalValue = 0;
    const breakdown = {};

    document.querySelectorAll('input[id$="-count"]').forEach(input => {
      const count = parseInt(input.value) || 0;
      if (count > 0) {
        const packageName = input.id.replace('-count', '');
        const price = getPackagePrice(packageName);
        totalVouchers += count;
        totalValue += count * price;
        breakdown[packageName] = count;
      }
    });

    document.getElementById('total-vouchers').textContent = totalVouchers.toLocaleString();
    document.getElementById('total-value').textContent = 'TZS ' + totalValue.toLocaleString();

    const breakdownText = Object.entries(breakdown)
      .map(([pkg, count]) => \`\${pkg}: \${count.toLocaleString()}\`)
      .join(', ');
    document.getElementById('package-breakdown').textContent = breakdownText || '-';
  }

  function getPackagePrice(name) {
    const prices = { 'MASAA 6': 500, 'MASAA 24': 1000, 'WIKI 1': 6000, 'MWEZI 1': 20000 };
    return prices[name] || 0;
  }

  function getPackageDuration(name) {
    const durations = { 'MASAA 6': 'Muda: Masaa 6', 'MASAA 24': 'Muda: Siku 1', 'WIKI 1': 'Muda: Wiki 1', 'MWEZI 1': 'Muda: Mwezi 1' };
    return durations[name] || '';
  }

  // Quick generate
  function quickGenerate(price, quantity, packageName) {
    const issuedTo = document.getElementById('issuedto');
    if (!issuedTo.value.trim()) {
      issuedTo.value = 'Bulk Generation - ' + packageName;
    }

    document.querySelectorAll('input[id$="-count"]').forEach(input => input.value = '0');
    const targetInput = document.getElementById(\`\${packageName}-count\`);
    if (targetInput) targetInput.value = quantity;

    updateVoucherSummary();
    prepareVoucherGeneration();
  }

  function generateBulk() {
    const packageName = document.getElementById('bulk-package').value;
    const quantity = parseInt(document.getElementById('bulk-quantity').value);
    const issuedTo = document.getElementById('bulk-issuedto').value || 'Bulk Generation';

    if (!quantity || quantity < 1) {
      showAlert('Tafadhali ingiza idadi sahihi');
      return;
    }

    document.getElementById('issuedto').value = issuedTo;
    quickGenerate(getPackagePrice(packageName), quantity, packageName);
  }

  function prepareVoucherGeneration() {
    const issuedto = document.getElementById('issuedto').value;
    if (!issuedto.trim()) {
      showAlert('Tafadhali ingiza jina la mtoa huduma');
      return;
    }

    const vouchers = {};
    let hasVouchers = false;
    let totalVouchers = 0;

    document.querySelectorAll('input[id$="-count"]').forEach(input => {
      const count = parseInt(input.value) || 0;
      if (count > 0) {
        vouchers[input.id.replace('-count', '')] = count;
        hasVouchers = true;
        totalVouchers += count;
      }
    });

    if (!hasVouchers) {
      showAlert('Tafadhali chagua angalau kifurushi kimoja');
      return;
    }

    const totalValue = Object.entries(vouchers).reduce((sum, [pkg, count]) => sum + (getPackagePrice(pkg) * count), 0);

    pendingGeneration = { issuedto, vouchers, totalVouchers, totalValue };
    document.getElementById('confirmation-message').innerHTML =
      \`Una uhakika unataka kuunda <strong>\${totalVouchers.toLocaleString()}</strong> vouchers?<br><strong>Thamani: TZS \${totalValue.toLocaleString()}</strong>\`;
    showModal('confirmation-modal');
  }

  function confirmGeneration() {
    if (!pendingGeneration) return;
    closeModal('confirmation-modal');
    generateVouchers(pendingGeneration);
  }

  function generateVouchers(data) {
    const btn = document.querySelector('#voucher-form button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Inatengeneza...';

    fetch('/api/admin/generate-voucher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ issuedto: data.issuedto, vouchers: data.vouchers })
    })
    .then(res => res.json())
    .then(result => {
      if (result.success) {
        document.getElementById('success-count').textContent = data.totalVouchers.toLocaleString();
        document.getElementById('success-value').textContent = 'TZS ' + data.totalValue.toLocaleString();
        showModal('success-modal');

        document.getElementById('voucher-form').reset();
        document.querySelectorAll('input[id$="-count"]').forEach(input => input.value = 0);
        updateVoucherSummary();
        loadRecentBatches();
        loadVoucherStats();
      } else {
        showAlert(result.message || 'Imeshindikana');
      }
    })
    .catch(() => showAlert('Hitilafu imetokea'))
    .finally(() => {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-magic mr-2"></i>Tengeneza Vouchers';
      pendingGeneration = null;
    });
  }

  // Load stats
  function loadSalesSummary() {
    fetch('/api/admin/sales-summary')
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          document.getElementById('today-sales').textContent = 'TZS ' + formatShort(data.todaySales);
          document.getElementById('total-revenue').textContent = 'TZS ' + formatShort(data.totalRevenue);
        }
      })
      .catch(() => {});
  }

  function loadVoucherStats() {
    fetch('/api/admin/voucher-report?limit=1000')
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const today = new Date().toISOString().split('T')[0];
          const usedToday = data.data.filter(v => v.used_at && v.used_at.startsWith(today)).length;
          const available = data.data.filter(v => !v.is_used).length;
          document.getElementById('used-today').textContent = usedToday.toLocaleString();
          document.getElementById('available-vouchers').textContent = available.toLocaleString();
        }
      })
      .catch(() => {});
  }

  function loadRecentBatches() {
    fetch('/api/admin/batches')
      .then(res => res.json())
      .then(data => {
        if (!data.success) return;
        const container = document.getElementById('recent-batches');
        if (data.data.length === 0) {
          container.innerHTML = '<p class="text-center text-gray-400 py-4">Hakuna batches</p>';
          return;
        }
        container.innerHTML = data.data.slice(0, 4).map(b => \`
          <div class="batch-card">
            <div class="flex justify-between items-start mb-2">
              <span class="font-semibold text-gray-800">\${b.batch_name}</span>
              <span class="text-xs text-gray-400">\${new Date(b.created_at).toLocaleDateString()}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500">\${b.total_vouchers} vouchers</span>
              <span class="font-bold text-orange-600">TZS \${formatShort(b.total_value)}</span>
            </div>
          </div>
        \`).join('');
      })
      .catch(() => {});
  }

  function formatShort(num) {
    if (!num) return '0';
    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
    if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
    return num.toLocaleString();
  }

  // Modals
  function showModal(id) {
    document.getElementById(id).classList.add('show');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('show');
    if (id === 'confirmation-modal') pendingGeneration = null;
  }

  function showAlert(message) {
    document.getElementById('alert-message').textContent = message;
    showModal('alert-modal');
  }

  function showBatchHistory() {
    showModal('batch-modal');
    loadBatchHistory();
  }

  function loadBatchHistory() {
    fetch('/api/admin/batches')
      .then(res => res.json())
      .then(data => {
        const container = document.getElementById('batch-history-content');
        if (!data.success || data.data.length === 0) {
          container.innerHTML = '<p class="text-center py-8 text-gray-400">Hakuna batches</p>';
          return;
        }

        container.innerHTML = \`
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Batch</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Imetolewa Kwa</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vouchers</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Thamani</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tarehe</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              \${data.data.map(b => \`
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium">\${b.batch_name}</td>
                  <td class="px-4 py-3 text-gray-600">\${b.issued_to || 'N/A'}</td>
                  <td class="px-4 py-3">\${b.total_vouchers?.toLocaleString()}</td>
                  <td class="px-4 py-3 font-semibold text-orange-600">TZS \${parseFloat(b.total_value || 0).toLocaleString()}</td>
                  <td class="px-4 py-3 text-gray-500">\${new Date(b.created_at).toLocaleDateString()}</td>
                </tr>
              \`).join('')}
            </tbody>
          </table>
        \`;
        document.getElementById('batch-count').textContent = 'Jumla: ' + data.data.length + ' batches';
      })
      .catch(() => {
        document.getElementById('batch-history-content').innerHTML = '<p class="text-center py-8 text-red-500">Hitilafu</p>';
      });
  }

  function exportVouchers() {
    alert('Export feature coming soon');
  }
</script>
`;
%>

<%- include('layout', {
    title: 'Uundaji wa Vouchers',
    activePage: 'generate-vouchers',
    body: vouchersContent
}) %>
