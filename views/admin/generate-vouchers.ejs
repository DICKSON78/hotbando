<script>
    let pendingGeneration = null;

    document.addEventListener('DOMContentLoaded', function() {
        loadPackages();
        loadSalesSummary();
        loadRecentBatches();
        loadVoucherStats();

        // Voucher form submission
        document.getElementById('voucher-form').addEventListener('submit', function(e) {
            e.preventDefault();
            prepareVoucherGeneration();
        });
    });

    // Load available packages
    function loadPackages() {
        fetch('/api/admin/packages')
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    console.error('Failed to load packages');
                    return;
                }

                const container = document.getElementById('packages-container');
                container.innerHTML = '';

                data.data.forEach(pkg => {
                    const packageDiv = document.createElement('div');
                    packageDiv.className = 'flex justify-between items-center p-3 bg-white border border-gray-200 rounded-lg';
                    packageDiv.innerHTML = \`
                        <div class="flex-1">
                            <div class="font-medium text-gray-800">\${pkg.name}</div>
                            <div class="text-sm text-gray-600">\${pkg.description || ''}</div>
                            <div class="text-sm font-semibold text-primary">TSH \${parseFloat(pkg.price).toLocaleString()}</div>
                            <div class="text-xs text-gray-500 mt-1">\${getPackageDuration(pkg.name)}</div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button type="button" onclick="decrementPackage('\${pkg.name}')" 
                                    class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                                </svg>
                            </button>
                            <input type="number" id="\${pkg.name}-count" 
                                   class="w-16 text-center border border-gray-300 rounded py-1" 
                                   value="0" min="0" max="50000" 
                                   onchange="updateVoucherSummary()"
                                   placeholder="0">
                            <button type="button" onclick="incrementPackage('\${pkg.name}')" 
                                    class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                            </button>
                        </div>
                    \`;
                    container.appendChild(packageDiv);
                });
            })
            .catch(error => console.error('Packages load error:', error));
    }

    // Package quantity controls
    function incrementPackage(packageName) {
        const input = document.getElementById(\`\${packageName}-count\`);
        const current = parseInt(input.value) || 0;
        input.value = current + 1;
        updateVoucherSummary();
    }

    function decrementPackage(packageName) {
        const input = document.getElementById(\`\${packageName}-count\`);
        const current = parseInt(input.value) || 0;
        if (current > 0) {
            input.value = current - 1;
            updateVoucherSummary();
        }
    }

    // Update voucher summary
    function updateVoucherSummary() {
        let totalVouchers = 0;
        let totalValue = 0;
        const breakdown = {};

        // Get all package inputs
        const inputs = document.querySelectorAll('input[id$="-count"]');
        inputs.forEach(input => {
            const count = parseInt(input.value) || 0;
            if (count > 0) {
                const packageName = input.id.replace('-count', '');
                const price = getPackagePrice(packageName);
                totalVouchers += count;
                totalValue += count * price;
                breakdown[packageName] = count;
            }
        });

        document.getElementById('total-vouchers').textContent = totalVouchers.toLocaleString();
        document.getElementById('total-value').textContent = \`TSH \${totalValue.toLocaleString()}\`;
        
        // Update breakdown
        const breakdownText = Object.entries(breakdown)
            .map(([pkg, count]) => \`\${pkg}: \${count.toLocaleString()}\`)
            .join(', ');
        document.getElementById('package-breakdown').textContent = breakdownText || '-';
    }

    // Helper function to get package price
    function getPackagePrice(packageName) {
        const prices = {
            'MASAA 6': 500,
            'MASAA 24': 1000,
            'WIKI 1': 6000,
            'MWEEZI 1': 20000
        };
        return prices[packageName] || 0;
    }

    // Helper function to get package duration
    function getPackageDuration(packageName) {
        const durations = {
            'MASAA 6': 'Muda: Masaa 6',
            'MASAA 24': 'Muda: Siku 1',
            'WIKI 1': 'Muda: Wiki 1',
            'MWEEZI 1': 'Muda: Mwezi 1'
        };
        return durations[packageName] || '';
    }

    // Quick generation function
    function quickGenerate(price, quantity, packageName) {
        // Set the issued to field if empty
        const issuedTo = document.getElementById('issuedto');
        if (!issuedTo.value.trim()) {
            issuedTo.value = 'Bulk Generation - ' + packageName;
        }

        // Clear all other packages
        const inputs = document.querySelectorAll('input[id$="-count"]');
        inputs.forEach(input => {
            input.value = '0';
        });

        // Set the selected package quantity
        const targetInput = document.getElementById(\`\${packageName}-count\`);
        if (targetInput) {
            targetInput.value = quantity;
        }

        updateVoucherSummary();
        prepareVoucherGeneration();
    }

    // Bulk generation function
    function generateBulk() {
        const packageName = document.getElementById('bulk-package').value;
        const quantity = parseInt(document.getElementById('bulk-quantity').value);

        if (!quantity || quantity < 1) {
            showWarning('Tafadhali ingiza idadi sahihi ya vocha');
            return;
        }

        if (quantity > 50000) {
            showWarning('Idadi ya vocha haizidi 50,000 kwa mara moja');
            return;
        }

        quickGenerate(getPackagePrice(packageName), quantity, packageName);
    }

    function prepareVoucherGeneration() {
        const issuedto = document.getElementById('issuedto').value;
        if (!issuedto.trim()) {
            showAlert('Tafadhali ingiza jina la mtoa huduma');
            return;
        }

        // Collect package counts
        const vouchers = {};
        const inputs = document.querySelectorAll('input[id$="-count"]');
        let hasVouchers = false;
        let totalVouchers = 0;

        inputs.forEach(input => {
            const count = parseInt(input.value) || 0;
            if (count > 0) {
                const packageName = input.id.replace('-count', '');
                vouchers[packageName] = count;
                hasVouchers = true;
                totalVouchers += count;
            }
        });

        if (!hasVouchers) {
            showAlert('Tafadhali chagua angalau kifurushi kimoja');
            return;
        }

        if (totalVouchers > 50000) {
            showWarning('Idadi ya jumla ya vocha haizidi 50,000 kwa mara moja');
            return;
        }

        // Calculate total value
        const totalValue = Object.entries(vouchers).reduce((sum, [pkg, count]) => {
            return sum + (getPackagePrice(pkg) * count);
        }, 0);

        // Show confirmation modal
        pendingGeneration = { issuedto, vouchers, totalVouchers, totalValue };
        showConfirmationModal(totalVouchers, totalValue);
    }

    function showConfirmationModal(count, value) {
        document.getElementById('confirmation-title').textContent = 'Thibitisha Uundaji wa Vouchers';
        document.getElementById('confirmation-message').innerHTML = \`
            Una uhakika unataka kuunda <strong>\${count.toLocaleString()}</strong> vouchers?<br>
            <strong>Thamani ya jumla: TSH \${value.toLocaleString()}</strong>
        \`;
        showModal('confirmation-modal');
    }

    function confirmGeneration() {
        if (!pendingGeneration) return;
        
        closeConfirmationModal();
        generateVouchers(pendingGeneration);
    }

    function generateVouchers(generationData) {
        const submitBtn = document.querySelector('#voucher-form button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mx-auto"></div> Inaunda...';

        fetch('/api/admin/generate-voucher', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                issuedto: generationData.issuedto,
                vouchers: generationData.vouchers
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showSuccessModal(generationData.totalVouchers, generationData.totalValue);
                
                // Reset form
                document.getElementById('voucher-form').reset();
                const inputs = document.querySelectorAll('input[id$="-count"]');
                inputs.forEach(input => input.value = 0);
                updateVoucherSummary();
                
                // Reload data
                loadRecentBatches();
                loadVoucherStats();
            } else {
                showAlert('❌ Hitilafu: ' + (data.message || 'Imeshindikana kuunda vouchers'));
            }
        })
        .catch(error => {
            console.error('Voucher generation error:', error);
            showAlert('❌ Hitilafu imetokea wakati wa kuunda vouchers');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = \`
                <i class="fas fa-plus-circle mr-2"></i>
                Undaa Vouchers
            \`;
            pendingGeneration = null;
        });
    }

    function showSuccessModal(count, value) {
        document.getElementById('success-count').textContent = count.toLocaleString();
        document.getElementById('success-value').textContent = \`TSH \${value.toLocaleString()}\`;
        document.getElementById('success-message').textContent = \`Vouchers \${count.toLocaleString()} zimeundwa kikamilifu!\`;
        showModal('success-modal');
    }

    // New Alert Modal Functions
    function showAlert(message) {
        document.getElementById('alert-title').textContent = 'Hitilafu';
        document.getElementById('alert-message').textContent = message;
        showModal('alert-modal');
    }

    function showWarning(message) {
        document.getElementById('warning-title').textContent = 'Taarifa Muhimu';
        document.getElementById('warning-message').textContent = message;
        showModal('warning-modal');
    }

    function closeAlertModal() {
        closeModal('alert-modal');
    }

    function closeWarningModal() {
        closeModal('warning-modal');
    }

    // Modal management functions
    function showModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.classList.remove('hidden');
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.classList.add('hidden');
    }

    function closeConfirmationModal() {
        closeModal('confirmation-modal');
        pendingGeneration = null;
    }

    function closeSuccessModal() {
        closeModal('success-modal');
    }

    function closeBatchModal() {
        closeModal('batch-modal');
    }

    function closeBatchDetailsModal() {
        closeModal('batch-details-modal');
    }

    function showBatchHistory() {
        showModal('batch-modal');
        loadBatchHistory();
    }

    // Load sales summary
    function loadSalesSummary() {
        fetch('/api/admin/sales-summary')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('today-sales').textContent = \`TSH \${parseInt(data.todaySales).toLocaleString()}\`;
                    document.getElementById('total-users').textContent = data.totalUsers?.toLocaleString() || '0';
                    document.getElementById('active-subs').textContent = data.activeSubscriptions?.toLocaleString() || '0';
                    document.getElementById('total-revenue').textContent = \`TSH \${parseInt(data.totalRevenue).toLocaleString()}\`;
                }
            })
            .catch(error => console.error('Sales summary error:', error));
    }

    // Load recent batches
    function loadRecentBatches() {
        fetch('/api/admin/batches')
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    console.error('Failed to load batches');
                    return;
                }

                const container = document.getElementById('recent-batches');
                container.innerHTML = '';

                if (data.data.length === 0) {
                    container.innerHTML = '<div class="text-center py-4 text-gray-500">Hakuna batches bado</div>';
                    return;
                }

                data.data.slice(0, 5).forEach(batch => {
                    const batchDiv = document.createElement('div');
                    batchDiv.className = 'border border-gray-200 rounded-lg p-3 hover:bg-gray-50 transition cursor-pointer';
                    batchDiv.onclick = () => showBatchDetails(batch.id);
                    batchDiv.innerHTML = \`
                        <div class="flex justify-between items-start mb-2">
                            <div class="font-medium text-gray-800">\${batch.batch_name}</div>
                            <div class="text-sm text-gray-500">\${new Date(batch.created_at).toLocaleDateString('sw-TZ')}</div>
                        </div>
                        <div class="text-sm text-gray-600">
                            <div class="mb-1">Imetolewa kwa: \${batch.issued_to || 'N/A'}</div>
                            <div class="flex justify-between items-center">
                                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">\${batch.total_vouchers} vouchers</span>
                                <span class="font-semibold text-green-600">TSH \${parseFloat(batch.total_value || 0).toLocaleString()}</span>
                            </div>
                        </div>
                    \`;
                    container.appendChild(batchDiv);
                });
            })
            .catch(error => console.error('Batches load error:', error));
    }

    // Load voucher statistics
    function loadVoucherStats() {
        fetch('/api/admin/voucher-report?limit=1000')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const today = new Date().toISOString().split('T')[0];
                    const usedToday = data.data.filter(v => v.used_at && v.used_at.startsWith(today)).length;
                    const available = data.data.filter(v => !v.is_used).length;

                    document.getElementById('used-today').textContent = usedToday.toLocaleString();
                    document.getElementById('available-vouchers').textContent = available.toLocaleString();
                }
            })
            .catch(error => console.error('Voucher stats error:', error));
    }

    function loadBatchHistory() {
        fetch('/api/admin/batches')
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    document.getElementById('batch-history-content').innerHTML = '<div class="text-center py-8 text-red-500">Hitilafu katika kupakia historia</div>';
                    return;
                }

                const container = document.getElementById('batch-history-content');
                
                if (data.data.length === 0) {
                    container.innerHTML = '<div class="text-center py-8 text-gray-500">Hakuna batches zilizopo</div>';
                    return;
                }

                let html = \`
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr class="bg-gray-50">
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Batch</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Imetolewa Kwa</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vouchers</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Thamani</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tarehe</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Menza</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                \`;

                data.data.forEach(batch => {
                    html += \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 text-sm font-medium text-gray-900">\${batch.batch_name}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">\${batch.issued_to || 'N/A'}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">\${batch.total_vouchers?.toLocaleString() || '0'}</td>
                            <td class="px-4 py-3 text-sm font-semibold text-green-600">TSH \${parseFloat(batch.total_value || 0).toLocaleString()}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">\${new Date(batch.created_at).toLocaleDateString('sw-TZ')}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">\${batch.created_by_name || 'Admin'}</td>
                        </tr>
                    \`;
                });

                html += \`
                            </tbody>
                        </table>
                    </div>
                \`;

                container.innerHTML = html;
                document.getElementById('batch-count').textContent = \`Jumla: \${data.data.length} batches\`;
            })
            .catch(error => {
                console.error('Batch history error:', error);
                document.getElementById('batch-history-content').innerHTML = '<div class="text-center py-8 text-red-500">Hitilafu katika kupakia historia</div>';
            });
    }

    function showBatchDetails(batchId) {
        showModal('batch-details-modal');
        // You can implement batch details view here
    }
</script>
`;
%>

<%- include('layout', {
    title: 'Undaa Vouchers - Admin',
    activePage: 'generate-vouchers',
    body: vouchersContent
}) %>