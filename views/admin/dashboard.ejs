    <!-- Charts Script -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      // Placeholder function for modal (will be implemented later if needed)
      function openStatsModal(type) {
        console.log('Opening stats modal for:', type);
        // TODO: Implement modal functionality
      }

      document.addEventListener('DOMContentLoaded', () => {
        // Initialize Views Chart
        const viewsCanvas = document.getElementById('viewsChart');
        if (viewsCanvas) {
          const viewsCtx = viewsCanvas.getContext('2d');

          // Use chartData from server or fallback to viewsTrend
          const chartLabels = ${JSON.stringify(safeChartData.labels.length > 0 ? safeChartData.labels :
            safeViewsTrend.map(item => {
              const date = new Date(item.date);
              return date.toLocaleDateString('sw-TZ', { day: 'numeric', month: 'short' });
            })
          )};

          const chartData = ${JSON.stringify(safeChartData.data.length > 0 ? safeChartData.data :
            safeViewsTrend.map(item => item.total)
          )};

          const viewsChart = new Chart(viewsCtx, {
            type: 'line',
            data: {
              labels: chartLabels,
              datasets: [{
                label: 'Maonyesho ya Kila Siku',
                data: chartData,
                borderColor: '#FF7A30',
                backgroundColor: 'rgba(255, 122, 48, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#FF7A30',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  display: false
                },
                tooltip: {
                  backgroundColor: 'rgba(0, 0, 0, 0.8)',
                  titleColor: '#ffffff',
                  bodyColor: '#ffffff',
                  borderColor: '#FF7A30',
                  borderWidth: 1,
                  cornerRadius: 8
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: {
                    color: 'rgba(0, 0, 0, 0.1)'
                  },
                  ticks: {
                    color: '#6B7280'
                  }
                },
                x: {
                  grid: {
                    display: false
                  },
                  ticks: {
                    color: '#6B7280'
                  }
                }
              }
            }
          });

          // Refresh chart data every 30 seconds
          setInterval(() => {
            fetch('/api/dashboard-stats')
              .then(response => response.json())
              .then(data => {
                if (data.success && data.chartData) {
                  viewsChart.data.labels = data.chartData.labels;
                  viewsChart.data.datasets[0].data = data.chartData.data;
                  viewsChart.update('none');
                }
              })
              .catch(error => console.error('Chart update error:', error));
          }, 30000);
        }

        // Update dashboard stats with real-time data
        function updateDashboardStats() {
          fetch('/api/dashboard-stats')
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                // Update statistics cards
                if (document.getElementById('total-views')) {
                  document.getElementById('total-views').textContent = data.totalViews.toLocaleString();
                }
                if (document.getElementById('active-ads')) {
                  document.getElementById('active-ads').textContent = data.activeAds;
                }
                if (document.getElementById('data-distributed')) {
                  document.getElementById('data-distributed').textContent = data.dataDistributed + ' GB';
                }
                if (document.getElementById('completion-rate')) {
                  document.getElementById('completion-rate').textContent = data.completionRate + '%';
                }

                // Update recent activity
                const activityList = document.getElementById('recent-activity');
                if (activityList && data.recentActivity && data.recentActivity.length > 0) {
                  activityList.innerHTML = data.recentActivity.map(activity => \`
                    <li class="flex items-start space-x-3 p-3 hover:bg-gray-50 rounded-lg transition">
                      <div class="flex-shrink-0 w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mt-1">
                        <i class="fas fa-\${activity.icon} text-orange-600 text-sm"></i>
                      </div>
                      <div class="flex-grow">
                        <p class="font-medium text-gray-800 text-sm">\${activity.description}</p>
                        <p class="text-xs text-gray-500 mt-1">\${activity.time}</p>
                      </div>
                    </li>
                  \`).join('');
                }

                // Update recent ads table
                const adsTable = document.getElementById('recent-ads');
                if (adsTable && data.activeAdsList && data.activeAdsList.length > 0) {
                  adsTable.innerHTML = data.activeAdsList.map(ad => \`
                    <tr>
                      <td class="font-medium text-gray-900">\${ad.title || 'Untitled Ad'}</td>
                      <td>
                        <span class="badge badge-success">
                          <i class="fas fa-circle mr-1 text-xs"></i>
                          Active
                        </span>
                      </td>
                      <td class="text-gray-900">\${(ad.views || 0).toLocaleString()}</td>
                      <td class="text-gray-500">\${ad.created_at ? new Date(ad.created_at).toLocaleDateString('sw-TZ') : 'N/A'}</td>
                    </tr>
                  \`).join('');
                }

                // Update pending approvals
                const pendingList = document.getElementById('pending-approvals');
                if (pendingList && data.pendingApprovals && data.pendingApprovals.length > 0) {
                  pendingList.innerHTML = data.pendingApprovals.map(ad => \`
                    <li class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                          <i class="fas fa-video text-blue-600 text-sm"></i>
                        </div>
                        <div>
                          <p class="font-medium text-gray-800 text-sm">\${ad.title || 'Untitled Ad'}</p>
                          <p class="text-xs text-gray-500">Na \${ad.sponsor_name || 'Mtoa Huduma'}</p>
                        </div>
                      </div>
                      <div class="flex space-x-2">
                        \${ad.video_url ? \`
                          <a href="\${ad.video_url}" target="_blank"
                             class="text-blue-600 hover:text-blue-700 text-sm font-medium"
                             title="Angalia Video">
                            <i class="fas fa-play"></i>
                          </a>
                        \` : ''}
                        <button class="text-green-600 hover:text-green-700 text-sm font-medium" title="Idhinisha">
                          <i class="fas fa-check"></i>
                        </button>
                        <button class="text-red-600 hover:text-red-700 text-sm font-medium" title="Kataa">
                          <i class="fas fa-times"></i>
                        </button>
                      </div>
                    </li>
                  \`).join('');
                }
              }
            })
            .catch(error => console.error('Dashboard stats update error:', error));
        }

        // Update stats every minute
        setInterval(updateDashboardStats, 60000);

        // Initial update
        updateDashboardStats();
      });
    </script>
  `;
%>

<%- include('layout', {
    title: 'Dashboard',
    activePage: 'dashboard',
    body: dashboardContent
}) %>
