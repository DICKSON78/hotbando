<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Ingia kama Admin - HotBando' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            light: '#FF9D5C',
                            DEFAULT: '#FF7A30',
                            dark: '#E43636',
                        },
                        secondary: {
                            DEFAULT: '#121212',
                            dark: '#0A0A0A',
                        },
                        accent: {
                            DEFAULT: '#E5E5E5',
                            light: '#F8F8F8',
                        }
                    },
                    boxShadow: {
                        'card': '0 8px 24px rgba(0, 0, 0, 0.15)',
                        'card-hover': '0 12px 32px rgba(0, 0, 0, 0.2)',
                    },
                    borderRadius: {
                        'xl': '1rem',
                        '2xl': '1.5rem',
                    }
                }
            }
        }
    </script>
    <style>
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
        }
        .loading-bar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #FF7A30;
            transform: scaleX(0);
            transform-origin: left;
            animation: loading 2s ease-in-out forwards;
            z-index: 1000;
        }
        @keyframes loading {
            0% { transform: scaleX(0); }
            50% { transform: scaleX(0.8); }
            100% { transform: scaleX(1); opacity: 0; }
        }
        .button-glow {
            position: relative;
            overflow: hidden;
        }
        .button-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: 0.5s;
        }
        .button-glow:hover::before {
            left: 100%;
        }
        .modal {
            transition: all 0.3s ease-in-out;
        }
        .modal.active {
            opacity: 1;
            visibility: visible;
        }
        .modal.active .modal-content {
            transform: translateY(0);
        }
        .input-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 1rem;
            color: #121212;
        }
        .admin-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="font-inter bg-accent text-secondary min-h-screen flex items-center justify-center p-4">
    <!-- Loading Bar -->
    <div id="loading-bar" class="loading-bar"></div>
    
    <!-- Main Content -->
    <div class="w-full max-w-md">
        <div class="bg-accent-light rounded-2xl shadow-card overflow-hidden">
            <!-- Header -->
            <div class="bg-accent-light p-6 border-b border-primary/10 text-center">
                <div class="flex justify-center items-center mb-4">
                    <img src="/assets/hot-bando-logo.png" alt="HotBando Logo" class="h-16">
                </div>
                <div class="admin-badge text-white py-2 px-4 rounded-full inline-block mb-3">
                    <i class="fas fa-shield-alt mr-2"></i> Mfumo wa Udhibiti
                </div>
                <h1 class="text-2xl font-bold text-secondary">Ingia kama Admin</h1>
                <p class="text-secondary mt-1">Udhibiti wa mfumo na matangazo</p>
            </div>

            <!-- Form Content -->
            <div class="p-6 pt-4">
                <!-- Error Messages -->
                <% if (typeof errors !== 'undefined' && Object.keys(errors).length > 0) { %>
                    <div class="mb-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded">
                        <ul>
                            <% Object.values(errors).forEach(error => { %>
                                <li><%= error %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <form id="login-form" method="POST" action="/admin/login" class="space-y-5">
                    <!-- CSRF Token (if using CSRF protection) -->
                    <% if (typeof csrf_token !== 'undefined' && csrf_token) { %>
                        <input type="hidden" name="_token" value="<%= csrf_token %>">
                    <% } %>

                    <div>
                        <label for="email" class="block text-sm font-medium text-secondary mb-1">Barua Pepe</label>
                        <div class="relative">
                            <i class="fas fa-envelope input-icon"></i>
                            <input type="email" id="email" name="email" 
                                   value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
                                   class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary" 
                                   placeholder="admin@hotbando.com" required
                                   autocomplete="email">
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label for="password" class="block text-sm font-medium text-secondary">Neno Siri</label>
                            <button type="button" onclick="openModal('forgot-password-modal')" class="text-sm text-primary hover:text-primary-dark focus:outline-none">
                                Umesahau Neno Siri?
                            </button>
                        </div>
                        <div class="relative">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password" id="password" name="password" 
                                   class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary" 
                                   placeholder="••••••••" required
                                   autocomplete="current-password">
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-secondary hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="submit-btn" class="w-full bg-primary hover:bg-primary-dark text-secondary font-medium py-3 px-4 rounded-xl transition duration-200 shadow-md hover:shadow-lg button-glow">
                        <i class="fas fa-sign-in-alt mr-2"></i> Ingia kama Admin
                    </button>
                </form>
            </div>
        </div>

        <!-- Links -->
        <div class="mt-6 text-center space-y-3">
            <a href="/hotspot" class="text-secondary hover:text-primary flex items-center justify-center">
                <i class="fas fa-wifi mr-2"></i> Kituo cha Wateja
            </a>
            <a href="/" class="text-secondary hover:text-primary flex items-center justify-center">
                <i class="fas fa-home mr-2"></i> Nyumbani
            </a>
        </div>
    </div>

    <!-- Forgot Password Modal -->
    <div id="forgot-password-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50 opacity-0 invisible transition-all duration-300">
        <div class="modal-content bg-accent-light rounded-2xl max-w-md w-full p-6 relative transform -translate-y-5 transition-all duration-300">
            <button onclick="closeModal('forgot-password-modal')" class="absolute top-4 right-4 text-secondary hover:text-primary">
                <i class="fas fa-times"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-key text-primary text-2xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-secondary">Sahau Neno Siri?</h2>
                <p class="text-secondary mt-2">Weka barua pepe yako kupata kiungo cha kubadili neno siri</p>
            </div>
            <form class="space-y-5">
                <div>
                    <label for="reset-email" class="block text-sm font-medium text-secondary mb-1">Barua Pepe</label>
                    <div class="relative">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="reset-email" name="email"
                            class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary"
                            placeholder="admin@hotbando.com" required>
                    </div>
                </div>
                <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-secondary font-medium py-3 px-4 rounded-xl transition duration-200 button-glow">
                    <i class="fas fa-paper-plane mr-2"></i> Tumia Kiungo
                </button>
            </form>
            <div class="mt-4 text-center text-sm text-secondary">
                Ukumbuke neno siri?
                <button onclick="closeModal('forgot-password-modal')" class="text-primary hover:text-primary-dark focus:outline-none">
                    Ingia
                </button>
            </div>
        </div>
    </div>

    <script>
        // Trigger loading bar on page load
        document.addEventListener('DOMContentLoaded', function() {
            const loadingBar = document.getElementById('loading-bar');
            loadingBar.style.display = 'block';
            setTimeout(() => {
                loadingBar.style.display = 'none';
            }, 2000);
        });

        // Password toggle functionality
        document.querySelectorAll('.password-toggle').forEach(toggle => {
            toggle.addEventListener('click', function() {
                const passwordInput = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                } else {
                    passwordInput.type = 'password';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            });
        });

        // Form submission with loading bar
        document.getElementById('login-form').addEventListener('submit', function() {
            const btn = this.querySelector('button[type="submit"]');
            const loadingBar = document.getElementById('loading-bar');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inaingizwa...';
                loadingBar.style.display = 'block';
                loadingBar.style.animation = 'loading 7s ease-in-out forwards';
                setTimeout(() => {
                    loadingBar.style.display = 'none';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sign-in-alt mr-2"></i> Ingia kama Admin';
                }, 7000);
            }
        });

        // Modal functions
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.add('active');
            modal.style.opacity = '1';
            modal.style.visibility = 'visible';
            document.querySelector(`#${modalId} .modal-content`).style.transform = 'translateY(0)';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.remove('active');
            modal.style.opacity = '0';
            modal.style.visibility = 'hidden';
            document.querySelector(`#${modalId} .modal-content`).style.transform = 'translateY(-20px)';
            document.body.style.overflow = 'auto';
        }

        // Close modal when clicking outside
        window.addEventListener('click', function(event) {
            if (event.target.classList.contains('modal')) {
                closeModal(event.target.id);
            }
        });

        // Auto-focus on email input
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.getElementById('email');
            if (emailInput) {
                emailInput.focus();
            }
        });
    </script>
</body>
</html>