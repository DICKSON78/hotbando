        letter-spacing: 0.5px;
        border-bottom: 1px solid #e5e7eb;
      }
      .data-table td {
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
      }
      .data-table tr:hover {
        background: #f9fafb;
      }
      .campaign-type-option input:checked + .campaign-type-card {
        border-color: #FF7A30 !important;
        background-color: rgba(255, 122, 48, 0.1) !important;
        box-shadow: 0 4px 12px rgba(255, 122, 48, 0.2);
        transform: scale(1.05);
      }

      .campaign-type-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      @keyframes pulse-orange {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 122, 48, 0.4); }
        50% { box-shadow: 0 0 0 8px rgba(255, 122, 48, 0); }
      }

      .animate-pulse-orange {
        animation: pulse-orange 2s infinite;
      }
    </style>

    <script>
      let allCampaigns = [];
      let currentFilters = { type: '', status: '', owner: '' };

      // Initialize
      document.addEventListener('DOMContentLoaded', function() {
        loadCampaigns();
      });

      // Load campaigns from API
      async function loadCampaigns() {
        try {
          const response = await fetch('/api/campaigns/my-campaigns');
          const data = await response.json();

          if (data.success) {
            allCampaigns = data.campaigns || [];
            applyFilters();
            updateStats();
          } else {
            // Show empty state with demo data
            allCampaigns = [];
            updateStats();
            renderCampaigns([]);
          }
        } catch (error) {
          console.error('Error loading campaigns:', error);
          // Show empty state
          allCampaigns = [];
          updateStats();
          renderCampaigns([]);
        }
      }

      function updateStats() {
        const totalCampaigns = allCampaigns.length;
        const activeCampaigns = allCampaigns.filter(c => c.is_active).length;
        const totalLeads = allCampaigns.reduce((sum, c) => sum + (c.completions_count || 0), 0);
        const totalSpent = allCampaigns.reduce((sum, c) => sum + (c.spent_budget || 0), 0);

        document.getElementById('total-campaigns').textContent = formatNumber(totalCampaigns);
        document.getElementById('active-campaigns').textContent = formatNumber(activeCampaigns);
        document.getElementById('total-leads').textContent = formatNumber(totalLeads);
        document.getElementById('total-spent').textContent = formatMoneyShort(totalSpent);
      }

      function filterCampaigns() {
        currentFilters.type = document.getElementById('filter-type').value;
        currentFilters.status = document.getElementById('filter-status').value;
        currentFilters.owner = document.getElementById('filter-owner').value;
        applyFilters();
      }

      function clearFilters() {
        document.getElementById('filter-type').value = '';
        document.getElementById('filter-status').value = '';
        document.getElementById('filter-owner').value = '';
        currentFilters = { type: '', status: '', owner: '' };
        applyFilters();
      }

      function applyFilters() {
        let filtered = allCampaigns;

        if (currentFilters.type) {
          filtered = filtered.filter(c => c.campaign_type === currentFilters.type);
        }

        if (currentFilters.status !== '') {
          const isActive = currentFilters.status === '1';
          filtered = filtered.filter(c => c.is_active === isActive);
        }

        if (currentFilters.owner) {
          filtered = filtered.filter(c => c.owner_type === currentFilters.owner);
        }

        renderCampaigns(filtered);
      }

      function renderCampaigns(campaigns) {
        const tbody = document.getElementById('campaigns-tbody');
        const showingCount = document.getElementById('showing-count');
        const totalCount = document.getElementById('total-count');

        showingCount.textContent = campaigns.length;
        totalCount.textContent = allCampaigns.length;

        if (campaigns.length === 0) {
          tbody.innerHTML = \`
            <tr>
              <td colspan="7" class="px-6 py-16 text-center">
                <div class="flex flex-col items-center">
                  <div class="w-24 h-24 bg-gradient-to-br from-orange-100 to-orange-200 rounded-full flex items-center justify-center mb-4">
                    <i class="fas fa-bullhorn text-4xl text-orange-600"></i>
                  </div>
                  <h3 class="text-xl font-bold text-gray-800 mb-2">Hakuna Kampeni</h3>
                  <p class="text-gray-500 mb-6">Bado hujatengeneza kampeni yoyote. Anza kampeni yako ya kwanza leo!</p>
                  <button onclick="openCreateCampaignModal()" class="px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-xl hover:from-orange-600 hover:to-orange-700 transition shadow-lg">
                    <i class="fas fa-plus mr-2"></i>Unda Kampeni ya Kwanza
                  </button>
                </div>
              </td>
            </tr>
          \`;
          return;
        }

        tbody.innerHTML = campaigns.map(campaign => {
          const progressPercent = campaign.total_budget > 0
            ? Math.min(100, (campaign.spent_budget / campaign.total_budget) * 100)
            : 0;

          return \`
            <tr class="hover:bg-gradient-to-r hover:from-orange-50 hover:to-transparent transition-all duration-200">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-orange-400 to-orange-600 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-bullhorn text-white"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-900">\${escapeHtml(campaign.campaign_name)}</div>
                    <div class="text-sm text-gray-500 line-clamp-1">\${escapeHtml(campaign.description || 'Hakuna maelezo')}</div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold \${getCampaignTypeBadge(campaign.campaign_type)}">
                  <i class="\${getCampaignTypeIcon(campaign.campaign_type)}"></i>
                  \${getCampaignTypeLabel(campaign.campaign_type)}
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-purple-400 to-purple-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-building text-white text-xs"></i>
                  </div>
                  <span class="text-sm font-medium text-gray-900">\${escapeHtml(campaign.company_name || campaign.owner_name || '-')}</span>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-green-400 to-green-600 rounded-lg flex items-center justify-center">
                    <i class="fas fa-users text-white text-xs"></i>
                  </div>
                  <span class="text-lg font-bold text-gray-900">\${formatNumber(campaign.completions_count || 0)}</span>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-orange-600">\${formatMoneyShort(campaign.spent_budget || 0)}</span>
                    <span class="text-gray-400">/ \${formatMoneyShort(campaign.total_budget || 0)}</span>
                  </div>
                  <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-orange-500 to-orange-600 rounded-full transition-all duration-500" style="width: \${progressPercent}%"></div>
                  </div>
                  <div class="text-xs text-gray-500 text-right">\${progressPercent.toFixed(1)}%</div>
                </div>
              </td>
              <td class="px-6 py-4">
                <label class="relative inline-flex items-center cursor-pointer group">
                  <input type="checkbox" \${campaign.is_active ? 'checked' : ''} class="sr-only peer"
                         onchange="toggleCampaign(\${campaign.id}, this.checked)">
                  <div class="w-14 h-7 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-orange-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-green-500 peer-checked:to-green-600 shadow-inner"></div>
                  <span class="ml-3 text-sm font-medium text-gray-700 group-hover:text-gray-900 transition">
                    \${campaign.is_active ? '<i class="fas fa-check-circle text-green-600"></i>' : '<i class="fas fa-times-circle text-gray-400"></i>'}
                  </span>
                </label>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <button onclick="viewCampaignDetails(\${campaign.id})"
                          class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="Angalia">
                    <i class="fas fa-eye"></i>
                  </button>
                  <a href="/admin/leads?campaign_id=\${campaign.id}"
                     class="p-2 text-purple-600 hover:bg-purple-50 rounded-lg transition" title="Wateja">
                    <i class="fas fa-users"></i>
                  </a>
                  <button onclick="deleteCampaign(\${campaign.id})"
                          class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Futa">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          \`;
        }).join('');
      }

      function getCampaignTypeLabel(type) {
        const labels = {
          'bank_form': 'Fomu ya Benki',
          'ad_video': 'Video',
          'ad_image': 'Picha',
          'app_install': 'App Install',
          'survey': 'Utafiti'
        };
        return labels[type] || type;
      }

      function getCampaignTypeIcon(type) {
        const icons = {
          'bank_form': 'fas fa-file-alt',
          'ad_video': 'fas fa-video',
          'ad_image': 'fas fa-image',
          'app_install': 'fas fa-mobile-alt',
          'survey': 'fas fa-clipboard-list'
        };
        return icons[type] || 'fas fa-tag';
      }

      function getCampaignTypeBadge(type) {
        const badges = {
          'bank_form': 'bg-gradient-to-r from-blue-100 to-blue-200 text-blue-800',
          'ad_video': 'bg-gradient-to-r from-red-100 to-red-200 text-red-800',
          'ad_image': 'bg-gradient-to-r from-green-100 to-green-200 text-green-800',
          'app_install': 'bg-gradient-to-r from-purple-100 to-purple-200 text-purple-800',
          'survey': 'bg-gradient-to-r from-yellow-100 to-yellow-200 text-yellow-800'
        };
        return badges[type] || 'bg-gradient-to-r from-gray-100 to-gray-200 text-gray-800';
      }

      function formatNumber(num) {
        return Number(num).toLocaleString();
      }

      function formatMoneyShort(amount) {
        if (!amount || amount === 0) return 'TZS 0';
        if (amount >= 1000000000) return 'TZS ' + (amount / 1000000000).toFixed(1) + 'B';
        if (amount >= 1000000) return 'TZS ' + (amount / 1000000).toFixed(1) + 'M';
        if (amount >= 1000) return 'TZS ' + (amount / 1000).toFixed(1) + 'K';
        return 'TZS ' + amount.toLocaleString();
      }

      function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function openCreateCampaignModal() {
        document.getElementById('createCampaignModal').classList.remove('hidden');
      }

      function closeCreateCampaignModal() {
        document.getElementById('createCampaignModal').classList.add('hidden');
        document.getElementById('createCampaignForm').reset();
        document.getElementById('campaignFieldsContainer').classList.add('hidden');
        document.getElementById('formActions').style.display = 'none';
      }

      function showCampaignFields(type) {
        const container = document.getElementById('campaignFieldsContainer');
        const formActions = document.getElementById('formActions');

        container.classList.remove('hidden');
        formActions.style.display = 'flex';
      }

      function submitCampaign(event) {
        event.preventDefault();
        alert('Kampeni imeundwa! (Demo mode - integrate with API)');
        closeCreateCampaignModal();
      }

      function toggleCampaign(id, isActive) {
        console.log(\`Toggle campaign \${id} to \${isActive}\`);
        // Integrate with API
      }

      function viewCampaignDetails(id) {
        console.log(\`View campaign \${id}\`);
        // Integrate with details modal or page
      }

      function deleteCampaign(id) {
        if (confirm('Una uhakika unataka kufuta kampeni hii?')) {
          console.log(\`Delete campaign \${id}\`);
          // Integrate with API
        }
      }
    </script>
  `;
%>

