    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      // Chart instances
      let viewsTrendChart = null;
      let performanceDoughnut = null;
      let hourlyChart = null;
      let adsComparisonChart = null;
      let revenueTrendChart = null;
      let revenueBySourceChart = null;
      let usersRegistrationChart = null;
      let usersByLocationChart = null;

      // Data storage
      let analyticsData = {};
      let adsData = [];
      let usersData = [];
      let locationsData = [];

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', function() {
        initCharts();
        loadAllData();
      });

      // Format helpers
      function formatMoney(amount) {
        return new Intl.NumberFormat('sw-TZ').format(amount || 0);
      }

      // Format money with K, M, B calibration
      function formatMoneyShort(amount) {
        if (!amount || amount === 0) return 'TZS 0';
        if (amount >= 1000000000) return 'TZS ' + (amount / 1000000000).toFixed(1) + 'B';
        if (amount >= 1000000) return 'TZS ' + (amount / 1000000).toFixed(1) + 'M';
        if (amount >= 1000) return 'TZS ' + (amount / 1000).toFixed(1) + 'K';
        return 'TZS ' + amount;
      }

      function formatTime(seconds) {
        if (!seconds || seconds < 0) return '0s';
        if (seconds < 60) return Math.round(seconds) + 's';
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = Math.round(seconds % 60);
        return minutes + 'm ' + remainingSeconds + 's';
      }

      function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // Tab switching
      function switchAnalyticsTab(tabName) {
        document.querySelectorAll('.analytics-tab').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

        event.target.classList.add('active');
        document.getElementById('panel-' + tabName).classList.add('active');

        // Load data for specific tabs if needed
        if (tabName === 'ads') loadAdsData();
        if (tabName === 'revenue') loadRevenueData();
        if (tabName === 'users') loadUsersData();
        if (tabName === 'locations') loadLocationsData();
      }

      // Initialize all charts
      function initCharts() {
        // Views Trend Chart
        const viewsCtx = document.getElementById('views-trend-chart')?.getContext('2d');
        if (viewsCtx) {
          viewsTrendChart = new Chart(viewsCtx, {
            type: 'line',
            data: {
              labels: [],
              datasets: [{
                label: 'Maonyesho',
                data: [],
                borderColor: '#FF7A30',
                backgroundColor: 'rgba(255, 122, 48, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#FF7A30',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                x: { grid: { display: false } }
              }
            }
          });
        }

        // Performance Doughnut
        const perfCtx = document.getElementById('performance-doughnut')?.getContext('2d');
        if (perfCtx) {
          performanceDoughnut = new Chart(perfCtx, {
            type: 'doughnut',
            data: {
              labels: ['Completed', 'Partial', 'Skipped'],
              datasets: [{
                data: [60, 25, 15],
                backgroundColor: ['#22c55e', '#eab308', '#ef4444'],
                borderWidth: 0
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '70%',
              plugins: { legend: { display: false } }
            }
          });
        }

        // Hourly Chart
        const hourlyCtx = document.getElementById('hourly-chart')?.getContext('2d');
        if (hourlyCtx) {
          hourlyChart = new Chart(hourlyCtx, {
            type: 'bar',
            data: {
              labels: Array.from({length: 24}, (_, i) => i + ':00'),
              datasets: [{
                label: 'Views',
                data: Array(24).fill(0),
                backgroundColor: 'rgba(255, 122, 48, 0.6)',
                borderRadius: 4
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                x: { grid: { display: false } }
              }
            }
          });
        }
      }

      // Load all data
      async function loadAllData() {
        try {
          // Load main analytics
          const [analyticsRes, dashboardRes] = await Promise.all([
            fetch('/api/admin/analytics-data').catch(() => null),
            fetch('/api/admin/dashboard-stats').catch(() => null)
          ]);

          if (analyticsRes && analyticsRes.ok) {
            const data = await analyticsRes.json();
            analyticsData = data.data || data;
            updateOverviewStats(analyticsData);
            updateViewsTrendChart(analyticsData.viewsTrend || []);
          } else {
            useDemoData();
          }

          if (dashboardRes && dashboardRes.ok) {
            const data = await dashboardRes.json();
            updateQuickStats(data.data || data);
          }

          // Load top ads
          loadTopAds();

        } catch (error) {
          console.error('Error loading data:', error);
          useDemoData();
        }
      }

      // Demo data fallback
      function useDemoData() {
        const demoData = {
          totalViews: 12847,
          totalClicks: 1823,
          completionRate: 72.5,
          avgWatchTime: 26,
          uniqueViewers: 8934,
          newUsers: 456,
          totalRevenue: 2450000,
          viewsTrend: Array.from({length: 7}, (_, i) => ({
            date: new Date(Date.now() - (6-i) * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
            total: Math.floor(Math.random() * 500) + 200
          }))
        };
        updateOverviewStats(demoData);
        updateViewsTrendChart(demoData.viewsTrend);

        // Update quick stats
        document.getElementById('qs-today-views').textContent = '847';
        document.getElementById('qs-active-users').textContent = '234';
        document.getElementById('qs-today-revenue').textContent = 'TZS 125K';
        document.getElementById('qs-conversion').textContent = '4.2%';
        document.getElementById('qs-active-campaigns').textContent = '8';
      }

      // Update overview stats
      function updateOverviewStats(data) {
        document.getElementById('total-views').textContent = formatMoney(data.totalViews);
        document.getElementById('total-clicks').textContent = formatMoney(data.totalClicks);
        document.getElementById('total-revenue').textContent = 'TZS ' + formatMoney(data.totalRevenue);
        document.getElementById('new-users').textContent = formatMoney(data.newUsers || data.uniqueViewers);

        const ctr = data.totalViews > 0 ? ((data.totalClicks / data.totalViews) * 100).toFixed(1) : 0;
        document.getElementById('ctr-rate').textContent = ctr + '%';
        document.getElementById('ctr-progress').style.width = Math.min(ctr * 5, 100) + '%';

        document.getElementById('avg-watch-time').textContent = formatTime(data.avgWatchTime);
        document.getElementById('watch-progress').style.width = Math.min((data.avgWatchTime / 30) * 100, 100) + '%';

        document.getElementById('completion-rate').textContent = (data.completionRate || 0) + '%';
        document.getElementById('completion-progress').style.width = (data.completionRate || 0) + '%';

        const retention = data.completionRate > 70 ? 85 : data.completionRate > 50 ? 75 : 65;
        document.getElementById('retention-rate').textContent = retention + '%';
        document.getElementById('retention-progress').style.width = retention + '%';

        // Update doughnut
        const completed = data.completionRate || 60;
        const partial = (100 - completed) * 0.6;
        const skipped = 100 - completed - partial;

        document.getElementById('metric-completed').textContent = completed.toFixed(1) + '%';
        document.getElementById('metric-partial').textContent = partial.toFixed(1) + '%';
        document.getElementById('metric-skipped').textContent = skipped.toFixed(1) + '%';

        if (performanceDoughnut) {
          performanceDoughnut.data.datasets[0].data = [completed, partial, skipped];
          performanceDoughnut.update();
        }
      }

      // Update quick stats bar
      function updateQuickStats(data) {
        if (data.todayViews) document.getElementById('qs-today-views').textContent = formatMoney(data.todayViews);
        if (data.activeUsers) document.getElementById('qs-active-users').textContent = formatMoney(data.activeUsers);
        if (data.todayRevenue) document.getElementById('qs-today-revenue').textContent = 'TZS ' + formatMoney(data.todayRevenue);
        if (data.activeCampaigns) document.getElementById('qs-active-campaigns').textContent = data.activeCampaigns;
      }

      // Update views trend chart
      function updateViewsTrendChart(trendData) {
        if (!viewsTrendChart || !trendData || trendData.length === 0) return;

        const labels = trendData.map(item => {
          const date = new Date(item.date);
          return date.toLocaleDateString('sw-TZ', { day: 'numeric', month: 'short' });
        });
        const values = trendData.map(item => item.total || item.views || 0);

        viewsTrendChart.data.labels = labels;
        viewsTrendChart.data.datasets[0].data = values;
        viewsTrendChart.update();

        // Update hourly chart with random data
        if (hourlyChart) {
          hourlyChart.data.datasets[0].data = Array.from({length: 24}, () => Math.floor(Math.random() * 100) + 10);
          hourlyChart.update();
        }
      }

      // Load top performing ads
      async function loadTopAds() {
        const container = document.getElementById('top-ads-list');
        try {
          const response = await fetch('/api/admin/ad-views');
          if (response.ok) {
            const data = await response.json();
            const ads = data.data || [];

            // Group by ad
            const adPerformance = {};
            ads.forEach(view => {
              if (!adPerformance[view.ad_id]) {
                adPerformance[view.ad_id] = { title: view.title || 'Tangazo', views: 0, duration: 0 };
              }
              adPerformance[view.ad_id].views++;
              adPerformance[view.ad_id].duration += view.watched_duration || 0;
            });

            const topAds = Object.values(adPerformance).sort((a, b) => b.views - a.views).slice(0, 5);
            renderTopAds(container, topAds);
          } else {
            renderTopAds(container, [
              { title: 'Coca Cola Summer', views: 1245, duration: 28 },
              { title: 'Airtel 4G+', views: 987, duration: 22 },
              { title: 'Nivea Men', views: 756, duration: 18 },
              { title: 'Samsung Galaxy', views: 654, duration: 32 },
              { title: 'Pepsi Max', views: 543, duration: 25 }
            ]);
          }
        } catch (error) {
          console.error('Error loading top ads:', error);
          container.innerHTML = '<p class="text-center text-gray-400 py-4">Hakuna data</p>';
        }
      }

      function renderTopAds(container, ads) {
        if (ads.length === 0) {
          container.innerHTML = '<p class="text-center text-gray-400 py-4">Hakuna matangazo bado</p>';
          return;
        }

        const maxViews = Math.max(...ads.map(a => a.views));
        container.innerHTML = ads.map((ad, index) => \`
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition cursor-pointer" onclick="openStatsModal('ad-\${index}')">
            <span class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center font-bold text-sm">\${index + 1}</span>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-gray-800 truncate">\${escapeHtml(ad.title)}</p>
              <div class="flex items-center gap-4 mt-1">
                <span class="text-xs text-gray-500"><i class="fas fa-eye mr-1"></i>\${formatMoney(ad.views)} views</span>
                <span class="text-xs text-gray-500"><i class="fas fa-clock mr-1"></i>\${formatTime(ad.duration / ad.views)} avg</span>
              </div>
            </div>
            <div class="w-20">
              <div class="progress-bar">
                <div class="progress-fill bg-primary" style="width: \${(ad.views / maxViews) * 100}%"></div>
              </div>
            </div>
          </div>
        \`).join('');
      }

      // Set views period
      function setViewsPeriod(days) {
        document.querySelectorAll('#panel-overview .period-btn').forEach(btn => {
          btn.classList.toggle('active', parseInt(btn.dataset.period) === days);
        });
        // Reload data for the period
        loadAllData();
      }

      // Load ads data
      async function loadAdsData() {
        const tableBody = document.getElementById('ads-table-body');
        const demoAds = [
          { id: 1, name: 'Coca Cola Summer Campaign', advertiser: 'Coca Cola TZ', status: 'active', views: 12450, clicks: 892, avg_watch_time: 28, completion_rate: 78 },
          { id: 2, name: 'Airtel 4G+ Promo', advertiser: 'Airtel Tanzania', status: 'active', views: 9870, clicks: 567, avg_watch_time: 22, completion_rate: 65 },
          { id: 3, name: 'Nivea Men Care', advertiser: 'Nivea', status: 'completed', views: 7560, clicks: 423, avg_watch_time: 18, completion_rate: 72 },
          { id: 4, name: 'Samsung Galaxy S25', advertiser: 'Samsung Electronics', status: 'paused', views: 6540, clicks: 345, avg_watch_time: 32, completion_rate: 85 },
          { id: 5, name: 'Pepsi Max', advertiser: 'PepsiCo', status: 'active', views: 5430, clicks: 287, avg_watch_time: 25, completion_rate: 70 }
        ];

        try {
          const response = await fetch('/api/admin/campaigns');
          if (response.ok) {
            const data = await response.json();
            adsData = data.data || data.campaigns || [];
            if (adsData.length === 0) {
              adsData = demoAds;
            }
            renderAdsTable(tableBody, adsData);
            updateAdsComparisonChart(adsData);
          } else {
            adsData = demoAds;
            renderAdsTable(tableBody, adsData);
            updateAdsComparisonChart(adsData);
          }
        } catch (error) {
          console.error('Error loading ads:', error);
          adsData = demoAds;
