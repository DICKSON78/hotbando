                  <div class="flex items-center"><span class="breakdown-color bg-blue-500"></span>Subscriptions</div>
                  <span class="font-semibold">TZS 735,000 (30%)</span>
                </div>
                <div class="breakdown-item">
                  <div class="flex items-center"><span class="breakdown-color bg-green-500"></span>Ad Revenue</div>
                  <span class="font-semibold">TZS 367,500 (15%)</span>
                </div>
              </div>
            \`;
            break;

          case 'users':
            title.textContent = 'Takwimu za Watumiaji';
            subtitle.textContent = 'User demographics';
            content = \`
              <div class="stats-grid mb-6">
                <div class="stats-item">
                  <div class="stats-item-value text-purple-600">\${document.getElementById('new-users').textContent}</div>
                  <div class="stats-item-label">Wapya Mwezi</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-green-600">\${document.getElementById('qs-active-users').textContent}</div>
                  <div class="stats-item-label">Active Sasa</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-blue-600">85%</div>
                  <div class="stats-item-label">Retention</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-orange-600">12.5</div>
                  <div class="stats-item-label">Avg Sessions</div>
                </div>
              </div>
              <h4 class="font-semibold mb-3">User Distribution</h4>
              <div class="breakdown-list">
                <div class="breakdown-item">
                  <div class="flex items-center"><span class="breakdown-color bg-blue-500"></span>Students</div>
                  <span class="font-semibold">78%</span>
                </div>
                <div class="breakdown-item">
                  <div class="flex items-center"><span class="breakdown-color bg-green-500"></span>Staff</div>
                  <span class="font-semibold">15%</span>
                </div>
                <div class="breakdown-item">
                  <div class="flex items-center"><span class="breakdown-color bg-purple-500"></span>Visitors</div>
                  <span class="font-semibold">7%</span>
                </div>
              </div>
            \`;
            break;

          case 'performance':
            title.textContent = 'Ufanisi wa Jumla';
            subtitle.textContent = 'Overall performance metrics';
            content = \`
              <div class="stats-grid mb-6">
                <div class="stats-item">
                  <div class="stats-item-value text-green-600">\${document.getElementById('metric-completed').textContent}</div>
                  <div class="stats-item-label">Completed</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-cyan-600">\${document.getElementById('ctr-rate').textContent}</div>
                  <div class="stats-item-label">CTR</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-indigo-600">\${document.getElementById('avg-watch-time').textContent}</div>
                  <div class="stats-item-label">Avg Watch</div>
                </div>
                <div class="stats-item">
                  <div class="stats-item-value text-amber-600">\${document.getElementById('retention-rate').textContent}</div>
                  <div class="stats-item-label">Retention</div>
                </div>
              </div>
              <h4 class="font-semibold mb-3">Performance Trends</h4>
              <div class="space-y-4">
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span>View Completion</span>
                    <span class="font-semibold">\${document.getElementById('completion-rate').textContent}</span>
                  </div>
                  <div class="progress-bar"><div class="progress-fill bg-green-500" style="width: \${document.getElementById('completion-rate').textContent}"></div></div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span>Click-through Rate</span>
                    <span class="font-semibold">\${document.getElementById('ctr-rate').textContent}</span>
                  </div>
                  <div class="progress-bar"><div class="progress-fill bg-cyan-500" style="width: \${parseFloat(document.getElementById('ctr-rate').textContent) * 5}%"></div></div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span>User Retention</span>
                    <span class="font-semibold">\${document.getElementById('retention-rate').textContent}</span>
                  </div>
                  <div class="progress-bar"><div class="progress-fill bg-amber-500" style="width: \${document.getElementById('retention-rate').textContent}"></div></div>
                </div>
              </div>
            \`;
            break;

          default:
            title.textContent = 'Takwimu';
            subtitle.textContent = 'Statistics details';
            content = '<p class="text-center text-gray-400 py-8">Data inapakuliwa...</p>';
        }

        body.innerHTML = content;
        modal.classList.add('show');

        // Initialize mini chart if present
        if (type === 'views') {
          setTimeout(() => {
            const ctx = document.getElementById('modal-views-chart')?.getContext('2d');
            if (ctx) {
              new Chart(ctx, {
                type: 'bar',
                data: {
                  labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                  datasets: [{
                    data: [145, 189, 167, 201, 178, 192, 175],
                    backgroundColor: 'rgba(255, 122, 48, 0.6)',
                    borderRadius: 4
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: {
                    y: { beginAtZero: true, display: false },
                    x: { grid: { display: false } }
                  }
                }
              });
            }
          }, 100);
        }
      }

      function closeStatsModal(event) {
        if (event && event.target !== event.currentTarget) return;
        document.getElementById('statsModal').classList.remove('show');
      }

      // Close modal on ESC key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeStatsModal();
        }
      });

      // Refresh all data
      function refreshAllData() {
        loadAllData();
        const currentTab = document.querySelector('.analytics-tab.active')?.textContent.trim().toLowerCase();
        if (currentTab?.includes('matangazo')) loadAdsData();
        if (currentTab?.includes('mapato')) loadRevenueData();
        if (currentTab?.includes('watumiaji')) loadUsersData();
        if (currentTab?.includes('maeneo')) loadLocationsData();
      }

      // Export functions
      function exportAnalytics() {
        alert('Exporting analytics data...');
      }

      function exportAdsData() {
        alert('Exporting ads data...');
      }

      function exportLocationsData() {
        alert('Exporting locations data...');
      }

      function viewAdDetails(adId) {
        openStatsModal('ad-' + adId);
      }

      function viewLocationStats(locationId) {
        openStatsModal('location-' + locationId);
      }

      function filterAds() {
        const filter = document.getElementById('ad-filter').value;
        // Implement filter logic
        console.log('Filtering by:', filter);
      }

      function setRevenuePeriod(period) {
        document.querySelectorAll('#panel-revenue .period-btn').forEach(btn => {
          btn.classList.toggle('active', btn.textContent.toLowerCase().includes(period.substring(0, 4)));
        });
        // Reload revenue data for the period
        loadRevenueData();
      }
    </script>
  `;
