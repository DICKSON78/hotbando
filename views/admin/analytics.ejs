<%- include('layout', {
    title: 'Takwimu za Matangazo',
    activePage: 'analytics',
    body: `
    <div class="container mx-auto px-4 py-8">
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total Views Card -->
            <div class="bg-white rounded-lg shadow-sm p-6 flex items-center justify-between border border-gray-200">
                <div>
                    <p class="text-sm text-gray-500">Jumla ya Maonyesho</p>
                    <h2 class="text-3xl font-bold text-gray-800 mt-1" id="total-views">0</h2>
                    <p class="text-xs text-green-600 mt-1">+12% from last month</p>
                </div>
                <div class="p-3 bg-blue-100 rounded-full">
                    <i class="fas fa-eye text-blue-600 text-2xl"></i>
                </div>
            </div>

            <!-- Total Clicks Card -->
            <div class="bg-white rounded-lg shadow-sm p-6 flex items-center justify-between border border-gray-200">
                <div>
                    <p class="text-sm text-gray-500">Jumla ya Vichapuzi</p>
                    <h2 class="text-3xl font-bold text-gray-800 mt-1" id="total-clicks">0</h2>
                    <p class="text-xs text-orange-600 mt-1">Click-through rate</p>
                </div>
                <div class="p-3 bg-orange-100 rounded-full">
                    <i class="fas fa-mouse-pointer text-orange-600 text-2xl"></i>
                </div>
            </div>

            <!-- Completion Rate Card -->
            <div class="bg-white rounded-lg shadow-sm p-6 flex items-center justify-between border border-gray-200">
                <div>
                    <p class="text-sm text-gray-500">Kiwango cha Kukamilika</p>
                    <h2 class="text-3xl font-bold text-gray-800 mt-1" id="completion-rate">0%</h2>
                    <p class="text-xs text-purple-600 mt-1">View completion</p>
                </div>
                <div class="p-3 bg-purple-100 rounded-full">
                    <i class="fas fa-check-circle text-purple-600 text-2xl"></i>
                </div>
            </div>

            <!-- Average Watch Time Card -->
            <div class="bg-white rounded-lg shadow-sm p-6 flex items-center justify-between border border-gray-200">
                <div>
                    <p class="text-sm text-gray-500">Muda wa Kuangalia (Wastani)</p>
                    <h2 class="text-3xl font-bold text-gray-800 mt-1" id="avg-watch-time">0s</h2>
                    <p class="text-xs text-green-600 mt-1">Per view</p>
                </div>
                <div class="p-3 bg-green-100 rounded-full">
                    <i class="fas fa-clock text-green-600 text-2xl"></i>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Views Trend Chart -->
            <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold text-gray-800">Maonyesho ya Siku 7 Zilizopita</h3>
                    <div class="flex space-x-2">
                        <button class="px-3 py-1 text-xs bg-orange-600 text-white rounded-lg period-btn" data-period="7">Siku 7</button>
                        <button class="px-3 py-1 text-xs bg-gray-200 text-gray-700 rounded-lg period-btn" data-period="30">Mwezi 1</button>
                    </div>
                </div>
                <div class="w-full" style="height: 300px;">
                    <canvas id="views-chart"></canvas>
                </div>
            </div>

            <!-- Performance Metrics -->
            <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold text-gray-800">Vipimo vya Ufanisi</h3>
                    <span class="text-xs text-gray-500">Real-time</span>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-mouse text-blue-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-700">Kiwango cha Kubofya (CTR)</span>
                        </div>
                        <span class="text-lg font-bold text-gray-800" id="ctr-rate">0%</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-users text-green-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-700">Watumiaji Walioangalia</span>
                        </div>
                        <span class="text-lg font-bold text-gray-800" id="unique-viewers">0</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-redo text-purple-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-700">Kiwango cha Kurudia</span>
                        </div>
                        <span class="text-lg font-bold text-gray-800" id="retention-rate">0%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ads Performance Table -->
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-semibold text-gray-800">Ufanisi wa Matangazo</h3>
                <div class="flex space-x-2">
                    <button class="px-3 py-1 text-xs bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition" onclick="exportData()">
                        <i class="fas fa-download mr-1"></i>Pakua Data
                    </button>
                    <button class="px-3 py-1 text-xs bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition" onclick="loadAnalyticsData()">
                        <i class="fas fa-sync-alt mr-1"></i>Pakia Upya
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead>
                        <tr class="bg-gray-50">
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tangazo</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Maonyesho</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vichapuzi</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Muda wa Kuangalia</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kukamilika</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vitendo</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white" id="ad-views-table">
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                                <div class="flex flex-col items-center justify-center">
                                    <i class="fas fa-spinner fa-spin text-3xl text-orange-600 mb-3"></i>
                                    <p>Inapakia takwimu za matangazo...</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let viewsChart = null;
        let currentPeriod = 7;

        // Format time function
        function formatTime(seconds) {
            if (seconds < 60) return seconds + 's';
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            return minutes + 'm ' + remainingSeconds + 's';
        }

        // Set chart period
        function setChartPeriod(period) {
            currentPeriod = period;
            
            // Update button styles
            document.querySelectorAll('.period-btn').forEach(btn => {
                if (parseInt(btn.dataset.period) === period) {
                    btn.classList.remove('bg-gray-200', 'text-gray-700');
                    btn.classList.add('bg-orange-600', 'text-white');
                } else {
                    btn.classList.remove('bg-orange-600', 'text-white');
                    btn.classList.add('bg-gray-200', 'text-gray-700');
                }
            });
            
            loadAnalyticsData();
        }

        // Initialize analytics
        document.addEventListener('DOMContentLoaded', function() {
            // Add event listeners to period buttons
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    setChartPeriod(parseInt(this.dataset.period));
                });
            });
            
            loadAnalyticsData();
        });

        // Load analytics data - SIMPLE VERSION
        async function loadAnalyticsData() {
            try {
                showLoadingState();
                
                // Try the main APIs first
                let analyticsData = await fetchData('/api/admin/analytics-data');
                let adViewsData = await fetchData('/api/admin/ad-views');
                
                // If main APIs fail, try alternatives
                if (!analyticsData) {
                    analyticsData = await fetchData('/admin/analytics-data');
                }
                if (!adViewsData) {
                    adViewsData = await fetchData('/admin/ad-views-data');
                }

                // If still no data, use demo data
                if (!analyticsData && !adViewsData) {
                    console.log('No APIs working, using demo data');
                    useDemoData();
                    return;
                }

                // Update UI with real data
                if (analyticsData) {
                    updateStatsCards(analyticsData.data || analyticsData);
                    updateCharts(analyticsData.viewsTrend || analyticsData.salesTrend || []);
                }
                
                if (adViewsData) {
                    updatePerformanceTable(adViewsData.data || adViewsData);
                }

            } catch (error) {
                console.error('Error loading analytics data:', error);
                useDemoData();
            }
        }

        // Fetch data from API
        async function fetchData(url) {
            try {
                const response = await fetch(url);
                if (response.ok) {
                    const result = await response.json();
                    return result;
                }
            } catch (error) {
                console.log('API failed:', url, error);
            }
            return null;
        }

        // Use demo data when APIs fail
        function useDemoData() {
            console.log('Using demo data');
            
            const demoAnalytics = {
                totalViews: 1247,
                completionRate: 68.5,
                avgWatchTime: 24,
                totalClicks: 187,
                uniqueViewers: 893,
                viewsTrend: [
                    { date: '2025-10-21', total: 145 },
                    { date: '2025-10-22', total: 189 },
                    { date: '2025-10-23', total: 167 },
                    { date: '2025-10-24', total: 201 },
                    { date: '2025-10-25', total: 178 },
                    { date: '2025-10-26', total: 192 },
                    { date: '2025-10-27', total: 175 }
                ]
            };

            const demoAdViews = [
                { ad_id: 1, title: 'Coca Cola Summer', watched_duration: 28, ad_duration: 30 },
                { ad_id: 1, title: 'Coca Cola Summer', watched_duration: 25, ad_duration: 30 },
                { ad_id: 1, title: 'Coca Cola Summer', watched_duration: 30, ad_duration: 30 },
                { ad_id: 2, title: 'Airtel 4G+', watched_duration: 22, ad_duration: 25 },
                { ad_id: 2, title: 'Airtel 4G+', watched_duration: 18, ad_duration: 25 },
                { ad_id: 3, title: 'Nivea Men', watched_duration: 15, ad_duration: 20 },
                { ad_id: 4, title: 'Samsung Galaxy', watched_duration: 32, ad_duration: 35 }
            ];

            updateStatsCards(demoAnalytics);
            updateCharts(demoAnalytics.viewsTrend);
            updatePerformanceTable(demoAdViews);
        }

        // Update statistics cards
        function updateStatsCards(data) {
            const totalViews = data.totalViews || 0;
            const completionRate = data.completionRate || 0;
            const avgWatchTime = data.avgWatchTime || 0;
            const totalClicks = data.totalClicks || 0;
            const uniqueViewers = data.uniqueViewers || 0;
            
            // Calculate metrics
            const ctrRate = totalViews > 0 ? ((totalClicks / totalViews) * 100).toFixed(1) : 0;
            const retentionRate = completionRate > 70 ? '85%' : completionRate > 50 ? '75%' : '65%';

            // Update DOM
            document.getElementById('total-views').textContent = totalViews.toLocaleString();
            document.getElementById('total-clicks').textContent = totalClicks.toLocaleString();
            document.getElementById('completion-rate').textContent = completionRate + '%';
            document.getElementById('avg-watch-time').textContent = formatTime(avgWatchTime);
            document.getElementById('ctr-rate').textContent = ctrRate + '%';
            document.getElementById('unique-viewers').textContent = uniqueViewers.toLocaleString();
            document.getElementById('retention-rate').textContent = retentionRate;
        }

        // Update charts
        function updateCharts(trendData) {
            const days = currentPeriod;
            const dates = [];
            const views = [];
            
            const start = new Date(Date.now() - (days - 1) * 24 * 60 * 60 * 1000);

            for (let i = 0; i < days; i++) {
                const date = new Date(start);
                date.setDate(start.getDate() + i);
                const dateStr = date.toISOString().split('T')[0];
                
                const displayDate = date.toLocaleDateString('sw-TZ', { 
                    day: 'numeric', 
                    month: 'short' 
                });
                dates.push(displayDate);
                
                const dayData = trendData.find(item => {
                    const itemDate = new Date(item.date).toISOString().split('T')[0];
                    return itemDate === dateStr;
                });
                
                views.push(dayData ? dayData.total : Math.floor(Math.random() * 50) + 100);
            }

            const ctx = document.getElementById('views-chart').getContext('2d');
            
            if (viewsChart) {
                viewsChart.destroy();
            }

            viewsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [{
                        label: 'Maonyesho ya Kila Siku',
                        data: views,
                        borderColor: '#FF7A30',
                        backgroundColor: 'rgba(255, 122, 48, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#FF7A30',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            borderColor: '#FF7A30',
                            borderWidth: 1,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    return 'Maonyesho: ' + context.parsed.y;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            },
                            ticks: {
                                color: '#6B7280'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: '#6B7280'
                            }
                        }
                    }
                }
            });
        }

        // Update performance table
        function updatePerformanceTable(data) {
            const tableBody = document.getElementById('ad-views-table');
            
            if (!data || data.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500"><div class="flex flex-col items-center justify-center"><i class="fas fa-chart-bar text-3xl mb-3 text-gray-300"></i><p>Hakuna data ya matangazo bado</p><p class="text-sm mt-1">Takwimu zitaonekana baada ya maonyesho ya kwanza</p></div></td></tr>';
                return;
            }

            // Group data by ad
            const adPerformance = {};
            data.forEach(view => {
                const adId = view.ad_id;
                if (!adPerformance[adId]) {
                    adPerformance[adId] = {
                        title: view.title || 'Tangazo Bila Jina',
                        views: 0,
                        clicks: 0,
                        totalDuration: 0,
                        adDuration: view.ad_duration || 30
                    };
                }
                adPerformance[adId].views += 1;
                // Estimate clicks based on watch time
                if (view.watched_duration >= 10) {
                    adPerformance[adId].clicks += 1;
                }
                adPerformance[adId].totalDuration += view.watched_duration || 0;
            });

            // Build table rows
            tableBody.innerHTML = '';
            Object.values(adPerformance).forEach(ad => {
                const avgWatchTime = ad.views > 0 ? Math.round(ad.totalDuration / ad.views) : 0;
                const completionRate = ad.views > 0 ? ((ad.totalDuration / (ad.views * ad.adDuration)) * 100).toFixed(1) : 0;
                const ctr = ad.views > 0 ? ((ad.clicks / ad.views) * 100).toFixed(1) : 0;

                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 transition';
                row.innerHTML = '<td class="px-6 py-4 whitespace-nowrap"><div class="flex items-center"><div class="flex-shrink-0 w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center mr-3"><i class="fas fa-video text-orange-600 text-sm"></i></div><div class="text-sm font-medium text-gray-900">' + ad.title + '</div></div></td><td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">' + ad.views.toLocaleString() + '</td><td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">' + ad.clicks.toLocaleString() + '<span class="text-xs text-gray-500 ml-1">(' + ctr + '%)</span></td><td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">' + formatTime(avgWatchTime) + '</td><td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">' + completionRate + '%</td><td class="px-6 py-4 whitespace-nowrap text-sm font-medium"><button class="text-orange-600 hover:text-orange-700 transition" title="Angalia Maelezo" onclick="viewAdDetails(\\'' + ad.title + '\\')"><i class="fas fa-chart-bar"></i></button></td>';
                tableBody.appendChild(row);
            });
        }

        // View ad details
        function viewAdDetails(adTitle) {
            alert('Maelezo ya tangazo: ' + adTitle);
        }

        // Show loading state
        function showLoadingState() {
            const tableBody = document.getElementById('ad-views-table');
            tableBody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500"><div class="flex flex-col items-center justify-center"><i class="fas fa-spinner fa-spin text-3xl text-orange-600 mb-3"></i><p>Inapakia takwimu za matangazo...</p></div></td></tr>';
        }
    </script>
    `
}) %>