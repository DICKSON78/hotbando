      function updateLocationsStats(locations) {
        document.getElementById('locations-total').textContent = locations.length;
        document.getElementById('locations-active').textContent = locations.filter(l => l.is_active).length;

        const totalUsers = locations.reduce((sum, l) => sum + (l.user_count || 0), 0);
        const avgUsers = locations.length > 0 ? Math.round(totalUsers / locations.length) : 0;
        document.getElementById('avg-users-location').textContent = avgUsers;
      }

      function renderLocationsTablePaginated() {
        const container = document.getElementById('locations-table-body');
        if (locationsData.length === 0) {
          container.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Hakuna maeneo</td></tr>';
          updateLocationsPagination(0, 0, 0);
          return;
        }

        const totalPages = Math.ceil(locationsData.length / locationsPerPage);
        if (locationsCurrentPage > totalPages) locationsCurrentPage = totalPages;
        if (locationsCurrentPage < 1) locationsCurrentPage = 1;

        const startIndex = (locationsCurrentPage - 1) * locationsPerPage;
        const endIndex = Math.min(startIndex + locationsPerPage, locationsData.length);
        const pageLocations = locationsData.slice(startIndex, endIndex);

        const typeLabels = { university: 'Chuo Kikuu', college: 'Chuo', hostel: 'Bweni', mall: 'Mall', hotel: 'Hoteli' };

        container.innerHTML = pageLocations.map(loc => \`
          <tr class="hover:bg-gray-50">
            <td>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <i class="fas fa-map-marker-alt text-blue-600"></i>
                </div>
                <div>
                  <p class="font-medium text-gray-800">\${escapeHtml(loc.location_name || loc.name)}</p>
                  <p class="text-xs text-gray-500">\${escapeHtml(loc.city || '')}, \${escapeHtml(loc.region || '')}</p>
                </div>
              </div>
            </td>
            <td>\${typeLabels[loc.location_type] || loc.location_type || 'N/A'}</td>
            <td>\${formatMoney(loc.user_count || 0)}</td>
            <td>\${formatMoneyShort(loc.revenue || 0)}</td>
            <td><span class="badge badge-\${loc.is_active ? 'success' : 'danger'}">\${loc.is_active ? 'Active' : 'Inactive'}</span></td>
            <td>
              <button onclick="viewLocationStats(\${loc.id})" class="text-primary hover:text-primary-dark">
                <i class="fas fa-chart-bar"></i>
              </button>
            </td>
          </tr>
        \`).join('');

        updateLocationsPagination(startIndex + 1, endIndex, locationsData.length);
        renderLocationsPaginationButtons(totalPages);
      }

      function updateLocationsPagination(start, end, total) {
        document.getElementById('locations-pagination-info').textContent =
          total === 0 ? 'Hakuna maeneo' : \`Inaonyesha \${start} - \${end} ya \${total} maeneo\`;
      }

      function renderLocationsPaginationButtons(totalPages) {
        const container = document.getElementById('locations-pagination-buttons');
        if (totalPages <= 1) {
          container.innerHTML = '';
          return;
        }

        let buttons = '';

        // Previous button
        buttons += \`<button onclick="goToLocationsPage(\${locationsCurrentPage - 1})"
          class="px-3 py-1 rounded text-sm \${locationsCurrentPage === 1 ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}"
          \${locationsCurrentPage === 1 ? 'disabled' : ''}>
          <i class="fas fa-chevron-left"></i>
        </button>\`;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= locationsCurrentPage - 1 && i <= locationsCurrentPage + 1)) {
            buttons += \`<button onclick="goToLocationsPage(\${i})"
              class="px-3 py-1 rounded text-sm \${i === locationsCurrentPage ? 'bg-primary text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}">
              \${i}
            </button>\`;
          } else if (i === locationsCurrentPage - 2 || i === locationsCurrentPage + 2) {
            buttons += '<span class="px-2 text-gray-400">...</span>';
          }
        }

        // Next button
        buttons += \`<button onclick="goToLocationsPage(\${locationsCurrentPage + 1})"
          class="px-3 py-1 rounded text-sm \${locationsCurrentPage === totalPages ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}"
          \${locationsCurrentPage === totalPages ? 'disabled' : ''}>
          <i class="fas fa-chevron-right"></i>
        </button>\`;

        container.innerHTML = buttons;
      }

      function goToLocationsPage(page) {
        locationsCurrentPage = page;
        renderLocationsTablePaginated();
      }

      function changeLocationsPerPage() {
        locationsPerPage = parseInt(document.getElementById('locations-per-page').value);
        locationsCurrentPage = 1;
        renderLocationsTablePaginated();
      }

