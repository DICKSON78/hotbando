<%
  const leadsContent = `
    <div class="container mx-auto px-4 py-8">
      <!-- Page Header -->
      <div class="flex justify-between items-center mb-6">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Wateja Wapya</h1>
          <p class="text-gray-600 text-sm mt-1">Simamia wateja kutoka kampeni za benki</p>
        </div>
        <button onclick="exportLeads()" class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition flex items-center">
          <i class="fas fa-file-excel mr-2"></i>
          Export Excel
        </button>
      </div>

      <!-- Filters -->
      <div class="bg-white rounded-lg shadow-sm p-4 mb-6 border border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="text-sm text-gray-600">Chagua Kampeni</label>
            <select id="filter-campaign" class="w-full mt-1 p-2 border border-gray-300 rounded-lg" onchange="filterLeads()">
              <option value="">Zote</option>
            </select>
          </div>
          <div>
            <label class="text-sm text-gray-600">Hali ya Mteja</label>
            <select id="filter-status" class="w-full mt-1 p-2 border border-gray-300 rounded-lg" onchange="filterLeads()">
              <option value="">Zote</option>
              <option value="new">Mpya</option>
              <option value="contacted">Amepigiwa Simu</option>
              <option value="qualified">Amestahili</option>
              <option value="converted">Amebadilika</option>
              <option value="rejected">Amekataliwa</option>
            </select>
          </div>
          <div>
            <label class="text-sm text-gray-600">Tarehe Kuanzia</label>
            <input type="date" id="filter-start-date" class="w-full mt-1 p-2 border border-gray-300 rounded-lg" onchange="filterLeads()">
          </div>
          <div class="flex items-end">
            <button onclick="clearFilters()" class="w-full px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
              <i class="fas fa-filter mr-2"></i>
              Safisha Filter
            </button>
          </div>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-6">
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Jumla ya Wateja</p>
              <h2 class="text-3xl font-bold text-gray-800 mt-1" id="total-leads">0</h2>
            </div>
            <div class="p-3 bg-blue-100 rounded-full">
              <i class="fas fa-users text-blue-600 text-2xl"></i>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Wapya</p>
              <h2 class="text-3xl font-bold text-blue-600 mt-1" id="new-leads">0</h2>
            </div>
            <div class="p-3 bg-blue-100 rounded-full">
              <i class="fas fa-user-plus text-blue-600 text-2xl"></i>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Wamepigiwa</p>
              <h2 class="text-3xl font-bold text-yellow-600 mt-1" id="contacted-leads">0</h2>
            </div>
            <div class="p-3 bg-yellow-100 rounded-full">
              <i class="fas fa-phone text-yellow-600 text-2xl"></i>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Wamestahili</p>
              <h2 class="text-3xl font-bold text-purple-600 mt-1" id="qualified-leads">0</h2>
            </div>
            <div class="p-3 bg-purple-100 rounded-full">
              <i class="fas fa-check text-purple-600 text-2xl"></i>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Converted</p>
              <h2 class="text-3xl font-bold text-green-600 mt-1" id="converted-leads">0</h2>
            </div>
            <div class="p-3 bg-green-100 rounded-full">
              <i class="fas fa-check-circle text-green-600 text-2xl"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Leads Table -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800">Orodha ya Wateja</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jina</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Simu</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kampeni</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hali</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarehe</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vitendo</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" id="leads-tbody">
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                  <div class="flex flex-col items-center">
                    <i class="fas fa-spinner fa-spin text-4xl mb-3 text-gray-300"></i>
                    <p>Inapakia wateja...</p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="p-4 border-t border-gray-200">
          <div class="flex items-center justify-between">
            <p class="text-sm text-gray-600">Inaonyesha <span id="showing-count">0</span> kati ya <span id="total-count">0</span></p>
            <div class="flex space-x-2" id="pagination">
              <!-- Pagination buttons -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lead Details Modal -->
    <div id="leadDetailsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <h3 class="text-xl font-bold text-gray-800">Taarifa za Mteja</h3>
            <button onclick="closeLeadDetailsModal()" class="text-gray-500 hover:text-gray-700">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>
        <div class="p-6">
          <div id="leadDetailsContent">
            <!-- Lead details will be loaded here -->
          </div>

          <!-- Update Status Section -->
          <div class="mt-6 pt-6 border-t border-gray-200">
            <h4 class="font-medium text-gray-800 mb-3">Badilisha Hali</h4>
            <form id="updateLeadStatusForm" onsubmit="updateLeadStatus(event)">
              <input type="hidden" id="lead-id" name="lead_id">
              <div class="space-y-3">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Hali Mpya</label>
                  <select name="status" id="lead-status" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                    <option value="new">Mpya</option>
                    <option value="contacted">Amepigiwa Simu</option>
                    <option value="qualified">Amestahili</option>
                    <option value="converted">Amebadilika</option>
                    <option value="rejected">Amekataliwa</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Maelezo</label>
                  <textarea name="notes" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg"></textarea>
                </div>
                <div class="flex justify-end space-x-3">
                  <button type="button" onclick="closeLeadDetailsModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Ghairi
                  </button>
                  <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark">
                    <i class="fas fa-save mr-2"></i>
                    Hifadhi
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script>
      let allLeads = [];
      let allCampaigns = [];
      let currentFilters = { campaign: '', status: '', startDate: '' };
      let currentCampaignId = null;

      // Check if campaign_id in URL
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('campaign_id')) {
        currentCampaignId = parseInt(urlParams.get('campaign_id'));
      }

      async function loadCampaigns() {
        try {
          const response = await fetch('/api/campaigns/my-campaigns');
          const data = await response.json();

          if (data.success) {
            allCampaigns = data.campaigns || [];
            populateCampaignFilter();

            if (currentCampaignId) {
              document.getElementById('filter-campaign').value = currentCampaignId;
            }
          }
        } catch (error) {
          console.error('Error loading campaigns:', error);
        }
      }

      function populateCampaignFilter() {
        const select = document.getElementById('filter-campaign');
        allCampaigns.forEach(campaign => {
          const option = document.createElement('option');
          option.value = campaign.id;
          option.textContent = campaign.campaign_name;
          select.appendChild(option);
        });
      }

      async function loadLeads() {
        try {
          const campaignId = currentCampaignId || document.getElementById('filter-campaign').value;

          if (!campaignId) {
            showError('Tafadhali chagua kampeni kwanza');
            return;
          }

          const response = await fetch(\`/api/campaigns/\${campaignId}/leads\`);
          const data = await response.json();

          if (data.success) {
            allLeads = data.leads || [];
            applyFilters();
            updateStats();
          } else {
            showError('Imeshindwa kupakia wateja');
          }
        } catch (error) {
          console.error('Error loading leads:', error);
          showError('Hitilafu imetokea wakati wa kupakia wateja');
        }
      }

      function updateStats() {
        const stats = {
          total: allLeads.length,
          new: allLeads.filter(l => l.lead_status === 'new').length,
          contacted: allLeads.filter(l => l.lead_status === 'contacted').length,
          qualified: allLeads.filter(l => l.lead_status === 'qualified').length,
          converted: allLeads.filter(l => l.lead_status === 'converted').length
        };

        document.getElementById('total-leads').textContent = stats.total;
        document.getElementById('new-leads').textContent = stats.new;
        document.getElementById('contacted-leads').textContent = stats.contacted;
        document.getElementById('qualified-leads').textContent = stats.qualified;
        document.getElementById('converted-leads').textContent = stats.converted;
      }

      function filterLeads() {
        const campaignId = document.getElementById('filter-campaign').value;

        if (campaignId && campaignId !== currentCampaignId) {
          currentCampaignId = campaignId;
          loadLeads();
          return;
        }

        currentFilters.status = document.getElementById('filter-status').value;
        currentFilters.startDate = document.getElementById('filter-start-date').value;
        applyFilters();
      }

      function clearFilters() {
        document.getElementById('filter-status').value = '';
        document.getElementById('filter-start-date').value = '';
        currentFilters = { campaign: '', status: '', startDate: '' };
        applyFilters();
      }

      function applyFilters() {
        let filtered = allLeads;

        if (currentFilters.status) {
          filtered = filtered.filter(l => l.lead_status === currentFilters.status);
        }

        if (currentFilters.startDate) {
          filtered = filtered.filter(l => new Date(l.created_at) >= new Date(currentFilters.startDate));
        }

        renderLeads(filtered);
      }

      function renderLeads(leads) {
        const tbody = document.getElementById('leads-tbody');
        const showingCount = document.getElementById('showing-count');
        const totalCount = document.getElementById('total-count');

        showingCount.textContent = leads.length;
        totalCount.textContent = allLeads.length;

        if (leads.length === 0) {
          tbody.innerHTML = \`
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                <i class="fas fa-users text-4xl mb-3 text-gray-300"></i>
                <p>Hakuna wateja bado</p>
              </td>
            </tr>
          \`;
          return;
        }

        tbody.innerHTML = leads.map(lead => {
          const leadData = typeof lead.lead_data === 'string' ? JSON.parse(lead.lead_data) : lead.lead_data;

          return \`
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4">
                <div class="font-medium text-gray-900">\${escapeHtml(lead.user_name || leadData?.full_name || 'N/A')}</div>
                <div class="text-sm text-gray-500">\${escapeHtml(leadData?.email || '')}</div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">\${escapeHtml(lead.user_phone || leadData?.phone || 'N/A')}</td>
              <td class="px-6 py-4 text-sm text-gray-900">\${escapeHtml(lead.campaign_name || 'N/A')}</td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs rounded-full \${getStatusBadge(lead.lead_status)}">
                  \${getStatusLabel(lead.lead_status)}
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">\${formatDate(lead.created_at)}</td>
              <td class="px-6 py-4 text-sm">
                <div class="flex space-x-2">
                  <button onclick="viewLeadDetails(\${lead.id})" class="text-blue-600 hover:text-blue-800" title="Angalia">
                    <i class="fas fa-eye"></i>
                  </button>
                  <button onclick="quickUpdateStatus(\${lead.id}, 'contacted')" class="text-green-600 hover:text-green-800" title="Piga Simu">
                    <i class="fas fa-phone"></i>
                  </button>
                  <button onclick="quickUpdateStatus(\${lead.id}, 'converted')" class="text-purple-600 hover:text-purple-800" title="Convert">
                    <i class="fas fa-check"></i>
                  </button>
                </div>
              </td>
            </tr>
          \`;
        }).join('');
      }

      function getStatusLabel(status) {
        const labels = {
          'new': 'Mpya',
          'contacted': 'Amepigiwa',
          'qualified': 'Amestahili',
          'converted': 'Converted',
          'rejected': 'Rejected'
        };
        return labels[status] || status;
      }

      function getStatusBadge(status) {
        const badges = {
          'new': 'bg-blue-100 text-blue-800',
          'contacted': 'bg-yellow-100 text-yellow-800',
          'qualified': 'bg-purple-100 text-purple-800',
          'converted': 'bg-green-100 text-green-800',
          'rejected': 'bg-red-100 text-red-800'
        };
        return badges[status] || 'bg-gray-100 text-gray-800';
      }

      function formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleDateString('sw-TZ', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      }

      function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      async function viewLeadDetails(leadId) {
        const lead = allLeads.find(l => l.id === leadId);
        if (!lead) return;

        const leadData = typeof lead.lead_data === 'string' ? JSON.parse(lead.lead_data) : lead.lead_data;

        let detailsHTML = \`
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-gray-500">Jina Kamili</p>
                <p class="font-medium">\${escapeHtml(lead.user_name || leadData?.full_name || 'N/A')}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Namba ya Simu</p>
                <p class="font-medium">\${escapeHtml(lead.user_phone || leadData?.phone || 'N/A')}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Barua Pepe</p>
                <p class="font-medium">\${escapeHtml(leadData?.email || 'N/A')}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Kampeni</p>
                <p class="font-medium">\${escapeHtml(lead.campaign_name || 'N/A')}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Hali</p>
                <p class="font-medium">\${getStatusLabel(lead.lead_status)}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Tarehe</p>
                <p class="font-medium">\${formatDate(lead.created_at)}</p>
              </div>
            </div>
        \`;

        // Show all form data
        if (leadData && typeof leadData === 'object') {
          detailsHTML += \`
            <div class="border-t border-gray-200 pt-4">
              <h4 class="font-medium text-gray-800 mb-3">Taarifa za Fomu</h4>
              <div class="grid grid-cols-1 gap-2">
          \`;

          for (const [key, value] of Object.entries(leadData)) {
            if (!['full_name', 'phone', 'email'].includes(key)) {
              detailsHTML += \`
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-sm text-gray-600">\${key}:</span>
                  <span class="text-sm font-medium text-gray-900">\${escapeHtml(value)}</span>
                </div>
              \`;
            }
          }

          detailsHTML += \`
              </div>
            </div>
          \`;
        }

        detailsHTML += '</div>';

        document.getElementById('leadDetailsContent').innerHTML = detailsHTML;
        document.getElementById('lead-id').value = leadId;
        document.getElementById('lead-status').value = lead.lead_status;
        document.getElementById('leadDetailsModal').classList.remove('hidden');
      }

      function closeLeadDetailsModal() {
        document.getElementById('leadDetailsModal').classList.add('hidden');
      }

      async function updateLeadStatus(event) {
        event.preventDefault();
        const formData = new FormData(event.target);
        const leadId = formData.get('lead_id');
        const status = formData.get('status');
        const notes = formData.get('notes');

        try {
          const response = await fetch(\`/api/campaigns/leads/\${leadId}/status\`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status, notes })
          });

          const data = await response.json();

          if (data.success) {
            showSuccess('Hali imebadilishwa kikamilifu');
            closeLeadDetailsModal();
            loadLeads();
          } else {
            showError(data.error || 'Imeshindwa kubadilisha hali');
          }
        } catch (error) {
          console.error('Error updating lead status:', error);
          showError('Hitilafu imetokea');
        }
      }

      async function quickUpdateStatus(leadId, status) {
        try {
          const response = await fetch(\`/api/campaigns/leads/\${leadId}/status\`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });

          const data = await response.json();

          if (data.success) {
            showSuccess('Hali imebadilishwa');
            loadLeads();
          } else {
            showError(data.error || 'Imeshindwa kubadilisha hali');
          }
        } catch (error) {
          console.error('Error updating lead status:', error);
          showError('Hitilafu imetokea');
        }
      }

      async function exportLeads() {
        const campaignId = currentCampaignId || document.getElementById('filter-campaign').value;

        if (!campaignId) {
          showError('Tafadhali chagua kampeni kwanza');
          return;
        }

        window.open(\`/api/campaigns/\${campaignId}/leads/export\`, '_blank');
      }

      function showSuccess(message) {
        alert(message);
      }

      function showError(message) {
        alert(message);
      }

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', () => {
        loadCampaigns();

        // Auto-load leads if campaign is selected
        if (currentCampaignId) {
          setTimeout(() => loadLeads(), 500);
        }
      });
    </script>
  `;
%>

<%- include('layout', {
    title: 'Wateja Wapya',
    activePage: 'leads',
    body: leadsContent
}) %>
