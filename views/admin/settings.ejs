<%- include('layout', {
    title: 'Mipangilio',
    activePage: 'settings',
    body: `
    <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-6">Mipangilio ya Akaunti</h2>
        <div id="settings-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <div class="mb-4">
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Jina Kamili</label>
                        <input type="text" name="name" id="name" value="Admin User" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                    </div>
                    <div class="mb-4">
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Barua Pepe</label>
                        <input type="email" name="email" id="email" value="admin@hotbando.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                    </div>
                    <div class="mb-4">
                        <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Jina la Kampuni</label>
                        <input type="text" name="company" id="company" value="HotBando Ltd" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                    </div>
                </div>
                <div>
                    <div class="mb-4">
                        <label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">Neno Siri la Sasa</label>
                        <div class="relative">
                            <input type="password" name="current_password" id="current_password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">Neno Siri Jipya</label>
                        <div class="relative">
                            <input type="password" name="new_password" id="new_password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">Thibitisha Neno Siri Jipya</label>
                        <div class="relative">
                            <input type="password" name="confirm_password" id="confirm_password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-6">
                <button type="submit" onclick="document.getElementById('settings-form').dispatchEvent(new Event('submit'))" class="w-full bg-primary hover:bg-primary-dark text-white font-medium py-3 px-4 rounded-lg transition">
                    Hifadhi Mabadiliko
                </button>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.password-toggle').forEach(toggle => {
                toggle.addEventListener('click', function() {
                    const passwordInput = this.parentElement.querySelector('input');
                    const icon = this.querySelector('i');
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    } else {
                        passwordInput.type = 'password';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    }
                });
            });
            document.getElementById('settings-form').addEventListener('submit', function(e) {
                e.preventDefault();
                alert('Mipangilio imehifadhiwa!');
            });
        });
    </script>
    `
}) %>