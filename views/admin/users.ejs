                            '<div class="font-semibold text-gray-800">2 siku 3 masaa</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        window.suspendCurrentUser = function() {
            if (currentUserId) {
                showSuspendModal(currentUserId, 'mtumiaji huyu');
            }
        };
    });
</script>
`;
