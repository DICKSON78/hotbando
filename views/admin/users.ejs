<%
const usersContent = `
<div class="bg-white rounded-lg shadow-sm p-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-6">Usimamizi wa Watumiaji na Routers</h2>
    
    <!-- Tabs Navigation -->
    <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex space-x-8">
            <button id="users-tab" class="tab-button active py-4 px-1 border-b-2 border-primary font-medium text-sm text-primary">
                Watumiaji Wote
            </button>
            <button id="online-tab" class="tab-button py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">
                Watumiaji Wenye Mtandao
            </button>
            <button id="routers-tab" class="tab-button py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">
                Routers Zilizo Online
            </button>
        </nav>
    </div>

    <!-- Search Input -->
    <div class="mb-4">
        <input type="text" id="search" placeholder="Tafuta..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-secondary-light text-gray-800">
    </div>

    <!-- Tab Content - Watumiaji Wote -->
    <div id="users-content" class="tab-content active">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead>
                    <tr class="bg-secondary-light">
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jina</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Namba ya Simu</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Muda Ulobaki</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data Bure (MB)</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Eneo</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarehe</th>
                        <th scope="col" class="relative px-6 py-3">
                            <span class="sr-only">Vitendo</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="users-table">
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-gray-500">Inapakia watumiaji...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex justify-between items-center">
            <div class="text-sm text-gray-500" id="users-pagination-info">
                Inapakia...
            </div>
            <div class="flex space-x-2" id="users-pagination">
                <!-- Pagination buttons will be inserted here -->
            </div>
        </div>
    </div>

    <!-- Tab Content - Watumiaji Wenye Mtandao -->
    <div id="online-content" class="tab-content hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead>
                    <tr class="bg-secondary-light">
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jina</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Namba ya Simu</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">MAC Address</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Router</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Muda Ulobaki</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Eneo</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Muda Ulopita</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="online-table">
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-gray-500">Inapakia watumiaji walio online...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="mt-4 text-sm text-gray-500" id="online-count">
            Inapakia...
        </div>
    </div>

    <!-- Tab Content - Routers Zilizo Online -->
    <div id="routers-content" class="tab-content hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead>
                    <tr class="bg-secondary-light">
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jina la Router</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Eneo</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SSID</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Watumiaji Wanaoongo</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Muda wa Mwisho</th>
                        <th scope="col" class="relative px-6 py-3">
                            <span class="sr-only">Vitendo</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="routers-table">
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-gray-500">Inapakia routers...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentPage = 1;
        const limit = 50;

        // Tab switching functionality
        const tabs = {
            'users-tab': 'users-content',
            'online-tab': 'online-content',
            'routers-tab': 'routers-content'
        };

        Object.keys(tabs).forEach(tabId => {
            document.getElementById(tabId).addEventListener('click', function() {
                // Remove active class from all tabs and contents
                Object.keys(tabs).forEach(key => {
                    document.getElementById(key).classList.remove('active', 'border-primary', 'text-primary');
                    document.getElementById(key).classList.add('border-transparent', 'text-gray-500');
                    document.getElementById(tabs[key]).classList.add('hidden');
                    document.getElementById(tabs[key]).classList.remove('active');
                });

                // Add active class to current tab and content
                this.classList.add('active', 'border-primary', 'text-primary');
                this.classList.remove('border-transparent', 'text-gray-500');
                document.getElementById(tabs[tabId]).classList.remove('hidden');
                document.getElementById(tabs[tabId]).classList.add('active');

                // Load data for the active tab
                if (tabId === 'users-tab') {
                    loadUsers(currentPage, '');
                } else if (tabId === 'online-tab') {
                    loadOnlineUsers();
                } else if (tabId === 'routers-tab') {
                    loadRouters();
                }
            });
        });

        // Load initial data
        loadUsers(currentPage, '');
        loadOnlineUsers();
        loadRouters();

        // Search functionality
        const searchInput = document.getElementById('search');
        let searchTimeout;
        
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value;
            searchTimeout = setTimeout(() => {
                if (document.getElementById('users-content').classList.contains('active')) {
                    currentPage = 1;
                    loadUsers(currentPage, query);
                }
            }, 500);
        });

        // Load users function
        function loadUsers(page, searchQuery = '') {
            fetch(\`/api/admin/customers?page=\${page}&limit=\${limit}&search=\${encodeURIComponent(searchQuery)}\`)
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        console.error('Failed to load users:', data.message);
                        return;
                    }

                    const tableBody = document.getElementById('users-table');
                    tableBody.innerHTML = '';

                    if (data.data.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Hakuna watumiaji waliopatikana</td></tr>';
                        return;
                    }

                    data.data.forEach(user => {
                        const now = new Date();
                        const usageUntil = new Date(user.usage_until);
                        const isActive = usageUntil > now;
                        const remainingSeconds = isActive ? Math.max(0, (usageUntil - now) / 1000) : 0;
                        
                        const remainingTime = formatRemainingTime(remainingSeconds);
                        const freeMB = Math.round(user.free_bytes / (1024 * 1024));

                        const row = document.createElement('tr');
                        row.innerHTML = \`
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">\${user.name || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${user.phone_number || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm \${isActive ? 'text-green-600' : 'text-red-600'}">\${remainingTime}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${freeMB} MB</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${user.location || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${new Date(user.created_at).toLocaleDateString('sw-TZ')}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button onclick="suspendUser(\${user.id})" class="text-yellow-600 hover:text-yellow-900 mr-3">Zima</button>
                                <button onclick="deleteUser(\${user.id})" class="text-red-600 hover:text-red-900">Futa</button>
                            </td>
                        \`;
                        tableBody.appendChild(row);
                    });

                    // Update pagination
                    updatePagination(data.pagination, page, searchQuery);
                })
                .catch(error => console.error('Users fetch error:', error));
        }

        // Load online users function
        function loadOnlineUsers() {
            fetch('/api/admin/online-customers')
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        console.error('Failed to load online users:', data.message);
                        return;
                    }

                    const tableBody = document.getElementById('online-table');
                    const countElement = document.getElementById('online-count');
                    
                    tableBody.innerHTML = '';

                    if (data.data.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Hakuna watumiaji walio online kwa sasa</td></tr>';
                        countElement.textContent = 'Hakuna watumiaji walio online';
                        return;
                    }

                    data.data.forEach(user => {
                        const now = new Date();
                        const usageUntil = new Date(user.usage_until);
                        const remainingSeconds = Math.max(0, (usageUntil - now) / 1000);
                        const remainingTime = formatRemainingTime(remainingSeconds);
                        const minutesAgo = user.minutes_ago || 0;

                        const row = document.createElement('tr');
                        row.innerHTML = \`
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">\${user.name || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${user.phone_number || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">\${user.mac_address || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${user.last_router_id || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-green-600">\${remainingTime}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${user.location || 'N/A'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${minutesAgo} dakika zilizopita</td>
                        \`;
                        tableBody.appendChild(row);
                    });

                    countElement.textContent = \`Jumla: \${data.count} watumiaji walio online\`;
                })
                .catch(error => console.error('Online users fetch error:', error));
        }

        // Load routers function
        function loadRouters() {
            fetch('/api/admin/routers')
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        console.error('Failed to load routers:', data.message);
                        return;
                    }

                    const tableBody = document.getElementById('routers-table');
                    tableBody.innerHTML = '';

                    if (data.data.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Hakuna routers zilizopatikana</td></tr>';
                        return;
                    }

                    // Get online users count for each router
                    Promise.all(data.data.map(router => 
                        fetch(\`/api/admin/router-sessions/\${router.router_id}\`)
                            .then(res => res.json())
                            .then(sessionData => ({
                                router,
                                onlineCount: sessionData.success ? sessionData.count : 0
                            }))
                            .catch(() => ({
                                router,
                                onlineCount: 0
                            }))
                    )).then(results => {
                        results.forEach(({router, onlineCount}) => {
                            const statusClass = router.status === 'online' ? 'text-green-600' : 
                                              router.status === 'offline' ? 'text-red-600' : 'text-yellow-600';
                            
                            const statusText = router.status === 'online' ? 'Online' :
                                              router.status === 'offline' ? 'Offline' : 'Maintenance';

                            const row = document.createElement('tr');
                            row.innerHTML = \`
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">\${router.router_name}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${router.location}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${router.ssid || 'N/A'}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm \${statusClass}">\${statusText}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${onlineCount} watumiaji</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">\${router.last_seen ? new Date(router.last_seen).toLocaleString('sw-TZ') : 'Hajajua'}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button onclick="rebootRouter('\${router.router_id}')" class="text-blue-600 hover:text-blue-900 mr-3">Reboot</button>
                                    <button onclick="editRouter(\${router.id})" class="text-primary hover:text-primary-dark">Hariri</button>
                                </td>
                            \`;
                            tableBody.appendChild(row);
                        });
                    });
                })
                .catch(error => console.error('Routers fetch error:', error));
        }

        // Pagination function
        function updatePagination(pagination, currentPage, searchQuery) {
            const paginationElement = document.getElementById('users-pagination');
            const infoElement = document.getElementById('users-pagination-info');
            
            if (!pagination || pagination.pages <= 1) {
                paginationElement.innerHTML = '';
                infoElement.textContent = \`Jumla: \${pagination?.total || 0} watumiaji\`;
                return;
            }

            infoElement.textContent = \`Onyesho \${((currentPage - 1) * limit) + 1}-\${Math.min(currentPage * limit, pagination.total)} ya \${pagination.total} watumiaji\`;

            let paginationHTML = '';

            // Previous button
            if (currentPage > 1) {
                paginationHTML += \`<button onclick="changePage(\${currentPage - 1}, '\${searchQuery}')" class="px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-500 hover:bg-gray-50">Nyuma</button>\`;
            }

            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(pagination.pages, currentPage + 2);

            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    paginationHTML += \`<button class="px-3 py-2 border border-primary bg-primary text-white rounded-md text-sm font-medium">\${i}</button>\`;
                } else {
                    paginationHTML += \`<button onclick="changePage(\${i}, '\${searchQuery}')" class="px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-500 hover:bg-gray-50">\${i}</button>\`;
                }
            }

            // Next button
            if (currentPage < pagination.pages) {
                paginationHTML += \`<button onclick="changePage(\${currentPage + 1}, '\${searchQuery}')" class="px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-500 hover:bg-gray-50">Mbele</button>\`;
            }

            paginationElement.innerHTML = paginationHTML;
        }

        // Format remaining time function
        window.formatRemainingTime = function(seconds) {
            if (seconds <= 0) return 'Hakuna muda';
            
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            
            if (days > 0) return \`\${days}s \${hours}h\`;
            if (hours > 0) return \`\${hours}h \${minutes}m\`;
            if (minutes > 0) return \`\${minutes} dakika\`;
            return 'Dakika chache';
        };

        // Page change function
        window.changePage = function(page, searchQuery) {
            currentPage = page;
            loadUsers(page, searchQuery);
        };

        // Action functions
        window.suspendUser = function(userId) {
            if (confirm('Una uhakika unataka kumzima mtumiaji huyu?')) {
                fetch(\`/api/admin/suspend-customer/\${userId}\`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        reason: 'Suspended by admin',
                        is_permanent: 0
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Mtumiaji amezimwa kikamilifu');
                        loadUsers(currentPage, document.getElementById('search').value);
                    } else {
                        alert('Hitilafu: ' + (data.message || 'Imeshindikana kumzima mtumiaji'));
                    }
                })
                .catch(error => console.error('Suspend user error:', error));
            }
        };

        window.deleteUser = function(userId) {
            if (confirm('Una uhakika unataka kumfuta mtumiaji huyu kabisa?')) {
                fetch(\`/api/admin/delete-customer/\${userId}\`, {
                    method: 'DELETE'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Mtumiaji amefutwa kikamilifu');
                        loadUsers(currentPage, document.getElementById('search').value);
                    } else {
                        alert('Hitilafu: ' + (data.message || 'Imeshindikana kumfuta mtumiaji'));
                    }
                })
                .catch(error => console.error('Delete user error:', error));
            }
        };

        window.rebootRouter = function(routerId) {
            if (confirm('Una uhakika unataka kureboot router hii?')) {
                fetch(\`/api/admin/reboot-router/\${routerId}\`, {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Router imereboot kikamilifu');
                        loadRouters();
                    } else {
                        alert('Hitilafu: ' + (data.message || 'Imeshindikana kureboot router'));
                    }
                })
                .catch(error => console.error('Reboot router error:', error));
            }
        };

        window.editRouter = function(routerId) {
            // Implement router edit functionality
            alert('Hariri router: ' + routerId);
        };
    });
</script>

<style>
.tab-content {
    display: none;
}
.tab-content.active {
    display: block;
}
</style>
`;
%>

<%- include('layout', {
    title: 'Watumiaji & Routers',
    activePage: 'users',
    body: usersContent
}) %>