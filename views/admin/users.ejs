        // Pagination function
        function updatePagination(pagination, currentPage, searchQuery) {
            const paginationElement = document.getElementById('users-pagination');
            const infoElement = document.getElementById('users-pagination-info');
            
            if (!pagination || pagination.pages <= 1) {
                paginationElement.innerHTML = '';
                infoElement.textContent = 'Jumla: ' + (pagination?.total || 0) + ' watumiaji';
                return;
            }

            infoElement.textContent = 'Onyesho ' + (((currentPage - 1) * limit) + 1) + '-' + Math.min(currentPage * limit, pagination.total) + ' ya ' + pagination.total + ' watumiaji';

            let paginationHTML = '';

            // Previous button
            if (currentPage > 1) {
                paginationHTML += '<button onclick="changePage(' + (currentPage - 1) + ', \\'' + searchQuery + '\\')" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-all duration-300 hover:shadow-sm">' +
                    '<i class="fas fa-chevron-left mr-1"></i>Nyuma' +
                '</button>';
            }

            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(pagination.pages, currentPage + 2);

            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    paginationHTML += '<button class="px-4 py-2 border border-primary bg-primary text-white rounded-lg text-sm font-medium shadow-sm">' + i + '</button>';
                } else {
                    paginationHTML += '<button onclick="changePage(' + i + ', \\'' + searchQuery + '\\')" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-all duration-300 hover:shadow-sm">' + i + '</button>';
                }
            }

            // Next button
            if (currentPage < pagination.pages) {
                paginationHTML += '<button onclick="changePage(' + (currentPage + 1) + ', \\'' + searchQuery + '\\')" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-all duration-300 hover:shadow-sm">' +
                    'Mbele<i class="fas fa-chevron-right ml-1"></i>' +
                '</button>';
            }

            paginationElement.innerHTML = paginationHTML;
        }

        // Format remaining time function
        window.formatRemainingTime = function(seconds) {
            if (seconds <= 0) return 'Hakuna muda';
            
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            
            if (days > 0) return days + 's ' + hours + 'h';
            if (hours > 0) return hours + 'h ' + minutes + 'm';
            if (minutes > 0) return minutes + ' dakika';
            return 'Dakika chache';
        };

