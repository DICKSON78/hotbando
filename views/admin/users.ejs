</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentPage = 1;
        const limit = 50;
        let currentUserId = null;
        let currentRouterId = null;

        // Tab switching functionality
        const tabs = {
            'users-tab': 'users-content',
            'online-tab': 'online-content',
            'routers-tab': 'routers-content'
        };

        Object.keys(tabs).forEach(tabId => {
            document.getElementById(tabId).addEventListener('click', function() {
                // Remove active class from all tabs and contents
                Object.keys(tabs).forEach(key => {
                    document.getElementById(key).classList.remove('active', 'border-primary', 'text-primary');
                    document.getElementById(key).classList.add('border-transparent', 'text-gray-500');
                    document.getElementById(tabs[key]).classList.add('hidden');
                    document.getElementById(tabs[key]).classList.remove('active');
                });

                // Add active class to current tab and content
                this.classList.add('active', 'border-primary', 'text-primary');
                this.classList.remove('border-transparent', 'text-gray-500');
                document.getElementById(tabs[tabId]).classList.remove('hidden');
                document.getElementById(tabs[tabId]).classList.add('active');

                // Load data for the active tab
                if (tabId === 'users-tab') {
                    loadUsers(currentPage, '');
                } else if (tabId === 'online-tab') {
                    loadOnlineUsers();
                } else if (tabId === 'routers-tab') {
                    loadRouters();
                }
            });
        });

        // Load initial data
        loadUsers(currentPage, '');
        loadOnlineUsers();
        loadRouters();
        loadDashboardStats();

        // Search functionality
        const searchInput = document.getElementById('search');
        let searchTimeout;
        
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value;
            searchTimeout = setTimeout(() => {
                if (document.getElementById('users-content').classList.contains('active')) {
                    currentPage = 1;
                    loadUsers(currentPage, query);
                }
            }, 500);
        });

        // Filter functionality
