              </div>
            </div>

            <!-- Step 7: Verify -->
            <div class="step-content" id="step-7">
              <h2>✅ Hatua ya 7: Test & Verify</h2>
              <p>Thibitisha kila kitu kinafanya kazi</p>
              
              <div id="verify-checklist">
                <ul class="checklist">
                  <li id="check-hotspot">
                    <span class="check pending"><i class="fas fa-circle"></i></span>
                    <span>Hotspot Server</span>
                    <span class="ml-auto text-gray-400" id="check-hotspot-status">Inasubiri...</span>
                  </li>
                  <li id="check-dhcp">
                    <span class="check pending"><i class="fas fa-circle"></i></span>
                    <span>DHCP Server</span>
                    <span class="ml-auto text-gray-400" id="check-dhcp-status">Inasubiri...</span>
                  </li>
                  <li id="check-radius">
                    <span class="check pending"><i class="fas fa-circle"></i></span>
                    <span>RADIUS Server</span>
                    <span class="ml-auto text-gray-400" id="check-radius-status">Inasubiri...</span>
                  </li>
                  <li id="check-location">
                    <span class="check pending"><i class="fas fa-circle"></i></span>
                    <span>Eneo/Location</span>
                    <span class="ml-auto text-gray-400" id="check-location-status">Inasubiri...</span>
                  </li>
                  <li id="check-wifi">
                    <span class="check pending"><i class="fas fa-circle"></i></span>
                    <span>WiFi SSID</span>
                    <span class="ml-auto text-gray-400" id="check-wifi-status">Inasubiri...</span>
                  </li>
                </ul>
              </div>

              <div id="verify-result" class="hidden mt-6">
                <div class="instruction-box success">
                  <h3>🎉 Ukamilifu!</h3>
                  <p>Router iko tayari kwa matumizi!</p>
                  <ul>
                    <li>WiFi SSID: <strong id="final-ssid">HotBando-Free-WiFi</strong></li>
                    <li>Hotspot IP: <strong id="final-hotspot-ip">10.5.50.1</strong></li>
                    <li>Eneo: <strong id="final-location">-</strong></li>
                    <li>Login: <strong>admin / \${hotspotAdminPwd}</strong></li>
                  </ul>
                </div>
              </div>

              <div class="btn-group">
                <button class="btn btn-secondary" onclick="prevStep()">
                  <i class="fas fa-arrow-left"></i>
                  Rudi
                </button>
                <button class="btn btn-success" onclick="executeStep(7)" id="btn-step7">
                  <i class="fas fa-check"></i>
                  Thibitisha
                </button>
                <button class="btn btn-primary hidden" id="btn-finish" onclick="finishSetup()">
                  <i class="fas fa-flag-checkered"></i>
                  Maliza Setup
                </button>
              </div>
            </div>
          </div>

          <!-- Close button -->
          <button onclick="closeWizard()" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white hover:bg-white/30">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>

      <!-- Quick Setup Modal -->
      <div id="quick-setup-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 max-h-[90vh] overflow-y-auto">
          <h2 class="text-xl font-bold mb-4">⚡ Quick Setup</h2>
          <p class="text-gray-600 mb-6">Weka taarifa chache na system itaconfigure yote automatically!</p>
          
          <div class="config-form">
            <div class="form-group">
              <label>Router IP Address</label>
              <input type="text" id="quick-router-ip" placeholder="mfano: 192.168.88.1">
              <span class="hint">IP ya MikroTik iliyochomeka</span>
            </div>
            <div class="form-group">
              <label>Server IP (IP ya HotBando server)</label>
              <input type="text" id="quick-server-ip" placeholder="mfano: 103.50.200.1">
            </div>
            <div class="form-group">
              <label>WiFi SSID</label>
              <input type="text" id="quick-ssid" value="HotBando-Free-WiFi">
            </div>
            
            <!-- Quick Location -->
            <div class="instruction-box" style="background: #f0fdf4; border-color: #86efac;">
              <h3>📍 Eneo la Router</h3>
              <div class="form-group mt-2">
                <label>Jina la Eneo</label>
                <input type="text" id="quick-location-name" placeholder="mfano: Mwanza Town">
              </div>
              <div class="form-row mt-2">
                <div class="form-group">
                  <label>Latitude</label>
                  <input type="text" id="quick-latitude" placeholder="-2.5164">
                </div>
                <div class="form-group">
                  <label>Longitude</label>
                  <input type="text" id="quick-longitude" placeholder="32.9175">
                </div>
              </div>
              <button type="button" class="gps-btn mt-3" onclick="getGPSLocationQuick()" id="gps-btn-quick">
                <i class="fas fa-crosshairs"></i>
                Pata GPS
              </button>
            </div>
          </div>

          <div class="btn-group">
            <button class="btn btn-secondary" onclick="closeQuickSetup()">Ghairi</button>
            <button class="btn btn-primary" onclick="executeQuickSetup()">
              <i class="fas fa-bolt"></i>
              Anza Quick Setup
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Leaflet CSS & JS for Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
      let currentStep = 1;
      let currentRouterID = null;
      let setupConfig = {};
      let map = null;
      let markers = [];

      // Load detected routers on page load
      document.addEventListener('DOMContentLoaded', () => {
        loadDetectedRouters();
        loadMap();
        // Auto-refresh every 10 seconds
        setInterval(loadDetectedRouters, 10000);
      });

      async function loadDetectedRouters() {
        try {
          const response = await fetch('/api/routers');
          const data = await response.json();
          
          const routerList = document.getElementById('router-list');
          
          if (!data.success || !data.data || data.data.length === 0) {
            routerList.innerHTML = \`
              <div class="text-center py-12">
                <i class="fas fa-satellite-dish text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-600 mb-2">Hakuna Routers Zilizopatikana</h3>
                <p class="text-gray-500 mb-4">Chomeka MikroTik na ui-connect kwenye network</p>
                <p class="text-sm text-gray-400">Router itaji-register automatically pale inapofungua</p>
              </div>
            \`;
            return;
          }

          const routers = data.data;
          let html = '';
          
          for (const router of routers) {
            const statusClass = router.status === 'online' ? 'online' : 'offline';
            const setupStatus = router.setup_status || 'pending';
            const statusLabel = setupStatus === 'configured' ? '✅ Imekamilika' : 
                               setupStatus === 'configuring' ? '⚙️ Inaconfigure...' :
                               setupStatus === 'failed' ? '❌ Imeshindwa' : '⏳ Inasubiri Setup';
            const locationInfo = router.location_name ? \`📍 \${router.location_name}\` : '📍 Eneo halijajwa';
            
            html += \`
              <div class="detected-router" onclick="openWizard('\${router.router_id}')">
                <div class="router-icon">📡</div>
                <div class="router-details">
                  <h4>\${router.router_name || router.router_id}</h4>
                  <p>
                    <span class="status-indicator \${statusClass}">
                      <span class="dot \${router.status === 'online' ? 'pulse' : ''}"></span>
                      \${router.status === 'online' ? 'Online' : 'Offline'}
                    </span>
                    <span class="ml-2 text-sm">IP: \${router.host}</span>
                    <span class="ml-2 text-sm">Model: \${router.model || 'Unknown'}</span>
                  </p>
                  <p class="text-sm mt-1">
                    <span class="badge badge-\${setupStatus === 'configured' ? 'success' : setupStatus === 'failed' ? 'danger' : 'warning'}">
                      \${statusLabel}
                    </span>
                    <span class="ml-2 text-sm text-gray-500">\${locationInfo}</span>
                  </p>
                </div>
                <div class="router-actions">
                  \${setupStatus !== 'configured' ? 
                    \`<button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); openWizard('\${router.router_id}')">
                      <i class="fas fa-cog mr-1"></i> Configure
                    </button>\` : 
                    \`
                    <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); editLocation('\${router.router_id}')">
                      <i class="fas fa-map-marker-alt mr-1"></i> Eneo
                    </button>
                    <button class="btn btn-success btn-sm" onclick="event.stopPropagation(); viewRouter('\${router.router_id}')">
                      <i class="fas fa-eye mr-1"></i> View
                    </button>
                    \`
                  }
                </div>
              </div>
            \`;
          }
          
          routerList.innerHTML = html;
        } catch (error) {
          console.error('Error loading routers:', error);
          document.getElementById('router-list').innerHTML = \`
            <div class="text-center py-8 text-red-500">
              <i class="fas fa-exclamation-circle text-4xl mb-4"></i>
              <p>Hitilafu imetokea kupata routers</p>
            </div>
          \`;
        }
      }

      function openWizard(routerID) {
        currentRouterID = routerID;
        currentStep = 1;
        document.getElementById('wizard-modal').classList.remove('hidden');
        document.getElementById('wizard-modal').classList.add('flex');
        updateStepUI();
        
        // Pre-fill router ID
        document.getElementById('cfg-router-id').value = routerID;
        document.getElementById('cfg-router-name').value = routerID;
      }

      function closeWizard() {
        document.getElementById('wizard-modal').classList.add('hidden');
        document.getElementById('wizard-modal').classList.remove('flex');
        loadDetectedRouters();
        loadMap();
      }

      function showQuickSetup() {
        document.getElementById('quick-setup-modal').classList.remove('hidden');
        document.getElementById('quick-setup-modal').classList.add('flex');
      }

      function closeQuickSetup() {
        document.getElementById('quick-setup-modal').classList.add('hidden');
        document.getElementById('quick-setup-modal').classList.remove('flex');
      }

      function updateStepUI() {
        // Update step circles
        for (let i = 1; i <= 7; i++) {
          const circle = document.getElementById('step-circle-' + i);
          if (circle) {
            circle.classList.remove('active', 'completed');
            if (i < currentStep) {
              circle.classList.add('completed');
              circle.innerHTML = '<i class="fas fa-check"></i>';
            } else if (i === currentStep) {
              circle.classList.add('active');
              circle.innerHTML = i;
            } else {
              circle.innerHTML = i;
            }
          }
        }

        // Update step content
        document.querySelectorAll('.step-content').forEach((el, idx) => {
          el.classList.remove('active');
          if (idx + 1 === currentStep) {
            el.classList.add('active');
          }
        });
      }

      function prevStep() {
        if (currentStep > 1) {
          currentStep--;
          updateStepUI();
        }
      }

      async function executeStep(step) {
        const btn = document.getElementById('btn-step' + step);
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = '<div class="spinner"></div> Inafanya...';
        }

        let body = {};

        switch(step) {
          case 1:
            body = {
              host: document.getElementById('cfg-router-host').value,
              user: document.getElementById('cfg-router-user').value,
              password: document.getElementById('cfg-router-pass').value,
              routerName: document.getElementById('cfg-router-name').value,
              ssid: 'HotBando-Free-WiFi'
            };
            break;
          case 3:
            body = {
              serverIP: document.getElementById('cfg-server-ip').value,
              radiusSecret: document.getElementById('cfg-radius-secret').value,
              hotspotInterface: document.getElementById('cfg-interface').value,
              hotspotIP: document.getElementById('cfg-hotspot-ip').value,
              ssid: document.getElementById('cfg-ssid').value
            };
            break;
          case 5:
            body = {
              latitude: document.getElementById('cfg-latitude').value,
              longitude: document.getElementById('cfg-longitude').value,
              locationName: document.getElementById('cfg-location-name').value,
              locationAddress: document.getElementById('cfg-location-address').value,
              locationCity: document.getElementById('cfg-location-city').value,
              locationRegion: document.getElementById('cfg-location-region').value,
              locationType: document.getElementById('cfg-location-type').value
            };
            break;
        }

        try {
          const response = await fetch(\`/api/setup-wizard/execute/\${currentRouterID}/\${step}\`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          
          const result = await response.json();
          
          if (result.success) {
            currentStep = step + 1;
            updateStepUI();
            
            if (step === 7) {
              document.getElementById('btn-finish').classList.remove('hidden');
              document.getElementById('verify-result').classList.remove('hidden');
              // Show location in final result
              const locName = document.getElementById('cfg-location-name').value || '-';
              document.getElementById('final-location').textContent = locName;
            }
          } else {
            alert('Hitilafu: ' + result.message);
          }
        } catch (error) {
          alert('Hitilafu: ' + error.message);
        } finally {
          if (btn) {
            btn.disabled = false;
            if (step === 3) btn.innerHTML = '<i class="fas fa-cog"></i> Configure Sasa';
            else if (step === 5) btn.innerHTML = '<i class="fas fa-save"></i> Hifadhi Eneo';
            else if (step === 7) btn.innerHTML = '<i class="fas fa-check"></i> Thibitisha';
            else btn.innerHTML = '<i class="fas fa-play"></i> Endelea';
          }
        }
      }

      // GPS Location Functions
      function getGPSLocation() {
        const btn = document.getElementById('gps-btn');
        btn.disabled = true;
        btn.innerHTML = '<div class="spinner"></div> Inapata GPS...';
        btn.classList.add('loading');

        if (!navigator.geolocation) {
          alert('Browser yako haioni GPS');
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-crosshairs"></i> Pata GPS Location Sasa';
          btn.classList.remove('loading');
          return;
        }

        navigator.geolocation.getCurrentPosition(
          (position) => {
            const lat = position.coords.latitude.toFixed(6);
            const lng = position.coords.longitude.toFixed(6);
            
            document.getElementById('cfg-latitude').value = lat;
            document.getElementById('cfg-longitude').value = lng;
            
            document.getElementById('gps-coords').textContent = \`Lat: \${lat}, Lng: \${lng}\`;
            document.getElementById('location-preview').classList.add('active');
            
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check"></i> GPS Imepatikana!';
            btn.classList.remove('loading');
            
            // Try to reverse geocode
            reverseGeocode(lat, lng);
          },
          (error) => {
            alert('Hitilafu ya GPS: ' + error.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs"></i> Pata GPS Location Sasa';
            btn.classList.remove('loading');
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      }

      function getGPSLocationQuick() {
        const btn = document.getElementById('gps-btn-quick');
        btn.disabled = true;
        btn.innerHTML = '<div class="spinner"></div>';

        if (!navigator.geolocation) {
          alert('Browser yako haioni GPS');
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-crosshairs"></i> Pata GPS';
          return;
        }

        navigator.geolocation.getCurrentPosition(
          (position) => {
            document.getElementById('quick-latitude').value = position.coords.latitude.toFixed(6);
            document.getElementById('quick-longitude').value = position.coords.longitude.toFixed(6);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check"></i> Done!';
          },
          (error) => {
            alert('Hitilafu ya GPS: ' + error.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs"></i> Pata GPS';
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      }

      async function reverseGeocode(lat, lng) {
        try {
          const response = await fetch(\`https://nominatim.openstreetmap.org/reverse?format=json&lat=\${lat}&lon=\${lng}\`);
          const data = await response.json();
          
          if (data.address) {
            const addr = data.address;
            if (addr.city || addr.town || addr.village) {
              document.getElementById('cfg-location-city').value = addr.city || addr.town || addr.village;
            }
            if (addr.state || addr.region) {
              document.getElementById('cfg-location-region').value = addr.state || addr.region;
            }
            if (addr.road) {
              document.getElementById('cfg-location-address').value = addr.road;
            }
          }
        } catch (e) {
          // Reverse geocode failed, user can enter manually
        }
      }

      // Map Functions
      async function loadMap() {
        try {
          const response = await fetch('/api/auto-detect/map-data');
          const data = await response.json();
          
          if (!data.success || data.routers.length === 0) {
            document.getElementById('map-placeholder').innerHTML = \`
              <i class="fas fa-map-marked-alt text-6xl text-gray-300 mb-4"></i>
              <p class="text-gray-500 mb-4">Hakuna routers zenye GPS coordinates</p>
              <p class="text-sm text-gray-400">Weka GPS coordinates wakati wa configuration</p>
            \`;
            return;
          }

          // Initialize map centered on first router or Tanzania
          const firstRouter = data.routers[0];
          const centerLat = firstRouter.latitude || -6.7924;
          const centerLng = firstRouter.longitude || 39.2083;

          // Create map
          map = L.map('map-container').setView([centerLat, centerLng], 12);
          
          // Add tile layer
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
          }).addTo(map);

          // Add markers for each router
          for (const router of data.routers) {
            if (router.latitude && router.longitude) {
              const marker = L.marker([router.latitude, router.longitude]).addTo(map);
              marker.bindPopup(\`
                <strong>\${router.router_name}</strong><br>
                IP: \${router.host}<br>
                Model: \${router.model || 'Unknown'}<br>
                Status: \${router.status}<br>
                Eneo: \${router.location_name || 'N/A'}
              \`);
              markers.push(marker);
            }
          }

          // Fit bounds to show all markers
          if (markers.length > 0) {
            const group = new L.featureGroup(markers);
            map.fitBounds(group.getBounds().pad(0.1));
          }

          // Hide placeholder, show map
          document.getElementById('map-placeholder').style.display = 'none';

        } catch (error) {
          console.error('Error loading map:', error);
        }
      }

      async function executeQuickSetup() {
        const ip = document.getElementById('quick-router-ip').value;
        const serverIP = document.getElementById('quick-server-ip').value;
        const ssid = document.getElementById('quick-ssid').value;
        
        if (!ip || !serverIP) {
          alert('Weka IP ya router na server!');
          return;
        }

        try {
          const response = await fetch('/api/auto-detect/quick-setup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ip,
              serverIP,
              ssid,
              radiusSecret: '\${radiusSecret}',
              user: 'admin',
              password: 'admin',
              latitude: document.getElementById('quick-latitude').value || null,
              longitude: document.getElementById('quick-longitude').value || null,
              locationName: document.getElementById('quick-location-name').value || null
            })
          });
          
          const result = await response.json();
          
          if (result.success) {
            alert('✅ Setup imekamilika! Router: ' + result.router.routerName);
            closeQuickSetup();
            loadDetectedRouters();
            loadMap();
          } else {
            alert('Hitilafu: ' + result.message);
          }
        } catch (error) {
          alert('Hitilafu: ' + error.message);
        }
      }

      function editLocation(routerID) {
        // Open wizard at step 5 (location)
        currentRouterID = routerID;
        currentStep = 5;
        document.getElementById('wizard-modal').classList.remove('hidden');
        document.getElementById('wizard-modal').classList.add('flex');
        updateStepUI();
      }

      function finishSetup() {
        alert('🎉 Setup imekamilika! Unaweza kuanza kutumia HotBando.');
        closeWizard();
        loadDetectedRouters();
        loadMap();
      }

      function viewRouter(routerID) {
        window.location.href = \`/admin/routers?highlight=\${routerID}\`;
      }
    </script>
  `;
%>

<%- include('layout', { body: setupWizardContent }) %>
