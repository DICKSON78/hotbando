<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <h1 class="text-xl font-bold text-gray-900">Badilisha Neno la Siri</h1>
                <p class="text-sm text-gray-500 mt-1">Neno la siri la sasa ni default. Tafadhali badilisha sasa.</p>
            </div>

            <% if (error) { %>
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
                    <%= error %>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
                    <%= success %>
                </div>
                <a href="/admin/dashboard" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-3 px-4 rounded-xl transition block text-center mt-4">
                    Endelea kwenye Dashboard
                </a>
            <% } else { %>
                <form method="POST" action="/admin/change-password" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Neno la Siri la Sasa</label>
                        <input type="password" name="current_password" required
                               class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Neno la Siri Jipya</label>
                        <input type="password" name="new_password" required minlength="8"
                               class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none">
                        <p class="text-xs text-gray-400 mt-1">Herufi angalau 8</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Thibitisha Neno Jipya</label>
                        <input type="password" name="confirm_password" required minlength="8"
                               class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none">
                    </div>
                    <button type="submit"
                            class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-3 px-4 rounded-xl transition">
                        Badilisha Neno la Siri
                    </button>
                </form>
            <% } %>
        </div>
    </div>
</body>
</html>
