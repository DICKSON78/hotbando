<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0">
    <title>HotBando - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            light: '#FF9D5C',
                            DEFAULT: '#FF7A30',
                            dark: '#E43636',
                        },
                        secondary: {
                            DEFAULT: '#121212',
                            dark: '#0A0A0A',
                        },
                        accent: {
                            DEFAULT: '#E5E5E5',
                            light: '#F8F8F8',
                        }
                    },
                    boxShadow: {
                        'card': '0 4px 12px rgba(0, 0, 0, 0.1)',
                        'glass': '0 8px 32px rgba(0, 0, 0, 0.08)',
                    },
                    borderRadius: {
                        'xl': '1rem',
                        '2xl': '1.5rem',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out',
                        'slide-up': 'slideUp 0.3s ease-out',
                        'gradient-shift': 'gradientShift 15s ease infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)' },
                            '100%': { transform: 'translateY(0)' },
                        },
                        gradientShift: {
                            '0%, 100%': { backgroundPosition: '0% 50%' },
                            '50%': { backgroundPosition: '100% 50%' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            touch-action: pan-y;
        }
        .app-container {
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: linear-gradient(135deg, #F8F8F8 0%, #E5E5E5 100%);
        }
        main {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
            padding: 2rem 1rem 80px 1rem;
        }
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        }
        .glass-nav {
            background: linear-gradient(135deg, rgba(255, 122, 48, 0.8), rgba(228, 54, 54, 0.8));
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
            border-top-left-radius: 0.75rem;
            border-top-right-radius: 0.75rem;
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }
        .button-glow {
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            touch-action: manipulation;
            position: relative;
            overflow: hidden;
        }
        .button-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }
        .button-glow:hover::before {
            left: 100%;
        }
        .button-glow:active {
            transform: scale(0.97);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        }
        .notification {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100%);
            padding: 12px 24px;
            border-radius: 12px;
            color: white;
            z-index: 1000;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        }
        .notification.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
        .notification.success { background: linear-gradient(135deg, #10B981, #059669); }
        .notification.error { background: linear-gradient(135deg, #EF4444, #DC2626); }
        .notification.warning { background: linear-gradient(135deg, #F59E0B, #D97706); }
        .card {
            animation: slideUp 0.4s ease-out;
            touch-action: manipulation;
        }
        .card:nth-child(1) { animation-delay: 0.1s; }
        .card:nth-child(2) { animation-delay: 0.2s; }
        .card:nth-child(3) { animation-delay: 0.3s; }
        footer {
            flex-shrink: 0;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 999;
            padding-bottom: env(safe-area-inset-bottom);
        }
        .nav-item {
            transition: all 0.2s ease;
            opacity: 0.75;
        }
        .nav-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }
        .nav-item.active {
            opacity: 1;
            border-bottom: 2px solid white;
        }
        @media (min-width: 768px) {
            .grid-cols-auto { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
            footer { padding: 1rem; }
        }
    </style>
</head>
<body class="font-inter">
    <!-- Notification Container -->
    <div id="notification-container"></div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
        <div class="glass-card p-6 rounded-2xl text-center animate-pulse">
            <i class="fas fa-spinner fa-spin text-3xl text-primary mb-3"></i>
            <p class="text-base font-medium">Inaunganisha kwenye mtandao...</p>
        </div>
    </div>

    <!-- App Container -->
    <div class="app-container">
        <!-- Main Content -->
        <main>
            <!-- Welcome Card (Shadcn Card with Logo, Date, and Border) -->
            <div class="card glass-card rounded-2xl p-4 mb-4 border-2 border-primary">
                <div class="flex justify-between items-center mb-3">
                    <p class="text-xs text-gray-500"><i class="fas fa-calendar-alt mr-2"></i> <%= new Date().toLocaleDateString('sw-TZ', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
                    <img src="/assets/hot-bando-logo.png" alt="HotBando Logo" class="h-10">
                </div>
                <div class="text-center">
                    <div class="flex justify-center items-center space-x-2 mb-2">
                        <h2 class="text-xl font-bold text-orange-500"><%= user.name || 'Mteja' %> !</h2>
                    </div>
                    <p class="text-sm text-gray-600"><i class="fas fa-phone mr-2"></i><%= user.phone_number || '0700000000' %></p>
                    <p class="text-xs text-gray-500 mt-1">Ni siku nyingine tena na HotBando</p>
                </div>
            </div>

            <!-- Balances (Shadcn Card + Progress, 2-column grid) -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-3">
                    <i class="fas fa-sim-card text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Salio Lako</h3>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="glass-card rounded-xl p-3 text-center">
                        <i class="fas fa-wifi text-primary text-xl mb-1"></i>
                        <div class="text-lg font-bold text-primary mb-1"><%= freeMB %> MB</div>
                        <div class="text-xs text-secondary">Data Bure</div>
                        <div class="mt-2 h-2 bg-accent rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-primary to-primary-dark transition-all duration-500" style="width: <%= Math.min((freeMB / 1000) * 100, 100) %>%"></div>
                        </div>
                    </div>
                    <div class="glass-card rounded-xl p-3 text-center <%= isActive ? 'bg-green-50' : 'bg-red-50' %>">
                        <i class="fas <%= isActive ? 'fa-check-circle text-green-500' : 'fa-times-circle text-red-500' %> text-xl mb-1"></i>
                        <div class="text-lg font-bold <%= isActive ? 'text-green-600' : 'text-red-600' %> mb-1"><%= remainingTime %></div>
                        <div class="text-xs text-secondary">Muda wa Kifurushi</div>
                        <button class="mt-2 text-xs text-primary border border-primary px-3 py-1 rounded-full hover:bg-primary hover:text-white transition-colors" aria-label="<%= isActive ? 'Deactivate connection' : 'Activate connection' %>">
                            <%= isActive ? 'Deactivate' : 'Activate' %>
                        </button>
                    </div>
                    <div class="glass-card rounded-xl p-3 text-center">
                        <i class="fas fa-video text-primary text-xl mb-1"></i>
                        <div class="text-lg font-bold text-primary mb-1"><%= adsWatchedToday %>/8</div>
                        <div class="text-xs text-secondary">Matangazo Leo</div>
                        <div class="mt-2 h-2 bg-accent rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-primary to-primary-dark transition-all duration-500" style="width: <%= (adsWatchedToday / 8) * 100 %>%"></div>
                        </div>
                    </div>
                    <div class="glass-card rounded-xl p-3 text-center">
                        <i class="fas fa-box text-primary text-xl mb-1"></i>
                        <div class="text-lg font-bold text-primary mb-1"><%= user.package ? user.package.split(' ')[0] : 'Free' %></div>
                        <div class="text-xs text-secondary">Kifurushi</div>
                    </div>
                </div>
            </div>

            <!-- Status & Package Activation (Shadcn Alert + Button) -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-3">
                    <i class="fas fa-broadcast-tower text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Hali ya Mtandao</h3>
                </div>
                <% if (isActive) { %>
                    <div class="bg-green-50 border-l-4 border-green-500 p-3 rounded-lg mb-3">
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-signal text-green-500"></i>
                            <span class="font-semibold text-green-800">✅ ACTIVE - Umefunguliwa kikamilifu</span>
                        </div>
                        <p class="text-xs text-green-700 mt-1">Inaisha: <%= new Date(user.usage_until).toLocaleString('sw-TZ') %></p>
                        <button class="mt-2 text-xs text-green-600 border border-green-600 px-3 py-1 rounded-full hover:bg-green-600 hover:text-white transition-colors" aria-label="Deactivate connection">
                            Deactivate Profile
                        </button>
                    </div>
                <% } else if (freeMB > 0) { %>
                    <div class="bg-yellow-50 border-l-4 border-yellow-500 p-3 rounded-lg mb-3">
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-clock text-yellow-500"></i>
                            <span class="font-semibold text-yellow-800">🆓 FREE DATA - Tumia data bure</span>
                        </div>
                        <p class="text-xs text-yellow-700 mt-1">Data iliyobaki: <strong><%= freeMB %> MB</strong></p>
                        <p class="text-xs text-yellow-700 mt-1">Matangazo leo: <strong><%= adsWatchedToday %>/8</strong></p>
                    </div>
                <% } else { %>
                    <div class="bg-red-50 border-l-4 border-red-500 p-3 rounded-lg mb-3">
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-exclamation-triangle text-red-500"></i>
                            <span class="font-semibold text-red-800">❌ HAUNA DATA - Tafadhali nunua kifurushi</span>
                        </div>
                        <p class="text-xs text-red-700 mt-1">Huna data iliyobaki. Nunua kifurushi au tazama matangazo kupata data bure.</p>
                    </div>
                <% } %>
                <div class="space-y-2">
                    <button type="button" id="connect-button" class="w-full premium-gradient text-white font-bold py-3 px-4 rounded-xl button-glow" aria-label="Activate connection">
                        <i class="fas fa-play-circle mr-2"></i> Activate Connection
                    </button>
                    <a href="/hotspot/subscription" class="block w-full text-center bg-white text-primary font-bold py-3 px-4 border-2 border-primary rounded-xl button-glow" aria-label="Add new package">
                        <i class="fas fa-plus-circle mr-2"></i> Add Package
                    </a>
                    <% if (canWatchAds) { %>
                        <button type="button" id="watch-ad-button" class="w-full bg-white text-primary font-bold py-3 px-4 border-2 border-primary rounded-xl button-glow" aria-label="Watch ad for free data">
                            <i class="fas fa-video mr-2"></i> Watch Ad for Free Data
                        </button>
                    <% } else { %>
                        <a href="/hotspot/advertise" class="block w-full text-center bg-white text-primary font-bold py-3 px-4 border-2 border-primary rounded-xl button-glow" aria-label="Advertise business">
                            <i class="fas fa-bullhorn mr-2"></i> Advertise Business
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- Simulation Info
            <div class="text-center mt-4 text-xs text-gray-500">
                Simulation Mode | IP: <%= clientIP %> | MAC: <%= mac %>
            </div> -->
        </main>

        <!-- Bottom Navigation -->
        <footer class="flex justify-around p-3 glass-nav">
            <a href="/hotspot/dashboard" class="nav-item text-white font-bold flex items-center flex-col text-center" aria-label="Go to home">
                <i class="fas fa-house text-2xl mb-1 text-white"></i>
                <span class="text-xs">Nyumbani</span>
            </a>
            <a href="/hotspot/subscription" class="nav-item text-white font-bold flex items-center flex-col text-center" aria-label="Go to subscription">
                <i class="fas fa-cart-shopping text-2xl mb-1 text-white"></i>
                <span class="text-xs">Kifurushi</span>
            </a>
            <form action="/hotspot/logout" method="POST" class="nav-item flex items-center flex-col text-center" onsubmit="return confirmLogout(event)">
                <button type="submit" class="text-white font-bold flex items-center flex-col" aria-label="Log out">
                    <i class="fas fa-right-from-bracket text-2xl mb-1 text-white"></i>
                    <span class="text-xs">Toka</span>
                </button>
            </form>
        </footer>
    </div>

    <!-- CSRF Token -->
    <meta name="csrf-token" content="hotbando-csrf-token-2025">

    <script>
        // Notification system
        function showNotification(message, type = 'success') {
            const container = document.getElementById('notification-container');
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.setAttribute('role', 'alert');
            notification.innerHTML = `
                <div class="flex items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-exclamation-triangle'} mr-3"></i>
                    <span>${message}</span>
                </div>
            `;
            container.appendChild(notification);
            setTimeout(() => notification.classList.add('show'), 100);
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => container.removeChild(notification), 300);
            }, 4000);
        }

        // Confirm logout with redirect to login page
        function confirmLogout(event) {
            if (!confirm("Unaondoka kwenye mfumo?")) {
                event.preventDefault();
                return false;
            }
            // Perform logout via fetch to ensure redirect
            event.preventDefault();
            fetch('/hotspot/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/hotspot/login';
                } else {
                    showNotification('Hitilafu wakati wa kutoka. Jaribu tena.', 'error');
                }
            })
            .catch(error => {
                console.error('Logout error:', error);
                showNotification('Hitilafu ya mtandao. Jaribu tena.', 'error');
            });
            return false;
        }

        // Set active navigation item
        document.addEventListener("DOMContentLoaded", function() {
            const navItems = document.querySelectorAll('.nav-item');
            const currentPath = window.location.pathname;

            navItems.forEach(item => {
                const href = item.tagName === 'A' ? item.getAttribute('href') : item.querySelector('button').formAction;
                if (href === currentPath) {
                    item.classList.add('active');
                }
            });

            const connectButton = document.getElementById('connect-button');
            if (connectButton) {
                connectButton.addEventListener('click', async function() {
                    const overlay = document.getElementById('loading-overlay');
                    const btn = this;

                    if (overlay) overlay.classList.remove('hidden');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inaunganishwa...';

                    try {
                        const response = await fetch('/api/connect', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                            }
                        });
                        const result = await response.json();

                        if (overlay) overlay.classList.add('hidden');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-play-circle mr-2"></i> Activate Connection';

                        if (result.success) {
                            showNotification(result.message, 'success');
                            setTimeout(() => window.open('http://www.google.com', '_blank'), 2000);
                        } else {
                            showNotification(result.message, 'error');
                        }
                    } catch (error) {
                        console.error('Connection error:', error);
                        if (overlay) overlay.classList.add('hidden');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-play-circle mr-2"></i> Activate Connection';
                        showNotification('Hitilafu ya mfumo. Tafadhali jaribu tena.', 'error');
                    }
                });
            }

            const watchAdButton = document.getElementById('watch-ad-button');
            if (watchAdButton) {
                watchAdButton.addEventListener('click', async function() {
                    const btn = this;
                    
                    try {
                        const adResponse = await fetch('/api/ads/random');
                        const adResult = await adResponse.json();
                        
                        if (!adResult.success) {
                            showNotification(adResult.message, 'error');
                            return;
                        }

                        const ad = adResult.ad;
                        
                        if (confirm(`Tazama tangazo la "${ad.title}" kwa ${ad.duration} sekunde kupata ${ad.reward_mb}MB ya data bure?`)) {
                            btn.disabled = true;
                            let secondsLeft = ad.duration;
                            btn.innerHTML = `<i class="fas fa-video mr-2"></i> Inatazama... (${secondsLeft}s)`;
                            
                            const countdown = setInterval(() => {
                                secondsLeft--;
                                if (secondsLeft > 0) {
                                    btn.innerHTML = `<i class="fas fa-video mr-2"></i> Inatazama... (${secondsLeft}s)`;
                                } else {
                                    clearInterval(countdown);
                                    btn.innerHTML = '<i class="fas fa-check mr-2"></i> Imekamilika!';
                                }
                            }, 1000);

                            setTimeout(async () => {
                                try {
                                    const completeResponse = await fetch('/api/ads/complete', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                                        },
                                        body: JSON.stringify({ ad_id: ad.id })
                                    });
                                    
                                    const completeResult = await completeResponse.json();
                                    
                                    clearInterval(countdown);
                                    
                                    if (completeResult.success) {
                                        showNotification(`Umepata ${completeResult.addedMB}MB ya data bure! Jumla: ${completeResult.totalMB}MB`, 'success');
                                        setTimeout(() => window.location.reload(), 2000);
                                    } else {
                                        showNotification(completeResult.message, 'error');
                                        btn.disabled = false;
                                        btn.innerHTML = '<i class="fas fa-video mr-2"></i> Watch Ad for Free Data';
                                    }
                                } catch (error) {
                                    console.error('Complete ad error:', error);
                                    showNotification('Hitilafu wakati wa kukamilisha tangazo', 'error');
                                    btn.disabled = false;
                                    btn.innerHTML = '<i class="fas fa-video mr-2"></i> Watch Ad for Free Data';
                                }
                            }, ad.duration * 1000);
                        }
                    } catch (error) {
                        console.error('Watch ad error:', error);
                        showNotification('Hitilafu ya mfumo. Tafadhali jaribu tena.', 'error');
                    }
                });
            }
        });
    </script>
</body>
</html>