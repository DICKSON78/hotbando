<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HotBando - Signup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            light: '#FF9D5C',
                            DEFAULT: '#FF7A30',
                            dark: '#E43636',
                        },
                        secondary: {
                            DEFAULT: '#121212',
                            dark: '#0A0A0A',
                        },
                        accent: {
                            DEFAULT: '#E5E5E5',
                            light: '#F8F8F8',
                        }
                    },
                    boxShadow: {
                        'card': '0 8px 24px rgba(0, 0, 0, 0.15)',
                        'card-hover': '0 12px 32px rgba(0, 0, 0, 0.2)',
                    },
                    borderRadius: {
                        'xl': '1rem',
                        '2xl': '1.5rem',
                    }
                }
            }
        }
    </script>
    <style>
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
        }
        .loading-bar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #FF7A30;
            transform: scaleX(0);
            transform-origin: left;
            animation: loading 2s ease-in-out forwards;
            z-index: 1000;
        }
        @keyframes loading {
            0% { transform: scaleX(0); }
            50% { transform: scaleX(0.8); }
            100% { transform: scaleX(1); opacity: 0; }
        }
        .button-glow {
            position: relative;
            overflow: hidden;
        }
        .button-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: 0.5s;
        }
        .button-glow:hover::before {
            left: 100%;
        }
        .input-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 1rem;
            color: #121212;
        }
    </style>
</head>
<body class="font-inter bg-accent text-secondary min-h-screen flex items-center justify-center p-4">
    <!-- Loading Bar -->
    <div id="loading-bar" class="loading-bar"></div>

    <!-- Main Content -->
    <div class="w-full max-w-md">
        <div class="bg-accent-light rounded-2xl shadow-card overflow-hidden">
            <!-- Header -->
            <div class="bg-accent-light p-6 border-b border-primary/10 text-center">
                <div class="flex justify-center items-center mb-4">
                    <img src="/assets/hot-bando-logo.png" alt="HotBando Logo" class="h-16">
                </div>
                <h1 class="text-2xl font-bold text-secondary">Fungua Akaunti Yako</h1>
            </div>

            <!-- Form Content -->
            <div class="p-6 pt-4">
                <!-- Error Messages -->
                <div id="error-message" class="hidden mb-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700">
                    <!-- Placeholder for error messages -->
                </div>

                <form id="create-account-form" method="POST" action="/hotspot/register" class="space-y-5">
                    <input type="hidden" name="mac" value="">
                    <input type="hidden" name="ip" value="">

                    <div>
                        <label for="name" class="block text-sm font-medium text-secondary mb-1">Majina Mawili</label>
                        <div class="relative">
                            <i class="fas fa-user input-icon"></i>
                            <input type="text" id="name" name="name" value=""
                                class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary"
                                placeholder="Majina mawili" required>
                        </div>
                    </div>

                    <div>
                        <label for="phone_number" class="block text-sm font-medium text-secondary mb-1">Namba ya Simu</label>
                        <div class="relative">
                            <i class="fas fa-mobile-alt input-icon"></i>
                            <input type="tel" id="phone_number" name="phone_number" value=""
                                class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary"
                                placeholder="Namba ya simu" required>
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium text-secondary mb-1">Neno Siri</label>
                        <div class="relative">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password" id="password" name="password"
                                class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary"
                                placeholder="Neno siri" required>
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-secondary hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label for="password_confirm" class="block text-sm font-medium text-secondary mb-1">Thibitisha Neno Siri</label>
                        <div class="relative">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password" id="password_confirm" name="password_confirm"
                                class="pl-10 w-full px-4 py-3 border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition bg-accent-light text-secondary"
                                placeholder="Thibitisha neno siri" required>
                            <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-secondary hover:text-primary password-toggle">
                                <i class="far fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="submit-btn" class="w-full bg-primary hover:bg-primary-dark text-secondary font-medium py-3 px-4 rounded-xl transition duration-200 shadow-md hover:shadow-lg button-glow">
                        <i class="fas fa-user-plus mr-2"></i> Tengeneza Akaunti
                    </button>

                    <div class="text-center pt-4">
                        <a href="/hotspot/login" class="text-primary hover:text-primary-dark font-medium">
                            <i class="fas fa-sign-in-alt mr-1"></i> Nina Akaunti Tayari
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Back to Home Link -->
        <div class="mt-6 text-center">
            <a href="/" class="text-secondary hover:text-primary flex items-center justify-center">
                <i class="fas fa-arrow-left mr-2"></i> Nyumbani
            </a>
        </div>
    </div>

    <script>
        // Trigger loading bar on page load
        document.addEventListener('DOMContentLoaded', function() {
            const loadingBar = document.getElementById('loading-bar');
            loadingBar.style.display = 'block';
            setTimeout(() => {
                loadingBar.style.display = 'none';
            }, 2000); // Matches animation duration
        });

        // Password toggle functionality
        document.querySelectorAll('.password-toggle').forEach(toggle => {
            toggle.addEventListener('click', function() {
                const passwordInput = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');

                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                } else {
                    passwordInput.type = 'password';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            });
        });

        // Form submission with loading bar
        document.getElementById('create-account-form').addEventListener('submit', function() {
            const btn = this.querySelector('button[type="submit"]');
            const loadingBar = document.getElementById('loading-bar');

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inasajiliwa...';
                loadingBar.style.display = 'block';
                loadingBar.style.animation = 'loading 7s ease-in-out forwards';
                setTimeout(() => {
                    loadingBar.style.display = 'none';
                }, 7000);
            }
        });
    </script>
</body>
</html>