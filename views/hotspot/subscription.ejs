<!DOCTYPE html>
<html lang="sw" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HotBando - Nunua Kifurushi</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            margin: 0;
            padding: 0;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .nav-orange {
            background: #FF7A30;
        }
        .dark .nav-orange {
            background: #c2410c;
        }

        /* Bottom Navigation - Mobile Tabs Style */
        .bottom-nav {
            background: white;
            border-top: 1px solid #e5e7eb;
        }
        .dark .bottom-nav {
            background: #1f2937;
            border-top: 1px solid #374151;
        }
        .mobile-tab {
            flex: 1;
            min-width: 0;
            padding: 12px 8px;
            font-size: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            color: #6b7280;
        }
        .dark .mobile-tab {
            color: #9ca3af;
        }
        .mobile-tab.active {
            color: #FF7A30;
        }
        .dark .mobile-tab.active {
            color: #fb923c;
        }
        .mobile-tab i {
            margin-bottom: 4px;
            font-size: 20px;
        }
        .mobile-tab:hover {
            color: #FF7A30;
        }
        .dark .mobile-tab:hover {
            color: #fb923c;
        }

        /* Dashboard Styles */
        .stat-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        /* Package Card Styles */
        .package-card {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        .package-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            border-color: #FF7A30;
        }
        .dark .package-card:hover {
            border-color: #fb923c;
        }

        /* Premium Gradient */
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
        }

        /* Button Glow Effect */
        .button-glow {
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .button-glow:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 122, 48, 0.4);
        }
        .button-glow:active {
            transform: translateY(0);
        }

        /* Modal Styles */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 1rem;
            animation: fadeIn 0.3s ease-out;
        }
        .modal-content {
            background: white;
            border-radius: 1rem;
            padding: 1.5rem;
            width: 100%;
            max-width: 400px;
            animation: slideUp 0.3s ease-out;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }
        .dark .modal-content {
            background: #1f2937;
            color: #e5e7eb;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { 
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }
            to { 
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Notification Styles */
        .notification {
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%) translateY(-100%);
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            color: white;
            z-index: 1000;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            max-width: 90%;
        }
        .notification.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
        .notification.success {
            background: linear-gradient(135deg, #10B981, #059669);
        }
        .notification.error {
            background: linear-gradient(135deg, #EF4444, #DC2626);
        }
        .notification.warning {
            background: linear-gradient(135deg, #F59E0B, #D97706);
        }
        .notification.info {
            background: linear-gradient(135deg, #3B82F6, #1D4ED8);
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-200 transition-colors duration-300">
    <!-- Top Navigation Bar -->
    <nav class="fixed top-0 w-full nav-orange shadow-sm z-50">
        <div class="max-w-7xl mx-auto px-3 sm:px-6">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="w-10 h-10 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center">
                            <i class="fas fa-bolt text-orange-600 dark:text-orange-400 text-lg"></i>
                        </div>
                        <span class="text-white font-bold text-xl">HotBando</span>
                    </div>
                    <div class="sm:hidden w-10 h-10 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center">
                        <i class="fas fa-bolt text-orange-600 dark:text-orange-400 text-lg"></i>
                    </div>
                </div>

                <!-- User Info -->
                <div class="flex items-center space-x-3">
                    <!-- Dark Mode Toggle -->
                    <button id="themeToggle" class="text-white hover:text-yellow-300 transition-colors" title="Toggle Dark Mode">
                        <i class="fas fa-moon text-lg"></i>
                    </button>

                    <!-- Notifications -->
                    <button class="text-white hover:text-yellow-300 transition-colors relative">
                        <i class="fas fa-bell text-lg"></i>
                        <span class="absolute -top-2 -right-2 bg-yellow-500 text-gray-900 dark:text-gray-100 text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold">3</span>
                    </button>

                    <!-- User -->
                    <div class="flex items-center space-x-2 text-white">
                        <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
                            <span class="text-orange-600 font-bold text-sm">
                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                            </span>
                        </div>
                        <span class="hidden sm:block text-sm font-medium"><%= user.name || 'User' %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-2 sm:px-4 pt-20 pb-24">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Nunua Kifurushi</h1>
            <p class="text-gray-600 dark:text-gray-400">Chagua kifurushi chako na kulipa kwa urahisi</p>
        </div>

        <!-- Package Selection -->
        <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
            <div class="flex items-center space-x-2 mb-6">
                <i class="fas fa-box-open text-orange-600 text-lg"></i>
                <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Chagua Kifurushi</h2>
            </div>
            
            <!-- Grid ya kifurushi - 2x2 kwenye mobile -->
            <div class="grid grid-cols-2 gap-4">
                <!-- Package 1: 6 Hours -->
                <div class="package-card bg-white dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 p-4 text-center">
                    <i class="fas fa-clock text-3xl text-orange-600 mb-3"></i>
                    <div class="text-xl font-bold text-orange-600 mb-1">TSH 500</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-4">MASAA 6</div>
                    <button type="button" 
                            class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow package-button"
                            data-package-id="1"
                            data-package-name="MASAA 6"
                            data-package-price="500">
                        <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                    </button>
                </div>

                <!-- Package 2: 24 Hours -->
                <div class="package-card bg-white dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 p-4 text-center">
                    <i class="fas fa-clock text-3xl text-orange-600 mb-3"></i>
                    <div class="text-xl font-bold text-orange-600 mb-1">TSH 1,000</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-4">MASAA 24</div>
                    <button type="button" 
                            class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow package-button"
                            data-package-id="2"
                            data-package-name="MASAA 24"
                            data-package-price="1000">
                        <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                    </button>
                </div>

                <!-- Package 3: 7 Days -->
                <div class="package-card bg-white dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 p-4 text-center">
                    <i class="fas fa-calendar-week text-3xl text-orange-600 mb-3"></i>
                    <div class="text-xl font-bold text-orange-600 mb-1">TSH 6,000</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-4">WIKI 1</div>
                    <button type="button" 
                            class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow package-button"
                            data-package-id="3"
                            data-package-name="WIKI 1"
                            data-package-price="6000">
                        <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                    </button>
                </div>

                <!-- Package 4: 30 Days -->
                <div class="package-card bg-white dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 p-4 text-center">
                    <i class="fas fa-calendar-alt text-3xl text-orange-600 mb-3"></i>
                    <div class="text-xl font-bold text-orange-600 mb-1">TSH 20,000</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-4">MWEEZI 1</div>
                    <button type="button" 
                            class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow package-button"
                            data-package-id="4"
                            data-package-name="MWEEZI 1"
                            data-package-price="20000">
                        <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                    </button>
                </div>
            </div>
        </div>

        <!-- Voucher Section -->
        <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
            <div class="flex items-center space-x-2 mb-4">
                <i class="fas fa-ticket-alt text-orange-600 text-lg"></i>
                <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Tumia Vocha</h2>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Una vocha? Ingiza hapa chini</p>
            <div class="space-y-4">
                <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                        <i class="fas fa-ticket-alt"></i>
                    </span>
                    <input type="text" placeholder="Ingiza namba ya vocha" id="voucher-input"
                        class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-sm">
                </div>
                <button type="button" id="submit-voucher" class="w-full premium-gradient text-white font-bold py-3 px-4 rounded-xl button-glow">
                    <i class="fas fa-check mr-2"></i> Tumia Vocha
                </button>
            </div>
        </div>

        <!-- Payment Instructions -->
        <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
            <div class="flex items-center space-x-2 mb-4">
                <i class="fas fa-credit-card text-orange-600 text-lg"></i>
                <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Maelekezo ya Malipo</h2>
            </div>
            <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-500 mt-1"></i>
                    <span>Bofya "Nunua Sasa" kwenye kifurushi unachotaka</span>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-500 mt-1"></i>
                    <span>PesaPal pop-up itafunguka kwenye simu yako</span>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-500 mt-1"></i>
                    <span>Weka password ya malipo ya simu</span>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-500 mt-1"></i>
                    <span>Internet itafunguliwa automatik baada ya malipo</span>
                </div>
            </div>
        </div>

        <!-- Support Info -->
        <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <div class="flex items-center space-x-2 mb-4">
                <i class="fas fa-headset text-orange-600 text-lg"></i>
                <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Usaidizi</h2>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Kama una tatizo lolote la malipo, wasiliana nasi:</p>
            <div class="space-y-3 text-sm">
                <div class="flex items-center space-x-3">
                    <i class="fas fa-phone text-orange-600"></i>
                    <span>Simu: 0754 000 000</span>
                </div>
                <div class="flex items-center space-x-3">
                    <i class="fas fa-envelope text-orange-600"></i>
                    <span>Barua pepe: support@hotbando.com</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 text-center">
            <i class="fas fa-spinner fa-spin text-3xl text-orange-600 mb-3"></i>
            <p class="text-base font-medium">Inatuma...</p>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmation-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="text-center mb-4">
                <div class="w-16 h-16 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-shopping-cart text-orange-600 dark:text-orange-400 text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2" id="modal-title">Thibitisha Ununuzi</h3>
                <p class="text-gray-600 dark:text-gray-400" id="modal-message">Unakaribia kununua kifurushi cha <span id="package-name" class="font-semibold"></span> kwa <span id="package-price" class="font-semibold"></span></p>
            </div>
            <div class="flex space-x-3">
                <button type="button" id="modal-cancel" class="flex-1 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold py-3 px-4 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 transition-colors">
                    Ghairi
                </button>
                <button type="button" id="modal-confirm" class="flex-1 premium-gradient text-white font-semibold py-3 px-4 rounded-lg button-glow">
                    <i class="fas fa-check mr-2"></i> Thibitisha
                </button>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="success-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-check text-green-600 dark:text-green-400 text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2">Umefanikiwa!</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-4" id="success-message"></p>
                <button type="button" id="success-ok" class="w-full premium-gradient text-white font-semibold py-3 px-4 rounded-lg button-glow">
                    Sawa
                </button>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="error-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="text-center">
                <div class="w-16 h-16 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-exclamation-triangle text-red-600 dark:text-red-400 text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2">Hitilafu Imetokea</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-4" id="error-message"></p>
                <button type="button" id="error-ok" class="w-full bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold py-3 px-4 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 transition-colors">
                    Sawa
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Container -->
    <div id="notification-container"></div>

    <!-- Bottom Navigation - Mobile Tabs Style -->
    <nav class="fixed bottom-0 left-0 right-0 bottom-nav shadow-lg z-40 py-2">
        <div class="max-w-7xl mx-auto px-2">
            <div class="flex justify-around items-center">
                <a href="/hotspot/dashboard" class="mobile-tab">
                    <i class="fas fa-house"></i>
                    <span>Nyumbani</span>
                </a>
                
                <a href="/hotspot/subscription" class="mobile-tab active">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Kifurushi</span>
                </a>
                
                <a href="/hotspot/advertise" class="mobile-tab">
                    <i class="fas fa-video"></i>
                    <span>Ona Tangazo</span>
                </a>
                
                <form action="/hotspot/logout" method="POST" class="mobile-tab">
                    <button type="submit" class="flex flex-col items-center">
                        <i class="fas fa-right-from-bracket"></i>
                        <span>Toka</span>
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <script>
        // === DARK MODE TOGGLE ===
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;

        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
            themeToggle.innerHTML = '<i class="fas fa-sun text-lg"></i>';
        } else {
            themeToggle.innerHTML = '<i class="fas fa-moon text-lg"></i>';
        }

        themeToggle.addEventListener('click', () => {
            html.classList.toggle('dark');
            if (html.classList.contains('dark')) {
                localStorage.setItem('theme', 'dark');
                themeToggle.innerHTML = '<i class="fas fa-sun text-lg"></i>';
            } else {
                localStorage.setItem('theme', 'light');
                themeToggle.innerHTML = '<i class="fas fa-moon text-lg"></i>';
            }
        });

        // === MODAL MANAGEMENT ===
        let currentPackageData = null;

        function showConfirmationModal(packageData) {
            currentPackageData = packageData;
            const modal = document.getElementById('confirmation-modal');
            const packageName = document.getElementById('package-name');
            const packagePrice = document.getElementById('package-price');
            
            packageName.textContent = packageData.name;
            packagePrice.textContent = `TSH ${packageData.price}`;
            
            modal.classList.remove('hidden');
        }

        function hideConfirmationModal() {
            const modal = document.getElementById('confirmation-modal');
            modal.classList.add('hidden');
            currentPackageData = null;
        }

        function showSuccessModal(message) {
            const modal = document.getElementById('success-modal');
            const successMessage = document.getElementById('success-message');
            
            successMessage.textContent = message;
            modal.classList.remove('hidden');
        }

        function hideSuccessModal() {
            const modal = document.getElementById('success-modal');
            modal.classList.add('hidden');
        }

        function showErrorModal(message) {
            const modal = document.getElementById('error-modal');
            const errorMessage = document.getElementById('error-message');
            
            errorMessage.textContent = message;
            modal.classList.remove('hidden');
        }

        function hideErrorModal() {
            const modal = document.getElementById('error-modal');
            modal.classList.add('hidden');
        }

        // === NOTIFICATION SYSTEM ===
        function showNotification(message, type = 'success') {
            const container = document.getElementById('notification-container');
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle'}"></i>
                <span>${message}</span>
            `;
            container.appendChild(notification);
            
            // Show notification
            setTimeout(() => notification.classList.add('show'), 100);
            
            // Auto remove after 4 seconds
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 4000);
        }

        // === PAYMENT FUNCTIONALITY ===
        document.addEventListener("DOMContentLoaded", function() {
            // Package selection buttons
            const packageButtons = document.querySelectorAll('.package-button');
            packageButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const packageId = this.getAttribute('data-package-id');
                    const packageName = this.getAttribute('data-package-name');
                    const price = this.getAttribute('data-package-price');
                    
                    showConfirmationModal({
                        id: packageId,
                        name: packageName,
                        price: price
                    });
                });
            });

            // Modal event listeners
            document.getElementById('modal-cancel').addEventListener('click', hideConfirmationModal);
            document.getElementById('modal-confirm').addEventListener('click', () => {
                if (currentPackageData) {
                    initiatePesaPalPayment(currentPackageData.id, currentPackageData.name, currentPackageData.price);
                    hideConfirmationModal();
                }
            });

            document.getElementById('success-ok').addEventListener('click', hideSuccessModal);
            document.getElementById('error-ok').addEventListener('click', hideErrorModal);

            // Close modals when clicking outside
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.classList.add('hidden');
                    }
                });
            });

            // Voucher submit button
            const voucherSubmitBtn = document.getElementById('submit-voucher');
            if (voucherSubmitBtn) {
                voucherSubmitBtn.addEventListener('click', redeemVoucher);
            }

            // Enter key for voucher input
            const voucherInput = document.getElementById('voucher-input');
            if (voucherInput) {
                voucherInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        redeemVoucher();
                    }
                });
            }

            // Set active navigation item
            const navItems = document.querySelectorAll('.mobile-tab');
            const currentPath = window.location.pathname;

            navItems.forEach(item => {
                const href = item.tagName === 'A' ? item.getAttribute('href') : item.querySelector('button').formAction;
                if (href === currentPath) {
                    item.classList.add('active');
                }
            });
        });

        // PesaPal Payment Handler
        async function initiatePesaPalPayment(packageId, packageName, price) {
            try {
                // Show loading
                const loadingOverlay = document.getElementById('loading-overlay');
                if (loadingOverlay) loadingOverlay.classList.remove('hidden');

                // Initiate payment
                const response = await fetch('/hotspot/payment/direct', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        package_id: packageId
                    })
                });

                const result = await response.json();

                if (loadingOverlay) loadingOverlay.classList.add('hidden');

                if (result.success) {
                    showNotification('Malipo yameanzishwa kikamilifu. Fungua dirisha la PesaPal.', 'info');
                    // Open PesaPal payment page in popup
                    openPesaPalPopup(result.payment_url, result.order_tracking_id);
                } else {
                    showErrorModal(result.message || 'Hitilafu imetokea wakati wa kuanzisha malipo. Tafadhali jaribu tena.');
                }
            } catch (error) {
                console.error('Payment initiation error:', error);
                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                showErrorModal('Hitilafu ya mtandao. Tafadhali jaribu tena.');
            }
        }

        // Open PesaPal payment popup
        function openPesaPalPopup(paymentUrl, orderTrackingId) {
            // Create popup window
            const popupWidth = 400;
            const popupHeight = 600;
            const left = (screen.width - popupWidth) / 2;
            const top = (screen.height - popupHeight) / 2;

            const popup = window.open(
                paymentUrl,
                'PesaPalPayment',
                `width=${popupWidth},height=${popupHeight},top=${top},left=${left},resizable=yes,scrollbars=yes`
            );

            if (!popup) {
                showErrorModal('Kibonyezo cha popup kimezuiwa. Tafadhali ruhusu popup kwa tovuti hii.');
                return;
            }

            showNotification('Inafuatilia hali ya malipo yako...', 'info');

            // Start polling for payment status
            const pollingInterval = setInterval(async () => {
                if (popup.closed) {
                    clearInterval(pollingInterval);
                    checkPaymentStatus(orderTrackingId);
                    return;
                }

                try {
                    const response = await fetch('/hotspot/payment/check-status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                        },
                        body: JSON.stringify({
                            order_tracking_id: orderTrackingId
                        })
                    });

                    const result = await response.json();

                    if (result.success && result.status === 'completed') {
                        clearInterval(pollingInterval);
                        popup.close();
                        showSuccessModal(result.message || 'Malipo yamekamilika kikamilifu! Mtandao wako utafunguliwa papo hapo.');
                        showNotification('Malipo yamekamilika! Mtandao wako upo tayari.', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 3000);
                    }
                } catch (error) {
                    console.error('Payment status check error:', error);
                }
            }, 3000); // Check every 3 seconds

            // Stop polling after 5 minutes
            setTimeout(() => {
                clearInterval(pollingInterval);
                if (!popup.closed) {
                    popup.close();
                }
                showNotification('Muda wa malipo umekwisha. Tafadhali anza upya kama unahitaji.', 'warning');
            }, 300000);
        }

        // Check payment status
        async function checkPaymentStatus(orderTrackingId) {
            try {
                const response = await fetch('/hotspot/payment/check-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        order_tracking_id: orderTrackingId
                    })
                });

                const result = await response.json();

                if (result.success && result.status === 'completed') {
                    showSuccessModal(result.message || 'Malipo yamekamilika kikamilifu!');
                    showNotification('Malipo yamekamilika! Mtandao wako upo tayari.', 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else if (!result.success) {
                    showErrorModal(result.message || 'Malipo hayajaisha. Tafadhali jaribu tena.');
                }
            } catch (error) {
                console.error('Payment status check error:', error);
                showErrorModal('Hitilafu ya kuangalia hali ya malipo. Wasiliana na usaidizi ikiwa imechangiwa.');
            }
        }

        // Voucher redemption
        async function redeemVoucher() {
            const voucherInput = document.getElementById('voucher-input');
            const voucherCode = voucherInput.value.trim();
            const submitBtn = document.getElementById('submit-voucher');

            if (!voucherCode) {
                showNotification('Tafadhali ingiza namba ya vocha', 'error');
                return;
            }

            const loadingOverlay = document.getElementById('loading-overlay');
            if (loadingOverlay) loadingOverlay.classList.remove('hidden');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inatumia...';

            try {
                const response = await fetch('/hotspot/voucher/redeem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        voucher_code: voucherCode
                    })
                });

                const result = await response.json();

                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check mr-2"></i> Tumia Vocha';

                if (result.success === 'success') {
                    showSuccessModal(result.message || 'Vocha imetumiwa kikamilifu! Data yako imeongezwa.');
                    showNotification('Vocha imetumiwa kikamilifu!', 'success');
                    voucherInput.value = '';
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    showErrorModal(result.message || 'Vocha si sahihi au imekwisha tumika.');
                }
            } catch (error) {
                console.error('Voucher redemption error:', error);
                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check mr-2"></i> Tumia Vocha';
                showErrorModal('Hitilafu ya mtandao. Tafadhali jaribu tena.');
            }
        }
    </script>
</body>
