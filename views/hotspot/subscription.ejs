<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0">
    <title>HotBando - Nunua Kifurushi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            light: '#FF9D5C',
                            DEFAULT: '#FF7A30',
                            dark: '#E43636',
                        },
                        secondary: {
                            DEFAULT: '#121212',
                            dark: '#0A0A0A',
                        },
                        accent: {
                            DEFAULT: '#E5E5E5',
                            light: '#F8F8F8',
                        }
                    },
                    boxShadow: {
                        'card': '0 4px 12px rgba(0, 0, 0, 0.1)',
                        'glass': '0 8px 32px rgba(0, 0, 0, 0.08)',
                        'card-hover': '0 8px 24px rgba(0, 0, 0, 0.15)',
                    },
                    borderRadius: {
                        'xl': '1rem',
                        '2xl': '1.5rem',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out',
                        'slide-up': 'slideUp 0.3s ease-out',
                        'gradient-shift': 'gradientShift 15s ease infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)' },
                            '100%': { transform: 'translateY(0)' },
                        },
                        gradientShift: {
                            '0%, 100%': { backgroundPosition: '0% 50%' },
                            '50%': { backgroundPosition: '100% 50%' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            touch-action: pan-y;
        }
        .app-container {
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: linear-gradient(135deg, #F8F8F8 0%, #E5E5E5 100%);
        }
        main {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
            padding: 2rem 1rem 80px 1rem;
        }
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        }
        .glass-nav {
            background: linear-gradient(135deg, rgba(255, 122, 48, 0.8), rgba(228, 54, 54, 0.8));
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
            border-top-left-radius: 0.75rem;
            border-top-right-radius: 0.75rem;
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }
        .button-glow {
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            touch-action: manipulation;
            position: relative;
            overflow: hidden;
        }
        .button-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }
        .button-glow:hover::before {
            left: 100%;
        }
        .button-glow:active {
            transform: scale(0.97);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        }
        .notification {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100%);
            padding: 12px 24px;
            border-radius: 12px;
            color: white;
            z-index: 1000;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        }
        .notification.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
        .notification.success { background: linear-gradient(135deg, #10B981, #059669); }
        .notification.error { background: linear-gradient(135deg, #EF4444, #DC2626); }
        .notification.warning { background: linear-gradient(135deg, #F59E0B, #D97706); }
        .card {
            animation: slideUp 0.4s ease-out;
            touch-action: manipulation;
        }
        .card:nth-child(1) { animation-delay: 0.1s; }
        .card:nth-child(2) { animation-delay: 0.2s; }
        .card:nth-child(3) { animation-delay: 0.3s; }
        .spinner {
            border: 4px solid #F8F8F8;
            border-top: 4px solid #FF7A30;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        footer {
            flex-shrink: 0;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 999;
            padding-bottom: env(safe-area-inset-bottom);
        }
        .package-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }
        .nav-item {
            transition: all 0.2s ease;
            opacity: 0.75;
        }
        .nav-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }
        .nav-item.active {
            opacity: 1;
            border-bottom: 2px solid white;
        }
        @media (min-width: 768px) {
            .package-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 1rem;
            }
            footer { padding: 1rem; }
        }
    </style>
</head>
<body class="font-inter">
    <!-- Notification Container -->
    <div id="notification-container"></div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
        <div class="glass-card p-6 rounded-2xl text-center animate-pulse">
            <div class="spinner mb-3"></div>
            <p class="text-base font-medium">Inatuma...</p>
        </div>
    </div>

    <!-- App Container -->
    <div class="app-container">
        <!-- Main Content -->
        <main>
            <!-- Header -->
            <div class="card glass-card rounded-2xl p-4 mb-4 border-2 border-primary">
                <div class="text-center">
                    <h1 class="text-xl font-bold text-primary mb-2">
                        <i class="fas fa-shopping-cart mr-2"></i>Nunua Kifurushi
                    </h1>
                    <p class="text-sm text-gray-600">Chagua kifurushi chako na kulipa kwa urahisi</p>
                </div>
            </div>

            <!-- Current Status -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-3">
                    <i class="fas fa-info-circle text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Hali Yako ya Sasa</h3>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="text-center p-3 bg-accent rounded-lg">
                        <div class="font-bold text-primary"><%= user.package || 'Hakuna' %></div>
                        <div class="text-xs text-gray-600">Kifurushi</div>
                    </div>
                    <div class="text-center p-3 bg-accent rounded-lg">
                        <div class="font-bold text-primary"><%= freeMB %> MB</div>
                        <div class="text-xs text-gray-600">Data Bure</div>
                    </div>
                </div>
            </div>

            <!-- Package Selection -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-4">
                    <i class="fas fa-box-open text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Chagua Kifurushi</h3>
                </div>
                
                <div class="package-grid">
                    <!-- Package 1: 6 Hours -->
                    <div class="package-card bg-white rounded-xl border-2 border-primary overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
                        <div class="p-4 text-center">
                            <i class="fas fa-clock text-3xl text-primary mb-3"></i>
                            <div class="text-lg font-bold text-primary mb-1">TSH 500</div>
                            <div class="text-sm text-gray-600 mb-3">MASAA 6</div>
                            <button type="button" 
                                    class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow text-sm"
                                    data-package-id="1"
                                    data-package-name="MASAA 6"
                                    data-package-price="500">
                                <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                            </button>
                        </div>
                    </div>

                    <!-- Package 2: 24 Hours -->
                    <div class="package-card bg-white rounded-xl border-2 border-primary overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
                        <div class="p-4 text-center">
                            <i class="fas fa-clock text-3xl text-primary mb-3"></i>
                            <div class="text-lg font-bold text-primary mb-1">TSH 1,000</div>
                            <div class="text-sm text-gray-600 mb-3">MASAA 24</div>
                            <button type="button" 
                                    class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow text-sm"
                                    data-package-id="2"
                                    data-package-name="MASAA 24"
                                    data-package-price="1000">
                                <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                            </button>
                        </div>
                    </div>

                    <!-- Package 3: 7 Days -->
                    <div class="package-card bg-white rounded-xl border-2 border-primary overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
                        <div class="p-4 text-center">
                            <i class="fas fa-calendar-week text-3xl text-primary mb-3"></i>
                            <div class="text-lg font-bold text-primary mb-1">TSH 6,000</div>
                            <div class="text-sm text-gray-600 mb-3">WIKI 1</div>
                            <button type="button" 
                                    class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow text-sm"
                                    data-package-id="3"
                                    data-package-name="WIKI 1"
                                    data-package-price="6000">
                                <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                            </button>
                        </div>
                    </div>

                    <!-- Package 4: 30 Days -->
                    <div class="package-card bg-white rounded-xl border-2 border-primary overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
                        <div class="p-4 text-center">
                            <i class="fas fa-calendar-alt text-3xl text-primary mb-3"></i>
                            <div class="text-lg font-bold text-primary mb-1">TSH 20,000</div>
                            <div class="text-sm text-gray-600 mb-3">MWEEZI 1</div>
                            <button type="button" 
                                    class="w-full premium-gradient text-white font-semibold py-2 px-4 rounded-lg button-glow text-sm"
                                    data-package-id="4"
                                    data-package-name="MWEEZI 1"
                                    data-package-price="20000">
                                <i class="fas fa-bolt mr-1"></i> Nunua Sasa
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Instructions -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-3">
                    <i class="fas fa-credit-card text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Maelekezo ya Malipo</h3>
                </div>
                <div class="space-y-2 text-sm text-gray-600">
                    <div class="flex items-start space-x-2">
                        <i class="fas fa-check-circle text-green-500 mt-1"></i>
                        <span>Bofya "Nunua Sasa" kwenye kifurushi unachotaka</span>
                    </div>
                    <div class="flex items-start space-x-2">
                        <i class="fas fa-check-circle text-green-500 mt-1"></i>
                        <span>PesaPal pop-up itafunguka kwenye simu yako</span>
                    </div>
                    <div class="flex items-start space-x-2">
                        <i class="fas fa-check-circle text-green-500 mt-1"></i>
                        <span>Weka password ya malipo ya simu</span>
                    </div>
                    <div class="flex items-start space-x-2">
                        <i class="fas fa-check-circle text-green-500 mt-1"></i>
                        <span>Internet itafunguliwa automatik baada ya malipo</span>
                    </div>
                </div>
            </div>

            <!-- Voucher Section -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-3">
                    <i class="fas fa-ticket-alt text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Tumia Vocha</h3>
                </div>
                <p class="text-sm text-gray-600 mb-3">Una vocha? Ingiza hapa chini</p>
                <div class="space-y-3">
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                            <i class="fas fa-ticket-alt"></i>
                        </span>
                        <input type="text" placeholder="Ingiza namba ya vocha" id="voucher-input"
                            class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm">
                    </div>
                    <button type="button" id="submit-voucher" class="w-full premium-gradient text-white font-bold py-3 px-4 rounded-xl button-glow">
                        <i class="fas fa-check mr-2"></i> Tumia Vocha
                    </button>
                </div>
            </div>

            <!-- Support Info -->
            <div class="card glass-card rounded-2xl p-4 mb-4">
                <div class="flex items-center space-x-2 mb-2">
                    <i class="fas fa-headset text-primary text-lg"></i>
                    <h3 class="text-lg font-bold text-secondary">Usaidizi</h3>
                </div>
                <p class="text-sm text-gray-600 mb-3">Kama una tatizo lolote la malipo, wasiliana nasi:</p>
                <div class="space-y-2 text-sm">
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-phone text-primary"></i>
                        <span>Simu: 0754 000 000</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-envelope text-primary"></i>
                        <span>Barua pepe: support@hotbando.com</span>
                    </div>
                </div>
            </div>
        </main>

        <!-- Bottom Navigation -->
        <footer class="flex justify-around p-3 glass-nav">
            <a href="/hotspot/dashboard" class="nav-item text-white font-bold flex items-center flex-col text-center" aria-label="Go to home">
                <i class="fas fa-house text-2xl mb-1 text-white"></i>
                <span class="text-xs">Nyumbani</span>
            </a>
            <a href="/hotspot/subscription" class="nav-item active text-white font-bold flex items-center flex-col text-center" aria-label="Go to subscription">
                <i class="fas fa-cart-shopping text-2xl mb-1 text-white"></i>
                <span class="text-xs">Kifurushi</span>
            </a>
            <form action="/hotspot/logout" method="POST" class="nav-item flex items-center flex-col text-center" onsubmit="return confirmLogout(event)">
                <button type="submit" class="text-white font-bold flex items-center flex-col" aria-label="Log out">
                    <i class="fas fa-right-from-bracket text-2xl mb-1 text-white"></i>
                    <span class="text-xs">Toka</span>
                </button>
            </form>
        </footer>
    </div>

    <!-- CSRF Token -->
    <meta name="csrf-token" content="hotbando-csrf-token-2025">

    <script>
        // Notification system
        function showNotification(message, type = 'success') {
            const container = document.getElementById('notification-container');
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.setAttribute('role', 'alert');
            notification.innerHTML = `
                <div class="flex items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-exclamation-triangle'} mr-3"></i>
                    <span>${message}</span>
                </div>
            `;
            container.appendChild(notification);
            setTimeout(() => notification.classList.add('show'), 100);
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => container.removeChild(notification), 300);
            }, 4000);
        }

        // Confirm logout with redirect to login page
        function confirmLogout(event) {
            if (!confirm("Unaondoka kwenye mfumo?")) {
                event.preventDefault();
                return false;
            }
            // Perform logout via fetch to ensure redirect
            event.preventDefault();
            fetch('/hotspot/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/hotspot/login';
                } else {
                    showNotification('Hitilafu wakati wa kutoka. Jaribu tena.', 'error');
                }
            })
            .catch(error => {
                console.error('Logout error:', error);
                showNotification('Hitilafu ya mtandao. Jaribu tena.', 'error');
            });
            return false;
        }

        // PesaPal Payment Handler
        async function initiatePesaPalPayment(packageId, packageName, price) {
            try {
                // Show loading
                const loadingOverlay = document.getElementById('loading-overlay');
                if (loadingOverlay) loadingOverlay.classList.remove('hidden');

                // Initiate payment
                const response = await fetch('/hotspot/payment/direct', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        package_id: packageId
                    })
                });

                const result = await response.json();

                if (loadingOverlay) loadingOverlay.classList.add('hidden');

                if (result.success) {
                    // Open PesaPal payment page in popup
                    openPesaPalPopup(result.payment_url, result.order_tracking_id);
                } else {
                    showNotification(result.message, 'error');
                }
            } catch (error) {
                console.error('Payment initiation error:', error);
                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                showNotification('Hitilafu ya mtandao. Tafadhali jaribu tena.', 'error');
            }
        }

        // Open PesaPal payment popup
        function openPesaPalPopup(paymentUrl, orderTrackingId) {
            // Create popup window
            const popupWidth = 400;
            const popupHeight = 600;
            const left = (screen.width - popupWidth) / 2;
            const top = (screen.height - popupHeight) / 2;

            const popup = window.open(
                paymentUrl,
                'PesaPalPayment',
                `width=${popupWidth},height=${popupHeight},top=${top},left=${left},resizable=yes,scrollbars=yes`
            );

            if (!popup) {
                showNotification('Kibonyezo cha popup kimezuiwa. Tafadhali ruhusu popup kwa tovuti hii.', 'error');
                return;
            }

            // Start polling for payment status
            const pollingInterval = setInterval(async () => {
                if (popup.closed) {
                    clearInterval(pollingInterval);
                    checkPaymentStatus(orderTrackingId);
                    return;
                }

                try {
                    const response = await fetch('/hotspot/payment/check-status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                        },
                        body: JSON.stringify({
                            order_tracking_id: orderTrackingId
                        })
                    });

                    const result = await response.json();

                    if (result.success && result.status === 'completed') {
                        clearInterval(pollingInterval);
                        popup.close();
                        showNotification(result.message, 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 2000);
                    }
                } catch (error) {
                    console.error('Payment status check error:', error);
                }
            }, 3000); // Check every 3 seconds

            // Stop polling after 5 minutes
            setTimeout(() => {
                clearInterval(pollingInterval);
                if (!popup.closed) {
                    popup.close();
                }
            }, 300000);
        }

        // Check payment status
        async function checkPaymentStatus(orderTrackingId) {
            try {
                const response = await fetch('/hotspot/payment/check-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        order_tracking_id: orderTrackingId
                    })
                });

                const result = await response.json();

                if (result.success && result.status === 'completed') {
                    showNotification(result.message, 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else if (!result.success) {
                    showNotification(result.message, 'error');
                }
            } catch (error) {
                console.error('Payment status check error:', error);
                showNotification('Hitilafu ya kuangalia hali ya malipo', 'error');
            }
        }

        // Voucher redemption
        async function redeemVoucher() {
            const voucherInput = document.getElementById('voucher-input');
            const voucherCode = voucherInput.value.trim();
            const submitBtn = document.getElementById('submit-voucher');

            if (!voucherCode) {
                showNotification('Tafadhali ingiza namba ya vocha', 'error');
                return;
            }

            const loadingOverlay = document.getElementById('loading-overlay');
            if (loadingOverlay) loadingOverlay.classList.remove('hidden');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inatumia...';

            try {
                const response = await fetch('/hotspot/voucher/redeem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        voucher_code: voucherCode
                    })
                });

                const result = await response.json();

                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check mr-2"></i> Tumia Vocha';

                if (result.success === 'success') {
                    showNotification(result.message, 'success');
                    voucherInput.value = '';
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showNotification(result.message, 'error');
                }
            } catch (error) {
                console.error('Voucher redemption error:', error);
                if (loadingOverlay) loadingOverlay.classList.add('hidden');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check mr-2"></i> Tumia Vocha';
                showNotification('Hitilafu ya mtandao. Tafadhali jaribu tena.', 'error');
            }
        }

        // Set active navigation item
        document.addEventListener("DOMContentLoaded", function() {
            const navItems = document.querySelectorAll('.nav-item');
            const currentPath = window.location.pathname;

            navItems.forEach(item => {
                const href = item.tagName === 'A' ? item.getAttribute('href') : item.querySelector('button').formAction;
                if (href === currentPath) {
                    item.classList.add('active');
                }
            });

            // Package selection buttons
            const packageButtons = document.querySelectorAll('.package-card button');
            packageButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const packageId = this.getAttribute('data-package-id');
                    const packageName = this.getAttribute('data-package-name');
                    const price = this.getAttribute('data-package-price');
                    
                    if (confirm(`Unataka kununua kifurushi cha ${packageName} kwa TSH ${price}?`)) {
                        initiatePesaPalPayment(packageId, packageName, price);
                    }
                });
            });

            // Voucher submit button
            const voucherSubmitBtn = document.getElementById('submit-voucher');
            if (voucherSubmitBtn) {
                voucherSubmitBtn.addEventListener('click', redeemVoucher);
            }

            // Enter key for voucher input
            const voucherInput = document.getElementById('voucher-input');
            if (voucherInput) {
                voucherInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        redeemVoucher();
                    }
                });
            }
        });
    </script>
</body>
</html>