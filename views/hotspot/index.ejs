    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            light: '#FF9D5C',
                            DEFAULT: '#FF7A30',
                            dark: '#E43636',
                        },
                        secondary: {
                            DEFAULT: '#121212',
                            dark: '#0A0A0A',
                        },
                        accent: {
                            DEFAULT: '#E5E5E5',
                            light: '#F8F8F8',
                        },
                        light: {
                            bg: '#FFFFFF',
                            card: '#F8FAFC',
                            text: '#1F2937',
                            muted: '#6B7280'
