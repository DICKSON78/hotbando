    <style>
        .mobile-menu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .mobile-menu.open {
            max-height: 700px;
        }
        .active-nav-item {
            position: relative;
        }
        .active-nav-item:after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 10%;
            right: 10%;
            height: 3px;
            background-color: #FF7A30;
            border-radius: 2px;
        }
        section {
            scroll-margin-top: 7rem;
            padding: 6rem 0;
        }
        .premium-gradient {
            background: linear-gradient(135deg, #FF7A30 0%, #E43636 100%);
        }
        .card-hover {
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease;
        }
        .card-hover:hover {
            transform: translateY(-12px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
        }
        .card-hover-light:hover {
            transform: translateY(-12px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
        }
        .step-number {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: #FF7A30;
            color: #121212;
