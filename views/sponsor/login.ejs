<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sponsor Login - HotBando</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { inter: ['Inter', 'sans-serif'] } } } }
    </script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: linear-gradient(135deg, #1e293b 0%, #0f172a 50%, #111827 100%); min-height: 100vh; }
        .login-card { background: white; border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,0.35); }
        .brand-badge { width: 64px; height: 64px; border-radius: 18px; background: linear-gradient(135deg, #FF7A30, #FF5500); display: flex; align-items: center; justify-content: center; color: white; font-size: 26px; }
    </style>
</head>
<body>
    <div class="min-h-screen flex items-center justify-center px-4">
        <div class="login-card w-full max-w-md p-8">
            <div class="text-center mb-8">
                <div class="brand-badge mx-auto mb-4"><i class="fas fa-ad"></i></div>
                <h1 class="text-2xl font-800 font-bold text-slate-800">Sponsor Portal</h1>
                <p class="text-sm text-slate-500 mt-1">Ingia kama mfadhili wa kampeni za HotBando</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3 mb-4">
                    <i class="fas fa-exclamation-circle mr-1"></i> <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/sponsor/login">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Barua Pepe</label>
                    <input type="email" name="email" required placeholder="sponsor@hotbando.com"
                           value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                           class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Neno la Siri</label>
                    <input type="password" name="password" required placeholder="••••••••"
                           class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
                <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-lg transition">
                    <i class="fas fa-sign-in-alt mr-2"></i> Ingia
                </button>
            </form>

            <div class="mt-6 text-center">
                <a href="/admin/login" class="text-xs text-slate-400 hover:text-orange-500">← Rudi kwa Admin Login</a>
            </div>
        </div>
    </div>
</body>
</html>
