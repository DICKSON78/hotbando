<%
  const settingsContent = `
    <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-slate-800 mb-1">Mipangilio</h2>
        <p class="text-sm text-slate-500 mb-6">Taarifa za akaunti yako ya mfadhili</p>

        <div class="card p-6 mb-4">
            <h3 class="text-base font-bold text-slate-800 mb-4"><i class="fas fa-user-circle mr-2 text-orange-500"></i>Taarifa za Akaunti</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Jina</label>
                    <input type="text" value="\${typeof sponsor !== 'undefined' && sponsor ? (sponsor.name || sponsor.company_name || '') : ''}" readonly class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Barua Pepe</label>
                    <input type="text" value="\${typeof sponsor !== 'undefined' && sponsor ? (sponsor.email || '') : ''}" readonly class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Jukumu</label>
                    <input type="text" value="\${typeof sponsor !== 'undefined' && sponsor ? (sponsor.role || 'sponsor') : 'sponsor'}" readonly class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600 capitalize">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Salio la Wallet</label>
                    <input type="text" id="setting-balance" value="-" readonly class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600">
                </div>
            </div>
        </div>

        <div class="card p-6">
            <h3 class="text-base font-bold text-slate-800 mb-3"><i class="fas fa-info-circle mr-2 text-orange-500"></i>Maelezo</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
                Kama mfadhili wa HotBando, maudhui yako yanaonyeshwa kwa watumiaji wanaoingia kwenye WiFi
                katika maeneo ya washirika. Kila mtumiaji anapotazama maudhui yako kwa muda uliowekwa,
                wanapata internet ya bure na wewe unapata leads na matokeo (views) kwa kampeni zako.
            </p>
            <div class="mt-4 bg-orange-50 border border-orange-200 rounded-lg p-4 text-sm text-orange-800">
                <i class="fas fa-lightbulb mr-2"></i>
                Maudhui lazima yapate idhini ya msimamizi (admin) kabla ya kuonyeshwa. Kwa usaidizi,
                wasiliana na: <strong>support@hotbando.com</strong>
            </div>
        </div>
    </div>

    <script>
        fetch('/api/wallet/balance').then(r => r.json()).then(data => {
            if (data.success) {
                document.getElementById('setting-balance').value = (data.balance != null ? data.balance : 0).toLocaleString() + ' TZS';
            }
        }).catch(() => {});
    </script>
  `;
%>
<%- include('layout', { title: 'Mipangilio', activePage: 'settings', body: settingsContent, sponsor: typeof sponsor !== 'undefined' ? sponsor : null }) %>
