# =============================================
# HotBando Production Environment
# Copy this to .env on the VPS and fill in values
# =============================================

# DATABASE
DB_HOST=db
DB_USER=hotbando
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=hotbando
DB_PORT=3306
DB_POOL_SIZE=50
DB_SSL=false
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# SERVER
PORT=3000
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_64_CHAR_HEX
APP_URL=http://YOUR_VPS_IP
REQUEST_TIMEOUT=30000
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_SECURE=true

# ENCRYPTION
ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX

# MIKROTIK (set after router is configured)
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=CHANGE_ME
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_TIMEOUT=5

# SECURITY
BCRYPT_ROUNDS=12
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
CSRF_SECRET=CHANGE_ME_64_CHAR_HEX
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ALLOWED_ORIGINS=http://YOUR_VPS_IP,https://YOUR_DOMAIN

# APP
APP_NAME=HotBando WiFi
APP_VERSION=1.0.0
SUPPORT_EMAIL=support@hotbando.co.tz
SUPPORT_PHONE=+255123456789
SEED_PASSWORD=t79xK2mQwL8nZcR1

# VOUCHERS
VOUCHER_LENGTH=10
VOUCHER_PREFIX=HB
DEFAULT_VOUCHER_EXPIRY_DAYS=30

# PACKAGES (hours)
PACKAGE_500_HOURS=6
PACKAGE_1000_HOURS=24
PACKAGE_6000_HOURS=168
PACKAGE_20000_HOURS=720

# ADS
AD_DEFAULT_DURATION=30
AD_DATA_REWARD=10
MAX_ADS_PER_DAY=8
AD_VIEW_EXPIRY_HOURS=24

# SESSION
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=true

# UPLOADS
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4

# RATE LIMITING
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# LOGGING
LOG_LEVEL=info
LOG_FILE=./logs/app.log
ERROR_LOG_FILE=./logs/error.log

# REDIS
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# BACKUP
BACKUP_RETENTION_DAYS=7

# PESAPAL (set when ready)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_URL=http://YOUR_VPS_IP/api/payments/callback
PESAPAL_IPN_URL=http://YOUR_VPS_IP/api/payments/ipn
PESAPAL_IPN_SECRET=

# RADIUS
RADIUS_ENABLED=true
RADIUS_HOST=freeradius

# HOTSPOT
HOTSPOT_IP=10.5.50.1
HOTSPOT_SUBNET=10.5.50.0
HOTSPOT_ADMIN_PASSWORD=CHANGE_ME
RADIUS_SECRET=CHANGE_ME_RADIUS_SECRET

# ROUTER ZERO-TOUCH (required for remote onboarding)
ROUTER_REGISTRATION_SECRET=CHANGE_ME_32_HEX
SERVER_PUBLIC_IP=YOUR_VPS_IP
WG_PORT=51820
WG_NETWORK=10.7.0.0/16
WG_SERVER_IP=10.7.0.1
WG_INTERFACE=wg0
WG_PUBLIC_IFACE=eth0

# CLICKPESA MOBILE MONEY (M-Pesa/Tigo/Airtel USSD push)
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_ENV=sandbox

# DEMO PAYMENTS — NEVER true in production (grants access without money)
DEMO_PAYMENTS=false
